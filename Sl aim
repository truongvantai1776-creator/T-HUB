-- ================= 3. KHAI BÁO CÁC HÀM HỖ TRỢ =================
local function IsAlive(model)
    local humanoid = model:FindFirstChildOfClass("Humanoid")
    local rootPart = model:FindFirstChild("HumanoidRootPart")
    return humanoid and rootPart and humanoid.Health > 0
end

local function IsTeammate(char) 
    local player = Players:GetPlayerFromCharacter(char)
    if player and Settings.HitboxCheckTeam then
        return Player.Team and player.Team == Player.Team 
    end
    return false
end

local function ResetHitboxForPart(part)
    if part and OriginalHitboxSizes[part] then
        part.Size = OriginalHitboxSizes[part]
        part.Transparency = 0
        part.CanCollide = true
        OriginalHitboxSizes[part] = nil
    end
end

local function RemoveHighlight(char)
    if Highlights[char] then
        Highlights[char]:Destroy()
        Highlights[char] = nil
    end
end

local function CheckWall(targetPart, character)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    
    local filterList = {Player.Character}
    if character then table.insert(filterList, character) end
    raycastParams.FilterDescendantsInstances = filterList
    
    local checkPos = targetPart.Position
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if rootPart then checkPos = rootPart.Position end

    local direction = checkPos - Camera.CFrame.Position
    local result = workspace:Raycast(Camera.CFrame.Position, direction, raycastParams)
    
    return result == nil
end


-- ================= 4. XỬ LÝ LOGIC CHÍNH & HIỆU ỨNG RAINBOW =================
local tickTime = 0
RunService.RenderStepped:Connect(function(dt)
    tickTime = tickTime + dt * 1.5
    local rainbowColor = Color3.fromHSV(tickTime % 1, 0.8, 1)
    FOVStroke.Color = rainbowColor
    MainStroke.Color = rainbowColor
    OpenBtnStroke.Color = rainbowColor

    local mousePos = Camera.ViewportSize / 2
    local diameter = Settings.AimLockFOV * 2
    FOVCircle.Size = UDim2.fromOffset(diameter, diameter)
    FOVCircle.Visible = Settings.Enabled

    local targets = {}
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= Player and p.Character then
            table.insert(targets, p.Character)
        end
    end
    
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("Model") and not Players:GetPlayerFromCharacter(obj) then
            if obj:FindFirstChildOfClass("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
                table.insert(targets, obj)
            end
        end
    end

    local activeTracked = {}

    for _, char in ipairs(targets) do
        local targetPart = char:FindFirstChild(Settings.HitboxTargetPart)
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        local isAlive = IsAlive(char)
        local isTeamMatch = IsTeammate(char)

        if humanoid and not DeathConnections[char] then
            DeathConnections[char] = humanoid.Died:Connect(function()
                if targetPart then ResetHitboxForPart(targetPart) end
                RemoveHighlight(char)
                if DeathConnections[char] then
                    DeathConnections[char]:Disconnect()
                    DeathConnections[char] = nil
                end
            end)
        end

        if not Settings.Enabled or not isAlive or isTeamMatch or not targetPart then
            if targetPart then ResetHitboxForPart(targetPart) end
            RemoveHighlight(char)
        else
            activeTracked[char] = true
            local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
            local inFOV = false

            if onScreen then
                local distToCenter = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                if distToCenter <= Settings.AimLockFOV then
                    inFOV = true
                end
            end

            if inFOV then
                local hasNoWall = CheckWall(targetPart, char)

                if Settings.ESPEnabled then
                    if not Highlights[char] then
                        local hl = Instance.new("Highlight")
                        hl.Parent = char
                        hl.Adornee = char
                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        hl.FillTransparency = 0.4
                        hl.OutlineTransparency = 0
                        Highlights[char] = hl
                    end
                    
                    if hasNoWall then
                        Highlights[char].FillColor = Color3.fromRGB(0, 255, 0)
                        Highlights[char].OutlineColor = Color3.fromRGB(0, 255, 0)
                    else
                        Highlights[char].FillColor = Color3.fromRGB(255, 0, 0)
                        Highlights[char].OutlineColor = Color3.fromRGB(255, 0, 0)
                    end
                    Highlights[char].Enabled = true
                else
                    RemoveHighlight(char)
                end

                if hasNoWall then
                    if not OriginalHitboxSizes[targetPart] then
                        OriginalHitboxSizes[targetPart] = targetPart.Size
                    end
                    
                    local distance = (Camera.CFrame.Position - targetPart.Position).Magnitude
                    local fullDiameterPixel = Settings.AimLockFOV * 2
                    local calculatedSize = (fullDiameterPixel * distance) / Camera.ViewportSize.Y * 1.5
                    
                    targetPart.Size = Vector3.new(calculatedSize, calculatedSize, calculatedSize)
                    targetPart.Transparency = 1 
                    targetPart.CanCollide = false
                else
                    ResetHitboxForPart(targetPart)
                end
            else
                ResetHitboxForPart(targetPart)
                RemoveHighlight(char)
            end
        end
    end

    for part, _ in pairs(OriginalHitboxSizes) do
        local found = false
        for _, char in ipairs(targets) do
            if char:FindFirstChild(Settings.HitboxTargetPart) == part and IsAlive(char) then
                found = true
                break
            end
        end
        if not found then ResetHitboxForPart(part) end
    end

    for char, _ in pairs(Highlights) do
        local found = false
        for _, tChar in ipairs(targets) do
            if tChar == char and IsAlive(char) then
                found = true
                break
            end
        end
        if not found then RemoveHighlight(char) end
    end
end)
