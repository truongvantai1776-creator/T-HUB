-- ================= 3. XỬ LÝ HITBOX TÀNG HÌNH & ESP HIGHLIGHT STABLE =================
local function IsTeammate(target) 
    return Player.Team and target.Team == Player.Team 
end

local function ResetHitboxForPart(part)
    if part and OriginalHitboxSizes[part] then
        part.Size = OriginalHitboxSizes[part]
        part.Transparency = 0
        part.CanCollide = true
        OriginalHitboxSizes[part] = nil
    end
end

local function RemoveHighlight(target)
    if ActiveHighlights[target] then
        ActiveHighlights[target]:Destroy()
        ActiveHighlights[target] = nil
    end
end

local function Alive(target)
    return target and target ~= Player and target.Character and target.Character:FindFirstChildOfClass("Humanoid") and target.Character:FindFirstChild("Head") and target.Character:FindFirstChildOfClass("Humanoid").Health > 0
end

local function CheckWall(targetPart)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    
    local filterList = {Player.Character}
    if targetPart.Parent then
        table.insert(filterList, targetPart.Parent)
    end
    raycastParams.FilterDescendantsInstances = filterList
    
    local direction = targetPart.Position - Camera.CFrame.Position
    local result = workspace:Raycast(Camera.CFrame.Position, direction, raycastParams)
    
    return result == nil
end

RunService.RenderStepped:Connect(function()
    local mousePos = Camera.ViewportSize / 2

    local diameter = Settings.AimLockFOV * 2
    FOVCircle.Size = UDim2.fromOffset(diameter, diameter)
    FOVCircle.Visible = Settings.Enabled

    for _, target in ipairs(Players:GetPlayers()) do
        if target ~= Player and target.Character then
            local targetPart = target.Character:FindFirstChild(Settings.HitboxTargetPart)
            local isAlive = Alive(target)
            local isTeamMatch = IsTeammate(target)

            if not Settings.Enabled or not isAlive or (Settings.HitboxCheckTeam and isTeamMatch) then
                if targetPart then ResetHitboxForPart(targetPart) end
                RemoveHighlight(target)
            else
                local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                local inFOV = false

                if onScreen then
                    local distToCenter = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    if distToCenter <= Settings.AimLockFOV then
                        inFOV = true
                    end
                end

                if inFOV then
                    if not OriginalHitboxSizes[targetPart] then
                        OriginalHitboxSizes[targetPart] = targetPart.Size
                    end
                    
                    local distance = (Camera.CFrame.Position - targetPart.Position).Magnitude
                    local fullDiameterPixel = Settings.AimLockFOV * 2
                    local calculatedSize = (fullDiameterPixel * distance) / Camera.ViewportSize.Y * 1.5
                    
                    targetPart.Size = Vector3.new(calculatedSize, calculatedSize, calculatedSize)
                    targetPart.Transparency = 1 
                    targetPart.CanCollide = false
                    
                    local highlight = ActiveHighlights[target]
                    if not highlight then
                        highlight = Instance.new("Highlight")
                        -- Gán thẳng Adornee vào Character nhưng loại trừ ảnh hưởng kích thước vô hình của Head bằng cách thiết lập thông số mặc định ổn định
                        highlight.Adornee = target.Character
                        highlight.Parent = target.Character
                        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        ActiveHighlights[target] = highlight
                    end
                    
                    -- Đảm bảo Adornee luôn hợp lệ
                    if highlight.Adornee ~= target.Character then
                        highlight.Adornee = target.Character
                    end

                    -- Không có vật cản -> Màu Xanh Lá Cây | Có vật cản -> Màu Đỏ
                    if CheckWall(targetPart) then
                        highlight.FillColor = Color3.fromRGB(0, 255, 0)
                        highlight.OutlineColor = Color3.fromRGB(0, 200, 0)
                    else
                        highlight.FillColor = Color3.fromRGB(255, 0, 0)
                        highlight.OutlineColor = Color3.fromRGB(200, 0, 0)
                    end
                else
                    ResetHitboxForPart(targetPart)
                    RemoveHighlight(target)
                end
            end
        end
    end
end)
