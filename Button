-- === LOGIC PROXIMITY PROMPT, ESP & AUTO CLICK ===
local isRangeEnabled = false
local isInstantEnabled = false
local isESPEnabled = false
local isAutoEnabled = false
local originalData = {}
local espStorage = {}

local function updatePrompt(prompt)
    if not prompt:IsA("ProximityPrompt") then return end

    if not originalData[prompt] then
        originalData[prompt] = {
            MaxDistance = prompt.MaxActivationDistance,
            HoldTime = prompt.HoldDuration,
            LineOfSight = prompt.RequiresLineOfSight
        }
    end

    local original = originalData[prompt]

    if isRangeEnabled then
        prompt.MaxActivationDistance = math.huge
        prompt.RequiresLineOfSight = false
    else
        prompt.MaxActivationDistance = original.MaxDistance
        prompt.RequiresLineOfSight = original.LineOfSight
    end

    if isInstantEnabled then
        prompt.HoldDuration = 0
    else
        prompt.HoldDuration = original.HoldTime
    end
end

local function createESP(prompt)
    if espStorage[prompt] then return end
    local parentPart = prompt.Parent
    if not parentPart or not parentPart:IsA("BasePart") then return end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "PromptESP"
    billboard.Size = UDim2.new(0, 120, 0, 35)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = true
    billboard.Adornee = parentPart

    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
    textLabel.BackgroundTransparency = 0.3
    textLabel.Text = "  " .. (prompt.ActionText ~= "" and prompt.ActionText or "Interact") .. "  "
    textLabel.TextColor3 = Color3.fromRGB(0, 255, 200)
    textLabel.TextStrokeTransparency = 0.5
    textLabel.TextSize = 12
    textLabel.Font = Enum.Font.GothamBold
    textLabel.Parent = billboard

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = textLabel

    billboard.Parent = parentPart
    espStorage[prompt] = billboard
end

local function removeESP(prompt)
    if espStorage[prompt] then
        espStorage[prompt]:Destroy()
        espStorage[prompt] = nil
    end
end

local function refreshAllPrompts()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            updatePrompt(obj)
            if isESPEnabled then
                createESP(obj)
            else
                removeESP(obj)
            end
        end
    end
end

