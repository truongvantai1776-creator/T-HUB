local function CreateToggleSwitch(parent, mainTextKey, defaultToggle, subInputs, onToggleOnly)
	local hasSub = subInputs and #subInputs > 0
	local Container = Instance.new("Frame")
	Container.Size = UDim2.new(1, 0, 0, 36)
	Container.BackgroundTransparency = 1
	Container.ClipsDescendants = true
	Container.Parent = parent

	local Header = Instance.new("Frame")
	Header.Size = UDim2.new(1, 0, 0, 36)
	Header.BackgroundTransparency = 1
	Header.Parent = Container

	local TitleLabel = Instance.new("TextLabel")
	TitleLabel.Size = UDim2.new(1, (hasSub and -85 or -50), 1, 0)
	TitleLabel.Position = UDim2.fromOffset(5, 0)
	TitleLabel.BackgroundTransparency = 1
	TitleLabel.Text = L(mainTextKey)
	TitleLabel.TextColor3 = Color3.new(1, 1, 1)
	TitleLabel.TextSize = 13
	TitleLabel.Font = Enum.Font.GothamBold
	TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
	TitleLabel.Parent = Header

	local SwitchBg = Instance.new("TextButton")
	SwitchBg.Size = UDim2.fromOffset(46, 24)
	SwitchBg.AnchorPoint = Vector2.new(1, 0.5)
	SwitchBg.Position = UDim2.new(1, hasSub and -36 or -5, 0.5, 0)
	SwitchBg.BackgroundColor3 = defaultToggle and Theme or Color3.fromRGB(120, 120, 120)
	SwitchBg.Text = ""
	SwitchBg.AutoButtonColor = false
	SwitchBg.BorderSizePixel = 0
	SwitchBg.Parent = Header
	Instance.new("UICorner", SwitchBg).CornerRadius = UDim.new(1, 0)

	local SwitchKnob = Instance.new("Frame")
	SwitchKnob.Size = UDim2.fromOffset(20, 20)
	SwitchKnob.AnchorPoint = Vector2.new(0, 0.5)
	SwitchKnob.Position = defaultToggle and UDim2.new(1, -22, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
	SwitchKnob.BackgroundColor3 = Color3.new(1, 1, 1)
	SwitchKnob.BorderSizePixel = 0
	SwitchKnob.Parent = SwitchBg
	Instance.new("UICorner", SwitchKnob).CornerRadius = UDim.new(1, 0)

	local enabled = defaultToggle or false

	local function UpdateSwitch(smooth)
		local targetColor = enabled and Theme or Color3.fromRGB(120, 120, 120)
		local targetPos = enabled and UDim2.new(1, -22, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
		
		if smooth then
			TweenService:Create(SwitchBg, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {BackgroundColor3 = targetColor}):Play()
			TweenService:Create(SwitchKnob, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {Position = targetPos}):Play()
		else
			SwitchBg.BackgroundColor3 = targetColor
			SwitchKnob.Position = targetPos
		end
	end

	UpdateSwitch(false)
	table.insert(DynamicToggles, { 
		Button = SwitchBg, 
		GetState = function() return enabled end,
		UpdateCustom = function(newTheme)
			if enabled then SwitchBg.BackgroundColor3 = newTheme end
		end
	})

	SwitchBg.MouseButton1Click:Connect(function()
		enabled = not enabled
		UpdateSwitch(true)
		if hasSub and subInputs.onToggle then 
			subInputs.onToggle(enabled) 
		elseif onToggleOnly then 
			onToggleOnly(enabled) 
		end
	end)

	if hasSub then
		local ExpandBtn = Instance.new("TextButton")
		ExpandBtn.Size = UDim2.fromOffset(30, 30)
		ExpandBtn.AnchorPoint = Vector2.new(1, 0.5)
		ExpandBtn.Position = UDim2.new(1, 0, 0.5, 0)
		ExpandBtn.BackgroundColor3 = ButtonOffColor
		ExpandBtn.Text = "+"
		ExpandBtn.TextColor3 = Color3.new(1, 1, 1)
		ExpandBtn.TextSize = 16
		ExpandBtn.Font = Enum.Font.GothamBold
		ExpandBtn.BorderSizePixel = 0
		ExpandBtn.Parent = Header
		Instance.new("UICorner", ExpandBtn).CornerRadius = UDim.new(0, 8)
		ApplySmoothHover(ExpandBtn, ButtonOffColor, Color3.fromRGB(50, 95, 125))

		local SubContainer = Instance.new("Frame")
		SubContainer.Size = UDim2.new(1, 0, 0, #subInputs * 36)
		SubContainer.Position = UDim2.fromOffset(0, 36)
		SubContainer.BackgroundTransparency = 1
		SubContainer.Parent = Container

		local isExpanded = false
		ExpandBtn.MouseButton1Click:Connect(function()
			isExpanded = not isExpanded
			ExpandBtn.Text = isExpanded and "-" or "+"
			local targetHeight = isExpanded and (36 + #subInputs * 36) or 36
			TweenService:Create(Container, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 0, targetHeight)}):Play()
		end)

		for i, sub in ipairs(subInputs) do
			local box = Instance.new("TextBox")
			box.Size = UDim2.new(1, -20, 0, 30)
			box.Position = UDim2.fromOffset(20, (i - 1) * 36)
			box.BackgroundColor3 = Color3.fromRGB(30, 60, 85)
			box.TextColor3 = Color3.new(1, 1, 1)
			box.TextSize = 13
			box.Font = Enum.Font.Gotham
			box.Text = L(sub.textKey) .. ": " .. tostring(sub.default)
			box.ClearTextOnFocus = false
			box.BorderSizePixel = 0
			box.Parent = SubContainer
			Instance.new("UICorner", box).CornerRadius = UDim.new(0, 8)

			box.FocusLost:Connect(function()
				local number = tonumber(box.Text:match("-?%d+%.?%d*"))
				if number then 
					sub.callback(number)
					box.Text = L(sub.textKey) .. ": " .. tostring(number)
				else 
					box.Text = L(sub.textKey) .. ": " .. tostring(sub.default) 
				end
			end)
		end
	end
end

