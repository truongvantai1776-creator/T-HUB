local function CreateSnow(parentFrame, maxWidth, maxHeight)
	task.spawn(function()
		while Gui.Parent and parentFrame.Parent do
			task.wait(math.random(0.2, 0.4))
			if parentFrame.Visible and Settings.SnowEffect then
				pcall(function()
					local Snowflake = Instance.new("Frame")
					local size = math.random(3, 7)
					Snowflake.Size = UDim2.fromOffset(size, size)
					Snowflake.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
					Snowflake.BackgroundTransparency = math.random(20, 50) / 100
					Snowflake.BorderSizePixel = 0
					Snowflake.ZIndex = 25
					
					local startX = math.random(10, maxWidth - 10)
					Snowflake.Position = UDim2.fromOffset(startX, -10)
					Snowflake.Parent = parentFrame

					Instance.new("UICorner", Snowflake).CornerRadius = UDim.new(1, 0)

					local fallDuration = math.random(2.5, 5)
					local endX = startX + math.random(-30, 30)
					local endY = maxHeight + 10

					local tweenInfo = TweenInfo.new(fallDuration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
					local tween = TweenService:Create(Snowflake, tweenInfo, {
						Position = UDim2.fromOffset(endX, endY),
						BackgroundTransparency = 1
					})
					tween:Play()
					tween.Completed:Connect(function() Snowflake:Destroy() end)
				end)
			end
		end
	end)
end

