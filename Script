local function L(key)
	local lang = Settings.Language or "English"
	if Loc[lang] and Loc[lang][key] then
		return Loc[lang][key]
	elseif Loc["English"][key] then
		return Loc["English"][key]
	end
	return key
end

local function SaveColorSettings()
	pcall(function()
		local colorData = {
			Language = Settings.Language,
			ThemeR = Settings.ThemeR, ThemeG = Settings.ThemeG, ThemeB = Settings.ThemeB,
			DarkR = Settings.DarkR, DarkG = Settings.DarkG, DarkB = Settings.DarkB,
			SideR = Settings.SideR, SideG = Settings.SideG, SideB = Settings.SideB,
			MenuBtnR = Settings.MenuBtnR, MenuBtnG = Settings.MenuBtnG, MenuBtnB = Settings.MenuBtnB
		}
		if writefile then writefile(SaveFileName, HttpService:JSONEncode(colorData)) end
	end)
end

local function LoadColorSettings()
	if readfile and isfile and isfile(SaveFileName) then
		pcall(function()
			local result = HttpService:JSONDecode(readfile(SaveFileName))
			if type(result) == "table" then
				for k, v in pairs(result) do if Settings[k] ~= nil then Settings[k] = v end end
			end
		end)
	end
end

