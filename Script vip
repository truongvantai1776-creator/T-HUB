		else
			SwitchBg.BackgroundColor3 = targetColor
			SwitchKnob.Position = targetPos
		end
	end

	UpdateSwitch(false)
	table.insert(DynamicToggles, { 
		Button = SwitchBg, 
		GetState = function() return enabled end,
		UpdateCustom = function(newTheme)
			if enabled then SwitchBg.BackgroundColor3 = newTheme end
		end
	})

	SwitchBg.MouseButton1Click:Connect(function()
		enabled = not enabled
		UpdateSwitch(true)
