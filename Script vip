	SwitchKnob.BorderSizePixel = 0
	SwitchKnob.Parent = SwitchBg
	Instance.new("UICorner", SwitchKnob).CornerRadius = UDim.new(1, 0)

	local enabled = defaultToggle or false

	local function UpdateSwitch(smooth)
		local targetColor = enabled and Theme or Color3.fromRGB(120, 120, 120)
		local targetPos = enabled and UDim2.new(1, -22, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
		
