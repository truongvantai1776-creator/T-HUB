local function ExpandableOption(parent, mainText, defaultToggle, subInputs, onToggleOnly)
	local hasSub = subInputs and #subInputs > 0
	local Container = Instance.new("Frame"); Container.Size = UDim2.new(1, 0, 0, 32); Container.BackgroundTransparency = 1; Container.ClipsDescendants = true; Container.Parent = parent

	local Header = Instance.new("Frame"); Header.Size = UDim2.new(1, 0, 0, 32); Header.BackgroundTransparency = 1; Header.Parent = Container

	local ToggleBtn = Instance.new("TextButton")
	ToggleBtn.Size = UDim2.new(1, hasSub and -36 or 0, 0, 32)
	ToggleBtn.BackgroundColor3 = defaultToggle and Theme or ButtonOffColor
	ToggleBtn.TextColor3 = Color3.new(1, 1, 1); ToggleBtn.TextSize = 13; ToggleBtn.Font = Enum.Font.GothamBold; ToggleBtn.BorderSizePixel = 0
	ToggleBtn.Parent = Header
	Instance.new("UICorner", ToggleBtn).CornerRadius = UDim.new(0, 8)

	local enabled = defaultToggle or false
	local function UpdateToggle()
		ToggleBtn.Text = mainText .. ": " .. (enabled and "BẬT" or "TẮT")
		TweenService:Create(ToggleBtn, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {BackgroundColor3 = enabled and Theme or ButtonOffColor}):Play()
	end
	UpdateToggle()
	table.insert(DynamicToggles, { Button = ToggleBtn, GetState = function() return enabled end })

	ToggleBtn.MouseButton1Click:Connect(function()
		enabled = not enabled
		UpdateToggle()
		if hasSub and subInputs.onToggle then subInputs.onToggle(enabled) elseif onToggleOnly then onToggleOnly(enabled) end
	end)

	if hasSub then
		local ExpandBtn = Instance.new("TextButton")
		ExpandBtn.Size = UDim2.fromOffset(30, 32); ExpandBtn.Position = UDim2.new(1, -30, 0, 0)
		ExpandBtn.BackgroundColor3 = ButtonOffColor; ExpandBtn.Text = "+"; ExpandBtn.TextColor3 = Color3.new(1, 1, 1); ExpandBtn.TextSize = 16
		ExpandBtn.Font = Enum.Font.GothamBold; ExpandBtn.BorderSizePixel = 0; ExpandBtn.Parent = Header
		Instance.new("UICorner", ExpandBtn).CornerRadius = UDim.new(0, 8)
		ApplySmoothHover(ExpandBtn, ButtonOffColor, Color3.fromRGB(50, 95, 125))

		local SubContainer = Instance.new("Frame")
		SubContainer.Size = UDim2.new(1, 0, 0, #subInputs * 36); SubContainer.Position = UDim2.fromOffset(0, 36); SubContainer.BackgroundTransparency = 1; SubContainer.Parent = Container

		local isExpanded = false
		ExpandBtn.MouseButton1Click:Connect(function()
			isExpanded = not isExpanded
			ExpandBtn.Text = isExpanded and "-" or "+"
			local targetHeight = isExpanded and (36 + #subInputs * 36) or 32
			TweenService:Create(Container, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 0, targetHeight)}):Play()
		end)

		for i, sub in ipairs(subInputs) do
			local box = Instance.new("TextBox")
			box.Size = UDim2.new(1, -20, 0, 30); box.Position = UDim2.fromOffset(20, (i - 1) * 36)
			box.BackgroundColor3 = Color3.fromRGB(30, 60, 85); box.TextColor3 = Color3.new(1, 1, 1); box.TextSize = 13; box.Font = Enum.Font.Gotham
			box.Text = sub.text .. ": " .. tostring(sub.default); box.ClearTextOnFocus = false; box.BorderSizePixel = 0; box.Parent = SubContainer
			Instance.new("UICorner", box).CornerRadius = UDim.new(0, 8)

			box.FocusLost:Connect(function()
				local number = tonumber(box.Text:match("-?%d+%.?%d*"))
				if number then sub.callback(number); box.Text = sub.text .. ": " .. tostring(number)
				else box.Text = sub.text .. ": " .. tostring(sub.default) end
			end)
		end
	end
end

