local function GetAimTarget()
	local myChar = Player.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	local cam = workspace.CurrentCamera
	if not myRoot then return nil end
	
	local bestTarget, shortestMetric = nil, math.huge
	local mousePos = cam.ViewportSize / 2
	
	for _, target in ipairs(Players:GetPlayers()) do
		if target ~= Player and target.Character then
			local humanoid = target.Character:FindFirstChildOfClass("Humanoid")
			local partToAim = target.Character:FindFirstChild(Settings.AimLockTargetPart) or target.Character:FindFirstChild("Head") or target.Character:FindFirstChild("HumanoidRootPart")
			local isTeamMatch = (Player.Team and target.Team == Player.Team)
			
			if humanoid and humanoid.Health > 0 and partToAim then
				if not (Settings.AimLockCheckTeam and isTeamMatch) then
					if Settings.ShowFOV then
						local screenPos, onScreen = cam:WorldToViewportPoint(partToAim.Position)
						if onScreen then
							local distToMouse = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
							if distToMouse <= Settings.AimLockFOV and distToMouse < shortestMetric then
								shortestMetric = distToMouse
								bestTarget = partToAim
							end
						end
					else
						local distToMe = (myRoot.Position - partToAim.Position).Magnitude
						if distToMe < shortestMetric then
							shortestMetric = distToMe
							bestTarget = partToAim
						end
					end
				end
			end
		end
	end
	return bestTarget
end

