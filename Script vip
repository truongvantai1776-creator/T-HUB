local function Character()
	local char = Player.Character if not char then return nil, nil, nil end
	return char, char:FindFirstChildOfClass("Humanoid"), char:FindFirstChild("HumanoidRootPart")
end

local function Alive(target)
	return target and target ~= Player and target.Character and target.Character:FindFirstChildOfClass("Humanoid") and target.Character:FindFirstChild("HumanoidRootPart") and target.Character:FindFirstChildOfClass("Humanoid").Health > 0
end

local function IsTeammate(target) return Player.Team and target.Team == Player.Team end

RunService.Heartbeat:Connect(function()
	local _, humanoid = Character() if not humanoid then return end
	if Settings.Speed then humanoid.WalkSpeed = Settings.Speed and Settings.WalkSpeed or 16 end
	if Settings.Jump then humanoid.UseJumpPower = true; humanoid.JumpPower = Settings.JumpPower end
end)

RunService.Stepped:Connect(function()
	if not Settings.NoClip then return end
	local char = Player.Character if not char then return end
	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") then
			if OriginalCollision[part] == nil then OriginalCollision[part] = part.CanCollide end
			part.CanCollide = false
		end
	end
end)

RunService.RenderStepped:Connect(function()
	if not Settings.Hitbox then return end
	for _, target in ipairs(Players:GetPlayers()) do
		if target ~= Player then
			local isAlive = Alive(target)
			local targetPart = target.Character and target.Character:FindFirstChild(Settings.HitboxTargetPart)
			if targetPart then
				if (Settings.HitboxCheckTeam and IsTeammate(target)) or not isAlive then 
					ResetHitbox(target)
				elseif isAlive then
					if not OriginalHitboxSizes[targetPart] then OriginalHitboxSizes[targetPart] = targetPart.Size end
					targetPart.Size = Vector3.new(Settings.HitboxSize, Settings.HitboxSize, Settings.HitboxSize)
					targetPart.Transparency = Settings.HitboxTrans
					targetPart.CanCollide = false
				end
			end
		end
	end
end)

local function ClosestPlayer()
	local _, _, root = Character() if not root then return nil end
	local closest, distance = nil, math.huge
	for _, target in ipairs(Players:GetPlayers()) do
		if Alive(target) then
			if not (Settings.FollowCheckTeam and IsTeammate(target)) then
				local d = (root.Position - target.Character.HumanoidRootPart.Position).Magnitude
				if d < distance then distance = d; closest = target end
			end
		end
	end
	return closest
end

RunService.Heartbeat:Connect(function()
	if not Settings.Follow then CurrentTarget = nil return end
	if not Alive(CurrentTarget) then CurrentTarget = ClosestPlayer() end
	if not Alive(CurrentTarget) then return end
	local _, _, myRoot = Character() local targetRoot = CurrentTarget.Character.HumanoidRootPart
	if myRoot and targetRoot then
		myRoot.CFrame = CFrame.lookAt((targetRoot.CFrame * CFrame.new(0, Settings.FollowHeight, Settings.FollowDistance)).Position, targetRoot.Position)
	end
end)

RunService.Heartbeat:Connect(function()
	if not Settings.Teleport or not Alive(Settings.Target) then return end
	local _, _, myRoot = Character() local targetRoot = Settings.Target.Character.HumanoidRootPart
	if myRoot and targetRoot then
		myRoot.CFrame = CFrame.lookAt((targetRoot.CFrame * CFrame.new(0, Settings.TeleportHeight, Settings.TeleportDistance)).Position, targetRoot.Position)
	end
end)

local function UpdateESP(target)
	if not Alive(target) then return end
	local model = target.Character
	if Settings.ESPCheckTeam and IsTeammate(target) then RemoveESP(target) return end

	local highlight = model:FindFirstChild("THubESP")
	if Settings.ESP then
		if not highlight then
			highlight = Instance.new("Highlight"); highlight.Name = "THubESP"; highlight.Adornee = model; highlight.FillTransparency = 0.65; highlight.OutlineTransparency = 0; highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop; highlight.Parent = model
		end
	elseif highlight then highlight:Destroy() end

	local root = model:FindFirstChild("HumanoidRootPart") if not root then return end
	local tag = root:FindFirstChild("THubName")
	if Settings.ShowNames then
		local teamName = target.Team and target.Team.Name or "No Team"
		local displayText = string.format("%s (%s)", target.DisplayName, teamName)
		if not tag then
			tag = Instance.new("BillboardGui"); tag.Name = "THubName"; tag.Adornee = root; tag.Size = UDim2.fromOffset(250, 40); tag.StudsOffset = Vector3.new(0, 3.5, 0); tag.AlwaysOnTop = true; tag.Parent = root
			local label = Instance.new("TextLabel"); label.Name = "Label"; label.Size = UDim2.fromScale(1, 1); label.BackgroundTransparency = 1; label.TextColor3 = Color3.fromRGB(255, 50, 50); label.TextStrokeTransparency = 0; label.TextSize = 18; label.Font = Enum.Font.GothamBold; label.Parent = tag
			label.Text = displayText
		else
			local label = tag:FindFirstChild("Label") if label then label.Text = displayText end
		end
	elseif tag then tag:Destroy() end
end

task.spawn(function()
	while Gui.Parent do
		for _, target in ipairs(Players:GetPlayers()) do if target ~= Player then UpdateESP(target) end end
		task.wait(0.5)
	end
end)

