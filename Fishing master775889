local function startAutoMaster()
    if isRunning then return end
    isRunning = true
    handleReelGuiEffect(true)
    
    if savedAutoCFrame and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        LocalPlayer.Character.HumanoidRootPart.CFrame = savedAutoCFrame
    end
    
    enableCameraLock()
    
    task.spawn(function()
        local noRodStartTime = nil
        while isRunning do
            if not hasEquippedRod() then
                if not noRodStartTime then noRodStartTime = tick(); WindUI:Notify({ Title = "Cảnh báo", Content = "⚠️ Hãy cầm cần câu!", Duration = 3 }) end
                local elapsed = tick() - noRodStartTime
                setCenterWarningVisible(true, string.format("⚠️ HÃY CẦM CẦN CÂU!\n(Tự cầm sau: %ds)", math.max(0, math.ceil(60 - elapsed))))
                if elapsed >= 60 then equipRodFromBackpack(); noRodStartTime = nil; setCenterWarningVisible(false) end
                task.wait(0.2); continue
            else
                if noRodStartTime then noRodStartTime = nil; setCenterWarningVisible(false) end
            end
            
            if not isRunning then break end
            
            pcall(function()
                local x, y = getScreenCenterPosition()
                showClickDot(x, y)
                VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
                local startTime = tick()
                while tick() - startTime < 0.2 and isRunning and hasEquippedRod() do spamSkillKeys(); task.wait(0.05) end
                VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
                
                for i = 1, 10 do
                    if not isRunning or not hasEquippedRod() then break end
                    local rx, ry = getScreenCenterPosition()
                    showClickDot(rx, ry)
                    VirtualInputManager:SendMouseButtonEvent(rx, ry, 0, true, game, 0)
                    spamSkillKeys()
                    VirtualInputManager:SendMouseButtonEvent(rx, ry, 0, false, game, 0)
                    task.wait(0.03) 
                end
            end)
            task.wait(0.05)
        end
        setCenterWarningVisible(false)
    end)
end

local function stopAutoMaster()
    isRunning = false; setCenterWarningVisible(false); handleReelGuiEffect(false); disableCameraLock()
end

