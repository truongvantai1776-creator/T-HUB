            end
        end)
    end
end

local function restoreReelButtons()
    pcall(function()
        for button, state in pairs(originalButtonStates) do
            if button and button.Parent then
                button.AnchorPoint = state.AnchorPoint; button.Position = state.Position; button.Size = state.Size; button.BackgroundTransparency = state.BackgroundTransparency
                if button:IsA("TextButton") and state.TextTransparency then button.TextTransparency = state.TextTransparency
                elseif button:IsA("ImageButton") and state.ImageTransparency then button.ImageTransparency = state.ImageTransparency end
            end
        end
