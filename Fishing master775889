-- ================= HÀM XỬ LÝ AUTO LOCK =================
local function normalizeRarity(text)
	if not text then return nil end
	local t = string.lower(text)
	if string.find(t, "divine") then return "Divine"
	elseif string.find(t, "epic") then return "Epic"
	elseif string.find(t, "legendary") or string.find(t, "huyền thoại") then return "Legendary"
	elseif string.find(t, "mythical") then return "Mythical"
	elseif string.find(t, "rare") or string.find(t, "hiếm") then return "Rare"
	else return nil end
end

local function findPreciseLockButton()
	local btn = nil
	pcall(function()
		local modal = PlayerGui:FindFirstChild("SatchelModal")
		if modal then
			for _, desc in ipairs(modal:GetDescendants()) do
				if desc.Name == "Button" and desc.Parent and string.lower(desc.Parent.Name) == "lock" then
					btn = desc
					break
				end
			end
		end
	end)
	return btn
end

local function parseLockFromSlot(slotObj)
	local isLocked = false
	pcall(function()
		if slotObj then
			local lockedObj = slotObj:FindFirstChild("Locked", true)
			if lockedObj and lockedObj:IsA("GuiObject") then
