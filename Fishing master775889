-- Logic Auto Lock
local function normalizeRarity(text)
	if not text then return nil end
	local t = string.lower(text)
	if string.find(t, "divine") then return "Divine"
	elseif string.find(t, "epic") then return "Epic"
	elseif string.find(t, "legendary") or string.find(t, "huyền thoại") then return "Legendary"
	elseif string.find(t, "mythical") then return "Mythical"
	elseif string.find(t, "rare") or string.find(t, "hiếm") then return "Rare"
	else return nil end
end

local function findPreciseLockButton()
	local btn = nil
	pcall(function()
		local modal = PlayerGui:FindFirstChild("SatchelModal")
		if modal then
			for _, desc in ipairs(modal:GetDescendants()) do
				if desc.Name == "Button" and desc.Parent and string.lower(desc.Parent.Name) == "lock" then
					btn = desc
					break
				end
			end
		end
	end)
	return btn
end

local function parseLockFromSlot(slotObj)
	local isLocked = false
	pcall(function()
		if slotObj then
			local lockedObj = slotObj:FindFirstChild("Locked", true)
			if lockedObj and lockedObj:IsA("GuiObject") then
				if lockedObj.Visible and lockedObj.AbsoluteSize.X > 0 and lockedObj.AbsoluteSize.Y > 0 then
					isLocked = true
				end
			end
		end
	end)
	return isLocked
end

local function isFishTool(toolName)
	local lower = string.lower(toolName)
	local blacklist = {"rod", "cần", "bait", "mồi", "net", "lưới", "boat", "thuyền", "sword", "kiếm", "gun", "súng"}
	for _, badWord in ipairs(blacklist) do
		if string.find(lower, badWord) then return false end
	end
	return true
end

local function getCornerSafeClickPosition()
	local cam = workspace.CurrentCamera
	if not cam then return 50, 50 end
	local viewportSize = cam.ViewportSize
	return viewportSize.X - 50, 50
end

local function clickAtPosition(x, y)
	pcall(function()
		showClickDot(x, y)
		VirtualInputManager:SendMouseMoveEvent(x, y, game)
		VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
		VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
	end)
end

local function clickButton(btn)
	if not btn then return end
	pcall(function()
		local absPos = btn.AbsolutePosition
		local absSize = btn.AbsoluteSize
		local cx = absPos.X + absSize.X / 2
		local cy = absPos.Y + absSize.Y / 2
		clickAtPosition(cx, cy)
		for _, conn in pairs(getconnections(btn.Activated)) do conn:Fire() end
		for _, conn in pairs(getconnections(btn.MouseButton1Click)) do conn:Fire() end
		if firesignal then
			pcall(function() firesignal(btn.Activated) end)
			pcall(function() firesignal(btn.MouseButton1Click) end)
		end
	end)
end

local function pressKey(keyCode)
	pcall(function()
		VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
		VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
	end)
end

local function equipTool(toolObj)
	if not toolObj or not toolObj.Parent then return end
	pcall(function()
		local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
		if humanoid then humanoid:EquipTool(toolObj) end
	end)
end

local function getFinalFishList()
	pcall(function()
		local modal = PlayerGui:FindFirstChild("SatchelModal")
		if modal then
			for _, desc in ipairs(modal:GetDescendants()) do
				if not desc:IsDescendantOf(ScreenGui) and desc:IsA("GuiObject") and desc.Visible then
					local slotName = desc.Name
					local foundRarity = nil
					for _, sub in ipairs(desc:GetDescendants()) do
						if sub:IsA("TextLabel") or sub:IsA("TextButton") then
							local txt = sub.Text
							if txt and txt ~= "" then
								local norm = normalizeRarity(txt)
								if norm then foundRarity = norm end
							end
						end
					end
					
					local isLocked = parseLockFromSlot(desc)
					if foundRarity or desc:FindFirstChild("ImageLabel", true) then
						if not persistentFishCache[slotName] then persistentFishCache[slotName] = {} end
						if foundRarity then persistentFishCache[slotName].Rarity = foundRarity end
						persistentFishCache[slotName].Locked = isLocked
						persistentFishCache[slotName].SlotObj = desc
					end
				end
			end
		end
	end)
	
	local foundFishes = {}
	for _, tool in ipairs(Backpack:GetChildren()) do
		if tool:IsA("Tool") and isFishTool(tool.Name) then
			local fishName = tool.Name
			local data = persistentFishCache[fishName] or persistentFishCache[tool.ClassName]
			table.insert(foundFishes, {
				Name = fishName,
				Rarity = data and data.Rarity or nil,
				ToolObj = tool,
				Locked = data and data.Locked or false,
				SlotObj = data and data.SlotObj
			})
		end
	end
	return foundFishes
end

task.spawn(function()
	while true do
		pcall(function()
			if AutoLockRunning then
				isLockingActiveNow = true
				local modal = PlayerGui:FindFirstChild("SatchelModal")
				if not modal or not modal.Enabled then
					isLockingActiveNow = false
					task.wait(0.05)
					return
				end
				
				local lockButton = findPreciseLockButton()
				if not lockButton then
					isLockingActiveNow = false
					task.wait(0.05)
					return
				end
				
				local fishes = getFinalFishList()
				local hasUnlockedFish = false
				for _, fish in ipairs(fishes) do
					if fish.Rarity and SelectedRarities[fish.Rarity] == true and not fish.Locked then
						hasUnlockedFish = true
						break
					end
				end
				
				if not hasUnlockedFish then
					isLockingActiveNow = false
					task.wait(0.05)
					return
				end
				
				pressKey(Enum.KeyCode.Two)
				
				fishes = getFinalFishList()
				for _, fish in ipairs(fishes) do
					if AutoLockRunning and fish.Rarity and SelectedRarities[fish.Rarity] == true and not fish.Locked and fish.ToolObj then
						local sx, sy = getCornerSafeClickPosition()
						clickAtPosition(sx, sy)
						equipTool(fish.ToolObj)
						
						local originalSize = lockButton.Size
						lockButton.Size = UDim2.new(0, 10000000, 0, 10000000)
						clickButton(lockButton)
						lockButton.Size = originalSize
					end
				end
				
				pressKey(Enum.KeyCode.Two)
				pressKey(Enum.KeyCode.One)
				
				-- ⏳ Đợi 3 giây sau khi lock xong rồi tự động trang bị lại vật phẩm chứa chữ rod trong backpack
				task.wait(3.0)
				equipRodFromBackpack()

				isLockingActiveNow = false
			else
				isLockingActiveNow = false
			end
