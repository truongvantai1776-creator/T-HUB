local function getRandomScreenCenterPosition()
    local vpSize = workspace.CurrentCamera.ViewportSize
    local inset = GuiService:GetGuiInset()
    local randomX = (vpSize.X / 2) + 50 + math.random(-boxWidthSize, boxWidthSize)
    local randomY = (vpSize.Y / 2) - 50 + math.random(-boxHeightSize, boxHeightSize) + inset.Y
    return randomX, randomY
end

local function spamSkillKeys()
    local keys = {Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V}
    for _, key in ipairs(keys) do
        VirtualInputManager:SendKeyEvent(true, key, false, game)
        VirtualInputManager:SendKeyEvent(false, key, false, game)
    end
end

local isRunning = false
local cameraLockConnection = nil

local function enableCameraLock()
    if cameraLockConnection then cameraLockConnection:Disconnect() end
    cameraLockConnection = RunService.RenderStepped:Connect(function()
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local rootPart = char.HumanoidRootPart
            local camPos = rootPart.Position - (rootPart.CFrame.LookVector * 6) + Vector3.new(0, 3, 0)
            Camera.CFrame = CFrame.new(camPos, rootPart.Position + Vector3.new(0, 1, 0))
        end
    end)
end

local function disableCameraLock()
    if cameraLockConnection then
        cameraLockConnection:Disconnect()
        cameraLockConnection = nil
    end
    Camera.CameraType = Enum.CameraType.Custom
end

local function startAutoMaster()
    if isRunning then return end
    isRunning = true
    ToggleMasterBtn.Text = "🛑 TẮT AUTO"
    ToggleMasterBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
    StatusLabel.Text = "🔥 Đang chạy Auto..."
    
    enableCameraLock()
    
    task.spawn(function()
        while isRunning do
            pcall(function()
                if not isRunning then return end
                local x, y = getRandomScreenCenterPosition()
                VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
                local startTime = tick()
                while tick() - startTime < 0.2 and isRunning do 
                    spamSkillKeys()
                    task.wait(0.01)
                end
                VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
            end)
            
            if not isRunning then break end
            
            pcall(function()
                for i = 1, 15 do
                    if not isRunning then break end
                    local x, y = getRandomScreenCenterPosition()
                    VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
                    spamSkillKeys()
                    VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
                    task.wait(0.01) 
                end
            end)
            task.wait(0.01) 
        end
    end)
end

local function stopAutoMaster()
    if not isRunning then return end
    isRunning = false
    ToggleMasterBtn.Text = "auto câu + skill"
    ToggleMasterBtn.BackgroundColor3 = Color3.fromRGB(40, 200, 90)
    StatusLabel.Text = "⚡ Trạng thái: Đang tắt"
    disableCameraLock()
    local lp = Players.LocalPlayer
    if lp.Character and lp.Character:FindFirstChild("Humanoid") then
        lp.Character.Humanoid.WalkSpeed = isSpeedBuffEnabled and 40 or 16
        lp.Character.Humanoid.JumpPower = 50
    end
end

ToggleMasterBtn.MouseButton1Click:Connect(function()
    if isRunning then
        stopAutoMaster()
    else
        startAutoMaster()
    end
end)

-- ================= HÀM BAY =================
local function flySmoothlyTo(targetCFrame)
    local lp = Players.LocalPlayer
    local char = lp.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") then return false end
    
    local hrp = char.HumanoidRootPart
    local humanoid = char.Humanoid
    
    humanoid.PlatformStand = true
    local speed = 15
    local runServiceConnection
    local noclipConnection
    
    noclipConnection = RunService.Stepped:Connect(function()
        if char then
            humanoid.PlatformStand = true 
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end)
    
    local finalTargetPos = targetCFrame.Position
    local highTargetPos = Vector3.new(finalTargetPos.X, math.max(hrp.Position.Y, finalTargetPos.Y) + 75, finalTargetPos.Z)
    
    local startTime = tick()
    local timeout = 25 
    
    runServiceConnection = RunService.RenderStepped:Connect(function(dt)
        if not char or not char:FindFirstChild("HumanoidRootPart") then
            if runServiceConnection then runServiceConnection:Disconnect() end
            if noclipConnection then noclipConnection:Disconnect() end
            return
        end
        
        local currentPos = hrp.Position
        local direction = (highTargetPos - currentPos)
        local distance = direction.Magnitude
        
        if distance < 3 or (tick() - startTime) > timeout then
            if runServiceConnection then runServiceConnection:Disconnect() end
        else
            local moveDir = direction.Unit
            hrp.AssemblyLinearVelocity = moveDir * speed
            hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            
            local step = math.min(speed * dt, distance)
            hrp.CFrame = CFrame.new(currentPos + (moveDir * step), highTargetPos)
        end
    end)
    
    while runServiceConnection and runServiceConnection.Connected do
        task.wait(0.05)
    end
    
    local highDestinationPos = Vector3.new(finalTargetPos.X, highTargetPos.Y, finalTargetPos.Z)
    startTime = tick()
    
    runServiceConnection = RunService.RenderStepped:Connect(function(dt)
        if not char or not char:FindFirstChild("HumanoidRootPart") then
            if runServiceConnection then runServiceConnection:Disconnect() end
            if noclipConnection then noclipConnection:Disconnect() end
            return
        end
        
        local currentPos = hrp.Position
        local direction = (highDestinationPos - currentPos)
        local distance = direction.Magnitude
        
        if distance < 3 or (tick() - startTime) > timeout then
            if runServiceConnection then runServiceConnection:Disconnect() end
        else
            local moveDir = direction.Unit
            hrp.AssemblyLinearVelocity = moveDir * speed
            hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            
            local step = math.min(speed * dt, distance)
            hrp.CFrame = CFrame.new(currentPos + (moveDir * step), highDestinationPos)
        end
    end)
    
    while runServiceConnection and runServiceConnection.Connected do
        task.wait(0.05)
    end
    
    startTime = tick()
    
    runServiceConnection = RunService.RenderStepped:Connect(function(dt)
        if not char or not char:FindFirstChild("HumanoidRootPart") then
            if runServiceConnection then runServiceConnection:Disconnect() end
            if noclipConnection then noclipConnection:Disconnect() end
            return
        end
        
        local currentPos = hrp.Position
        local direction = (finalTargetPos - currentPos)
        local distance = direction.Magnitude
        
        if distance < 3 or (tick() - startTime) > timeout then
            if runServiceConnection then runServiceConnection:Disconnect() end
        else
            local moveDir = direction.Unit
            hrp.AssemblyLinearVelocity = moveDir * speed
            hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            
            local step = math.min(speed * dt, distance)
            hrp.CFrame = CFrame.new(currentPos + (moveDir * step), finalTargetPos)
        end
    end)
    
    while runServiceConnection and runServiceConnection.Connected do
        task.wait(0.05)
    end
    
    if noclipConnection then noclipConnection:Disconnect() end
    
    if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
        for i = 1, 5 do
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            hrp.CFrame = targetCFrame
            task.wait(0.02)
        end
        
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
            end
        end
        
        humanoid.PlatformStand = false
        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        hrp.CFrame = targetCFrame
    end
    
    local finalDist = (hrp.Position - finalTargetPos).Magnitude
    return finalDist <= 10
end

local function isFishingButtonPresent()
    local found = false
    pcall(function()
        for _, gui in ipairs(PlayerGui:GetChildren()) do
            if gui:IsA("ScreenGui") then
                for _, desc in ipairs(gui:GetDescendants()) do
                    if desc.Name == "FishingActionButton" and desc.Visible then
                        found = true
                        break
                    end
                end
            end
            if found then break end
        end
    end)
    return found
end

