local function isFishingButtonPresent()
    local found = false
    pcall(function()
        for _, gui in ipairs(PlayerGui:GetChildren()) do
            if gui:IsA("ScreenGui") then
                for _, desc in ipairs(gui:GetDescendants()) do
                    if (desc.Name == "FishingActionButton" or desc.Name == "Minigame" or string.find(string.lower(desc.Name), "reel")) and desc.Visible then
                        found = true
                        break
                    end
                end
            end
            if found then break end
        end
    end)
    return found
end

local function getFishCapacity()
    local currentFish, maxFish = 0, 50
    pcall(function()
        for _, gui in ipairs(PlayerGui:GetDescendants()) do
            if gui:IsA("TextLabel") and (gui.Name == "Capacity" or string.find(string.lower(gui.Text), "fish:")) then
                local cur, max = string.match(gui.Text, "(%d+)/(%d+)")
                if cur and max then
                    currentFish = tonumber(cur)
                    maxFish = tonumber(max)
                    break
                end
            end
        end
    end)
    return currentFish, maxFish
end

