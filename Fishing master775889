local originalButtonStates = {}

local function saveOriginalButtonState(button)
    if button and not originalButtonStates[button] then
        originalButtonStates[button] = {
            AnchorPoint = button.AnchorPoint,
            Position = button.Position,
            Size = button.Size,
            BackgroundTransparency = button.BackgroundTransparency,
            TextTransparency = button:IsA("TextButton") and button.TextTransparency or nil,
            ImageTransparency = button:IsA("ImageButton") and button.ImageTransparency or nil,
        }
    end
end

local function applyReelEnlargeAndTransparent(button)
    if button then
        saveOriginalButtonState(button)
        pcall(function()
            button.AnchorPoint = Vector2.new(0.5, 0.5)
            button.Position = UDim2.new(0.5, 0, 0.5, 0)
            button.Size = UDim2.new(button.Size.X.Scale * 1000, button.Size.X.Offset * 1000, button.Size.Y.Scale * 1000, button.Size.Y.Offset * 1000)
            button.BackgroundTransparency = 1
            if button:IsA("TextButton") then button.TextTransparency = 1
            elseif button:IsA("ImageButton") then button.ImageTransparency = 1 end
            
            for _, desc in ipairs(button:GetDescendants()) do
                pcall(function()
                    if desc:IsA("GuiObject") then desc.BackgroundTransparency = 1 end
                    if desc:IsA("TextLabel") or desc:IsA("TextBox") or desc:IsA("TextButton") then desc.TextTransparency = 1 end
                    if desc:IsA("ImageLabel") or desc:IsA("ImageButton") then desc.ImageTransparency = 1 end
