			end
		end
		return foundFishes
	end

	task.spawn(function()
		while true do
			pcall(function()
				if AutoLockRunning then
					isLockingActiveNow = true
					local modal = PlayerGui:FindFirstChild("SatchelModal")
					if not modal or not modal.Enabled then isLockingActiveNow = false; task.wait(0.2); return end
					local lockButton = findPreciseLockButton()
