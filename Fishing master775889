local originalButtonStates = {}

local function saveOriginalButtonState(button)
    if button and not originalButtonStates[button] then
        originalButtonStates[button] = {
            AnchorPoint = button.AnchorPoint,
            Position = button.Position,
            Size = button.Size,
            BackgroundTransparency = button.BackgroundTransparency,
            TextTransparency = button:IsA("TextButton") and button.TextTransparency or nil,
            ImageTransparency = button:IsA("ImageButton") and button.ImageTransparency or nil,
        }
    end
end

local function applyReelEnlargeAndTransparent(button)
    if button then
        saveOriginalButtonState(button)
        pcall(function()
            button.AnchorPoint = Vector2.new(0.5, 0.5)
            button.Position = UDim2.new(0.5, 0, 0.5, 0)
            button.Size = UDim2.new(
                button.Size.X.Scale * 1000, 
                button.Size.X.Offset * 1000, 
                button.Size.Y.Scale * 1000, 
                button.Size.Y.Offset * 1000
            )
            button.BackgroundTransparency = 1
            if button:IsA("TextButton") then
                button.TextTransparency = 1
            elseif button:IsA("ImageButton") then
                button.ImageTransparency = 1
            end
            
            for _, descendant in ipairs(button:GetDescendants()) do
                pcall(function()
                    if descendant:IsA("GuiObject") then
                        descendant.BackgroundTransparency = 1
                    end
                    if descendant:IsA("TextLabel") or descendant:IsA("TextBox") or descendant:IsA("TextButton") then
                        descendant.TextTransparency = 1
                    end
                    if descendant:IsA("ImageLabel") or descendant:IsA("ImageButton") then
                        descendant.ImageTransparency = 1
                    end
                end)
            end
        end)
    end
end

local function restoreReelButtons()
    pcall(function()
        for button, state in pairs(originalButtonStates) do
            if button and button.Parent then
                button.AnchorPoint = state.AnchorPoint
                button.Position = state.Position
                button.Size = state.Size
                button.BackgroundTransparency = state.BackgroundTransparency
                if button:IsA("TextButton") and state.TextTransparency then
                    button.TextTransparency = state.TextTransparency
                elseif button:IsA("ImageButton") and state.ImageTransparency then
                    button.ImageTransparency = state.ImageTransparency
                end
            end
        end
        originalButtonStates = {}
    end)
end

local function handleReelGuiEffect(enable)
    pcall(function()
        local reelGui = PlayerGui:FindFirstChild("ReelCounterGui")
        if reelGui then
            local btnLeft = reelGui:FindFirstChild("Left")
            local btnRight = reelGui:FindFirstChild("Right")
            local btnUp = reelGui:FindFirstChild("Up")
            
            if enable then
                if btnLeft then applyReelEnlargeAndTransparent(btnLeft) end
                if btnRight then applyReelEnlargeAndTransparent(btnRight) end
                if btnUp then applyReelEnlargeAndTransparent(btnUp) end
            else
