local function walkSmartlyTo(targetCFrame)
    local lp = Players.LocalPlayer
    local char = lp.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") then return false end
    
    local hrp = char.HumanoidRootPart
    local humanoid = char.Humanoid
    
    humanoid.WalkSpeed = 22
    humanoid.JumpPower = 50
    
    local finalTargetPos = targetCFrame.Position
    local startTime = tick()
    local timeout = 60 
    local connection
    local arrived = false
    local avoidDirection = 1 
    local avoidTimer = 0
    
    local lastCheckPos = hrp.Position
    local checkStuckTimer = tick()
    local isBackingUp = false
    local backupTimer = 0

    connection = RunService.RenderStepped:Connect(function(dt)
        if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") then
            if connection then connection:Disconnect() end
            return
        end
        
        humanoid.WalkSpeed = 22
        
        local currentPos = hrp.Position
        local targetXZ = Vector3.new(finalTargetPos.X, currentPos.Y, finalTargetPos.Z)
        local distance = (targetXZ - currentPos).Magnitude
        
        if distance < 4 or (tick() - startTime) > timeout then
            humanoid:Move(Vector3.new(0, 0, 0))
            arrived = true
            if connection then connection:Disconnect() end
            return
        end

        if isBackingUp then
            backupTimer = backupTimer - dt
            humanoid.Jump = true
            humanoid:Move(-hrp.CFrame.LookVector)
            if backupTimer <= 0 then
                isBackingUp = false
                avoidDirection = avoidDirection * -1
            end
            return
        end

        if tick() - checkStuckTimer >= 10 then
            local movedDist = (currentPos - lastCheckPos).Magnitude
            if movedDist < 1.5 then
                isBackingUp = true
                backupTimer = 2.5
                avoidDirection = avoidDirection * -1
            end
            lastCheckPos = currentPos
            checkStuckTimer = tick()
        end
        
        local baseMoveDir = (targetXZ - currentPos).Unit
        local finalMoveDir = baseMoveDir
        
        local raycastParams = RaycastParams.new()
        raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
        raycastParams.FilterDescendantsInstances = {char}
        
        local lookAheadDist = 36
        local frontRay = workspace:Raycast(currentPos + Vector3.new(0, 1, 0), baseMoveDir * lookAheadDist, raycastParams)
        
        if frontRay then
            humanoid.Jump = true
            
            if avoidTimer > 0 then
                avoidTimer = avoidTimer - dt
                local angle = (avoidDirection == 1) and math.rad(65) or math.rad(-65)
                finalMoveDir = (CFrame.Angles(0, angle, 0) * Vector3.new(baseMoveDir.X, 0, baseMoveDir.Z)).Unit
            else
                local rightDir = (CFrame.Angles(0, math.rad(65), 0) * Vector3.new(baseMoveDir.X, 0, baseMoveDir.Z)).Unit
                local rightRay = workspace:Raycast(currentPos + Vector3.new(0, 1, 0), rightDir * lookAheadDist, raycastParams)
                
                local leftDir = (CFrame.Angles(0, math.rad(-65), 0) * Vector3.new(baseMoveDir.X, 0, baseMoveDir.Z)).Unit
                local leftRay = workspace:Raycast(currentPos + Vector3.new(0, 1, 0), leftDir * lookAheadDist, raycastParams)
                
                if not rightRay then
                    avoidDirection = 1
                    avoidTimer = 2.0 
                    finalMoveDir = rightDir
                elseif not leftRay then
                    avoidDirection = -1
                    avoidTimer = 2.0
                    finalMoveDir = leftDir
                else
                    avoidDirection = avoidDirection * -1
                    avoidTimer = 2.0
                    local angle = (avoidDirection == 1) and math.rad(75) or math.rad(-75)
                    finalMoveDir = (CFrame.Angles(0, angle, 0) * Vector3.new(baseMoveDir.X, 0, baseMoveDir.Z)).Unit
                end
            end
        else
            avoidTimer = 0
            finalMoveDir = baseMoveDir
        end
        
        humanoid:Move(finalMoveDir)
    end)
    
    while not arrived and connection and connection.Connected do
        task.wait(0.05)
    end
    
    if connection then connection:Disconnect() end
    
    if char and char:FindFirstChild("HumanoidRootPart") then
        hrp.CFrame = targetCFrame
        humanoid:Move(Vector3.new(0, 0, 0))
    end
    
    if char and char:FindFirstChild("Humanoid") then
        char.Humanoid.WalkSpeed = 16
    end
    
    local finalDist = (hrp.Position - finalTargetPos).Magnitude
    return finalDist <= 8
end

