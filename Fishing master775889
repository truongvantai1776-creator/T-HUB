                                part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                            elseif obj:IsA("BasePart") then
                                part = obj
                            end
                            
                            if part then
                                local dist = (char.HumanoidRootPart.Position - part.Position).Magnitude
                                if dist < shortestDist then
                                    shortestDist = dist
                                    targetNpcPart = part
                                end
                            end
                        end
                    end
                    
                    if targetNpcPart then
                        StatusLabel.Text = "🚶 Đang đi bộ tới NPC..."
                        local targetPos = targetNpcPart.Position + Vector3.new(0, 0, 3)
                        
                        local arrivedAtNpc = walkSmartlyTo(CFrame.new(targetPos))
                        
                        if arrivedAtNpc then
                            StatusLabel.Text = "✅ Đã tới chỗ NPC!"
                            task.wait(0.3)
                            
                            pcall(function()
                                for _, obj in ipairs(workspace:GetDescendants()) do
                                    local nameLower = string.lower(obj.Name)
                                    if nameLower == "npc_fish_seller_1" or string.find(nameLower, "seller") then
                                        local part = nil
                                        if obj:IsA("Model") then
                                            part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                                        elseif obj:IsA("BasePart") then
                                            part = obj
                                        end
                                        
                                        if part and (part.Position - char.HumanoidRootPart.Position).Magnitude < 30 then
                                            for _, prompt in ipairs(part:GetDescendants()) do
                                                if prompt:IsA("ProximityPrompt") then
                                                    fireproximityprompt(prompt)
                                                end
                                            end
                                        end
                                    end
                                end
                            end)
                            
                            StatusLabel.Text = "⏳ Đợi hội thoại (5s)..."
                            task.wait(5.0)
                            GuiService.SelectedObject = nil 

                            StatusLabel.Text = "⏳ Nhấn Nút A..."
                            simulateGamePadButton(Enum.KeyCode.ButtonA, 0.08)
                            task.wait(0.08)
                            simulateGamePadButton(Enum.KeyCode.ButtonA, 0.08)
                            task.wait(0.5)
                            
                            local function selectOptionGamePadOnly(btnName)
                                pcall(function()
                                    local foundButton = nil
                                    for _, gui in ipairs(PlayerGui:GetChildren()) do
                                        if gui:IsA("ScreenGui") then
                                            for _, desc in ipairs(gui:GetDescendants()) do
                                                if desc.Name == btnName and desc:IsA("TextButton") and desc.Visible then
                                                    foundButton = desc
                                                    break
                                                end
                                            end
                                        end
                                        if foundButton then break end
                                    end
                                    
                                    if foundButton then
                                        GuiService.SelectedObject = foundButton
                                        task.wait(0.05)
                                        for _, conn in ipairs(getconnections(foundButton.MouseButton1Click) or {}) do conn:Fire() end
                                        for _, conn in ipairs(getconnections(foundButton.Activated) or {}) do conn:Fire() end
                                    end
                                    simulateGamePadButton(Enum.KeyCode.ButtonA, 0.08)
                                end)
                            end
                            
                            StatusLabel.Text = "🛒 Chọn Option002..."
                            selectOptionGamePadOnly("Option002")
                            task.wait(3.0)
                            
                            StatusLabel.Text = "🛒 Chọn Option001..."
                            selectOptionGamePadOnly("Option001")
                            task.wait(3.0)
                            
                            StatusLabel.Text = "🛒 Chọn Option002..."
                            selectOptionGamePadOnly("Option002")
                            task.wait(3.0)
                            
                            StatusLabel.Text = "🛒 Chọn Option001..."
                            selectOptionGamePadOnly("Option001")
                            task.wait(0.5)
                        else
                            StatusLabel.Text = "⚠ Không tới được NPC!"
                            task.wait(1)
                        end
                        
                        StatusLabel.Text = "🚶 Đang đi bộ về điểm set..."
                        walkSmartlyTo(returnCFrame)
                        
                        StatusLabel.Text = "✅ Đã về điểm câu!"
                    else
                        StatusLabel.Text = "⚠ Không thấy NPC!"
                        task.wait(1)
                    end
                end
                
                if isAutoSellRunning then
                    StatusLabel.Text = "🚀 Bật lại auto..."
                    task.wait(0.5)
                    if isAutoSellRunning then
                        startAutoMaster()
                    end
                end
                
                task.wait(0.5)
            end
        end)
    else
        AutoSellBtn.Text = "📦 Tự động bán: TẮT"
        AutoSellBtn.BackgroundColor3 = Color3.fromRGB(180, 100, 40)
        StatusLabel.Text = "⚡ Trạng thái: Đang tắt"
    end
end)
