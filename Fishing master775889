	local function parseLockFromSlot(slotObj) local isLocked = false pcall(function() if slotObj then local lockedObj = slotObj:FindFirstChild("Locked", true); if lockedObj and lockedObj:IsA("GuiObject") then if lockedObj.Visible and lockedObj.AbsoluteSize.X > 0 and lockedObj.AbsoluteSize.Y > 0 then isLocked = true end end end end); return isLocked end
	local function isFishTool(toolName) local lower = string.lower(toolName); local blacklist = {"rod", "cần", "bait", "mồi", "net", "lưới", "boat", "thuyền", "sword", "kiếm", "gun", "súng"}; for _, badWord in ipairs(blacklist) do if string.find(lower, badWord) then return false end end; return true end
	local function getCornerSafeClickPosition() local cam = workspace.CurrentCamera; if not cam then return 50, 50 end; local viewportSize = cam.ViewportSize; return viewportSize.X - 50, 50 end
