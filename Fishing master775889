						end
					end
					pressKeyLocally(Enum.KeyCode.Two); pressKeyLocally(Enum.KeyCode.One); task.wait(3.0); equipRodFromBackpack()
					isLockingActiveNow = false
				else isLockingActiveNow = false end
			end)
			task.wait(0.2)
		end
	end)
