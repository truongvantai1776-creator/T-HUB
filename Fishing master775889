	local function normalizeRarity(text) if not text then return nil end local t = string.lower(text); if string.find(t, "divine") then return "Divine" elseif string.find(t, "epic") then return "Epic" elseif string.find(t, "legendary") or string.find(t, "huyền thoại") then return "Legendary" elseif string.find(t, "mythical") then return "Mythical" elseif string.find(t, "rare") or string.find(t, "hiếm") then return "Rare" else return nil end end
