local function tweenMoveTo(targetPos, speed)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    
    local dist = (hrp.Position - targetPos).Magnitude
    local duration = dist / (speed or 35)
    
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(100000, 100000, 100000)
    bv.Velocity = Vector3.new(0, 0, 0)
    bv.Parent = hrp
    
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = CFrame.new(targetPos + Vector3.new(0, 3.5, 0))})
    
    local connection = RunService.Stepped:Connect(function()
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end)
    
    tween:Play()
    tween.Completed:Wait()
    
    connection:Disconnect()
    bv:Destroy()
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then part.CanCollide = true end
    end
    task.wait(0.1)
end

local function walkSmartlyTo_Sell(targetCFrame)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") then return false end
    
    local hrp = char.HumanoidRootPart
    local humanoid = char.Humanoid
    humanoid.WalkSpeed = 24
    
    local finalTargetPos = targetCFrame.Position
    local startTime = tick()
    local arrived = false
    local avoidDirection = 1 
    local avoidTimer = 0
    local lastCheckPos = hrp.Position
    local checkStuckTimer = tick()
    local isBackingUp = false
    local backupTimer = 0

    local connection
    connection = RunService.RenderStepped:Connect(function(dt)
        if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") then
            if connection then connection:Disconnect() end
            return
        end
        
        humanoid.WalkSpeed = 24
        local currentPos = hrp.Position
        local targetXZ = Vector3.new(finalTargetPos.X, currentPos.Y, finalTargetPos.Z)
        local distance = (targetXZ - currentPos).Magnitude
        
        if distance < 2 then
            humanoid:Move(Vector3.new(0, 0, 0))
            arrived = true
            if connection then connection:Disconnect() end
            return
        end

        if (tick() - startTime) > 120 then
            humanoid.Health = 0
            arrived = true
            if connection then connection:Disconnect() end
            return
        end

        if isBackingUp then
            backupTimer = backupTimer - dt
            humanoid.Jump = true
            humanoid:Move(-hrp.CFrame.LookVector)
            if backupTimer <= 0 then 
                isBackingUp = false
                avoidDirection = avoidDirection * -1 
            end
            return
        end

        if tick() - checkStuckTimer >= 10 then
            if (currentPos - lastCheckPos).Magnitude < 1.5 then
                isBackingUp = true
                backupTimer = 2.0
                avoidDirection = avoidDirection * -1
            end
            lastCheckPos = currentPos
            checkStuckTimer = tick()
        end
        
        local baseMoveDir = (targetXZ - currentPos).Unit
        local raycastParams = RaycastParams.new()
        raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
        raycastParams.FilterDescendantsInstances = {char}
        
        local frontRay = workspace:Raycast(currentPos + Vector3.new(0, 1, 0), baseMoveDir * 60, raycastParams)
        if frontRay then
            humanoid.Jump = true
            if avoidTimer > 0 then
                avoidTimer = avoidTimer - dt
            else
                avoidDirection = avoidDirection * -1
                avoidTimer = 1.5
            end
            local angle = (avoidDirection == 1) and math.rad(65) or math.rad(-65)
            humanoid:Move((CFrame.Angles(0, angle, 0) * Vector3.new(baseMoveDir.X, 0, baseMoveDir.Z)).Unit)
        else
            avoidTimer = 0
            humanoid:Move(baseMoveDir)
        end
    end)
    
    while not arrived and connection and connection.Connected do
        task.wait(0.05)
    end
    
    if connection then connection:Disconnect() end
    
    if char and char:FindFirstChild("Humanoid") then
        humanoid:Move(Vector3.new(0, 0, 0))
        char.Humanoid.WalkSpeed = 20 
    end
    
    return (hrp.Position - finalTargetPos).Magnitude <= 6
end

local function movePlayerToTarget_Sell(targetPos, speed)
    if sellMoveMode == "Đi bộ thông minh" then 
        walkSmartlyTo_Sell(CFrame.new(targetPos)) 
    else 
        tweenMoveTo(targetPos, speed or 35) 
    end
end

