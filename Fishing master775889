local function applyGoldAndBlackSweep(uiGradient)
    task.spawn(function()
        while uiGradient and uiGradient.Parent do
            local offset = (tick() % 2) / 2 
            uiGradient.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 215, 0)),
                ColorSequenceKeypoint.new(math.clamp(offset - 0.1, 0, 1), Color3.fromRGB(255, 215, 0)),
                ColorSequenceKeypoint.new(math.clamp(offset, 0, 1), Color3.fromRGB(0, 0, 0)),
                ColorSequenceKeypoint.new(math.clamp(offset + 0.1, 0, 1), Color3.fromRGB(255, 215, 0)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 165, 0))
            })
            RunService.RenderStepped:Wait()
        end
    end)
end

local function processCharacterTag(character)
    local nametags = workspace:FindFirstChild("Nametags")
    if not nametags then return end
    
    local myNametag = nametags:FindFirstChild(LocalPlayer.Name)
    if myNametag then
        for _, descendant in ipairs(myNametag:GetDescendants()) do
            if descendant:IsA("TextLabel") or descendant:IsA("TextButton") then
                descendant.Text = "T HUB VIP"
                descendant.RichText = true
                descendant.TextSize = 35 
                
                local uiGradient = descendant:FindFirstChildOfClass("UIGradient")
                if not uiGradient then
                    uiGradient = Instance.new("UIGradient")
                    uiGradient.Parent = descendant
                end
                
                applyGoldAndBlackSweep(uiGradient)
            end
        end
    end
end

