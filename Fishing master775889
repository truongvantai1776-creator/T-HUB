local isRunning = false
local cameraLockConnection = nil
local autoMasterToggleRef = nil

local function enableCameraLock()
    if cameraLockConnection then cameraLockConnection:Disconnect() end
    cameraLockConnection = RunService.RenderStepped:Connect(function()
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
            local rootPart = char.HumanoidRootPart
            local humanoid = char.Humanoid
            humanoid.WalkSpeed = 0
            humanoid.JumpPower = 0
            if savedAutoCFrame then
                rootPart.CFrame = savedAutoCFrame
                rootPart.Velocity = Vector3.new(0, 0, 0)
            end
            local camPos = rootPart.Position - (rootPart.CFrame.LookVector * 6) + Vector3.new(0, 3, 0)
            Camera.CFrame = CFrame.new(camPos, rootPart.Position + Vector3.new(0, 1, 0))
        end
    end)
end

local function disableCameraLock()
    if cameraLockConnection then
        cameraLockConnection:Disconnect()
        cameraLockConnection = nil
    end
    Camera.CameraType = Enum.CameraType.Custom
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.WalkSpeed = 16
        LocalPlayer.Character.Humanoid.JumpPower = 50
    end
end

local function walkSmartlyTo(targetCFrame, customSpeed)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") then return false end
    local hrp = char.HumanoidRootPart
    local humanoid = char.Humanoid
    local travelSpeed = customSpeed or 30
    humanoid.WalkSpeed = travelSpeed
    
    local finalTargetPos = targetCFrame.Position
    local startTime = tick()
    local arrived = false
    local avoidDirection = 1 
    local avoidTimer = 0
    local lastCheckPos = hrp.Position
    local checkStuckTimer = tick()
    local isBackingUp = false
    local backupTimer = 0

    local connection
    connection = RunService.RenderStepped:Connect(function(dt)
        if not char or not char:FindFirstChild("HumanoidRootPart") then
            if connection then connection:Disconnect() end
            return
        end
        humanoid.WalkSpeed = travelSpeed
        local currentPos = hrp.Position
        local targetXZ = Vector3.new(finalTargetPos.X, currentPos.Y, finalTargetPos.Z)
        local distance = (targetXZ - currentPos).Magnitude
        
        if distance < 6 or (tick() - startTime) > 60 then
            humanoid:Move(Vector3.new(0, 0, 0))
            arrived = true
            if connection then connection:Disconnect() end
            return
        end

        if isBackingUp then
            backupTimer = backupTimer - dt
            humanoid.Jump = true
            humanoid:Move(-hrp.CFrame.LookVector)
            if backupTimer <= 0 then isBackingUp = false; avoidDirection = avoidDirection * -1 end
            return
        end

        if tick() - checkStuckTimer >= 10 then
            if (currentPos - lastCheckPos).Magnitude < 1.5 then
                isBackingUp = true
                backupTimer = 2.0
                avoidDirection = avoidDirection * -1
            end
            lastCheckPos = currentPos
            checkStuckTimer = tick()
        end
        
        local baseMoveDir = (targetXZ - currentPos).Unit
        local raycastParams = RaycastParams.new()
        raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
        raycastParams.FilterDescendantsInstances = {char}
        
        local frontRay = workspace:Raycast(currentPos + Vector3.new(0, 1, 0), baseMoveDir * 36, raycastParams)
        if frontRay then
            humanoid.Jump = true
            if avoidTimer > 0 then
                avoidTimer = avoidTimer - dt
            else
                avoidDirection = avoidDirection * -1
                avoidTimer = 1.5
            end
            local angle = (avoidDirection == 1) and math.rad(65) or math.rad(-65)
            humanoid:Move((CFrame.Angles(0, angle, 0) * Vector3.new(baseMoveDir.X, 0, baseMoveDir.Z)).Unit)
        else
            avoidTimer = 0
            humanoid:Move(baseMoveDir)
        end
    end)
    
    while not arrived and connection and connection.Connected do
        task.wait(0.05)
    end
    if connection then connection:Disconnect() end
    if char and char:FindFirstChild("Humanoid") then
        humanoid:Move(Vector3.new(0, 0, 0))
        char.Humanoid.WalkSpeed = 16
    end
    return (hrp.Position - finalTargetPos).Magnitude <= 10
end

