local function scanExactIslands()
    local scanned = {}
    pcall(function()
        local worldFolder = workspace:FindFirstChild("World")
        if worldFolder then
            local islandsFolder = worldFolder:FindFirstChild("Islands")
            if islandsFolder then
                for _, islandFolder in ipairs(islandsFolder:GetChildren()) do
                    pcall(function()
                        if islandFolder:IsA("Folder") or islandFolder:IsA("Model") then
                            local targetPos = nil
                            local spawnPoint = islandFolder:FindFirstChild("SpawnPoint", true)
                            if spawnPoint then
                                if spawnPoint:IsA("BasePart") then
                                    targetPos = spawnPoint.Position
                                elseif spawnPoint:IsA("Model") then
                                    targetPos = spawnPoint:GetPivot().Position
                                end
                            end
                            
                            if not targetPos then
                                for _, desc in ipairs(islandFolder:GetDescendants()) do
                                    if desc:IsA("BasePart") then
                                        targetPos = desc.Position
                                        break
                                    end
                                end
                            end
                            
                            if targetPos then
                                local cleanName = string.gsub(islandFolder.Name, "^island_", "")
                                table.insert(scanned, {name = cleanName, pos = targetPos})
                            end
                        end
                    end)
                end
            end
        end
    end)
    
    if #scanned > 0 then
        islandsList = scanned
    else
        islandsList = {{name = "Starter", pos = Vector3.new(0, 10, 0)}}
    end
end

