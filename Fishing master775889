						if foundRarity or desc:FindFirstChild("ImageLabel", true) then
							if not persistentFishCache[slotName] then persistentFishCache[slotName] = {} end
							if foundRarity then persistentFishCache[slotName].Rarity = foundRarity end
							persistentFishCache[slotName].Locked = isLocked; persistentFishCache[slotName].SlotObj = desc
						end
					end
				end
			end
		end)
		local foundFishes = {}
