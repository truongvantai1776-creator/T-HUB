	local layout = Instance.new("UIListLayout"); layout.SortOrder = Enum.SortOrder.LayoutOrder; layout.Padding = UDim.new(0, 6); layout.Parent = scroll
	local padding = Instance.new("UIPadding"); padding.PaddingTop = UDim.new(0, 10); padding.PaddingLeft = UDim.new(0, 15); padding.PaddingRight = UDim.new(0, 15); padding.PaddingBottom = UDim.new(0, 10); padding.Parent = scroll
	Pages[name] = scroll
	return scroll
end

local function ShowPage(name)
	local p = Pages[name]
	if p and not p.Visible then
		p.Position = UDim2.fromOffset(20, 0)
		p.Visible = true
		TweenService:Create(p, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Position = UDim2.fromOffset(0, 0)
		}):Play()
	end
	for n, page in pairs(Pages) do
		if n ~= name then page.Visible = false end
	end
end

