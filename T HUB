local function Page(name)
	local scroll = Instance.new("ScrollingFrame")
	scroll.Name = name; scroll.Size = UDim2.new(1, 0, 1, 0); scroll.BackgroundTransparency = 1; scroll.Visible = false
	scroll.BorderSizePixel = 0; scroll.ScrollBarThickness = 4; scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
