function GetSelectedAutoFarmTargetPart()
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("Model") and string.lower(v.Name) == string.lower(_G.SelectedAutoFarmTarget) then
            local targetPart = v.PrimaryPart or v:FindFirstChildWhichIsA("BasePart")
            if targetPart then
                return targetPart
            end
        end
    end
    return nil
end

function GetZeusBossTarget()
    for _, v in pairs(workspace:GetDescendants()) do
        if (v:IsA("Model") or v:IsA("BasePart")) and string.find(string.lower(v.Name), "zeusboss") then
            local targetPart = nil
            if v:IsA("Model") then
                targetPart = v.PrimaryPart or v:FindFirstChild("HumanoidRootPart") or v:FindFirstChildWhichIsA("BasePart")
            elseif v:IsA("BasePart") then
                targetPart = v
            end
            if targetPart then
                local humanoid = v:IsA("Model") and v:FindFirstChildOfClass("Humanoid") or nil
                if not humanoid or humanoid.Health > 0 then
                    return targetPart
                end
            end
        end
    end
    return nil
end

function CheckBattleButtonVisible()
    for _, gui in pairs(playerGui:GetDescendants()) do
        if (gui:IsA("TextButton") or gui:IsA("ImageButton")) and string.lower(gui.Name) == "battle" then
            if gui.Visible and gui.AbsoluteSize.X > 0 and gui.AbsoluteSize.Y > 0 then
                local isParentVisible = true
                local parent = gui.Parent
                while parent and parent ~= playerGui do
                    if parent:IsA("GuiObject") and parent.Visible == false then
                        isParentVisible = false
                        break
                    end
                    parent = parent.Parent
                end
                
                if isParentVisible then
                    return gui
                end
            end
        end
    end
    return nil
end

function IsValidMob(model)
    if not model:IsA("Model") then return false end
    if model == LocalPlayer.Character then return false end
    if Players:GetPlayerFromCharacter(model) then return false end
    
    local rootPart = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
    if not rootPart then return false end
    
    local name = string.lower(model.Name)
    if string.find(name, "shop") or string.find(name, "merchant") or string.find(name, "dealer") then
        return false
    end

    return true
end

function GetRootPartToMove()
    local character = LocalPlayer.Character
    if not character then return nil, nil end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.SeatPart then
        local seat = humanoid.SeatPart
        local model = seat:FindFirstAncestorOfClass("Model")
        if model then
            if model.PrimaryPart then
                return model.PrimaryPart, model
            else
                return seat, model
            end
        end
    end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    return rootPart, character
end

RunService.RenderStepped:Connect(function()
    for _, v in pairs(workspace:GetDescendants()) do
        if IsValidMob(v) then
            local head = v:FindFirstChild("Head") or v:FindFirstChild("HumanoidRootPart") or v:FindFirstChildWhichIsA("BasePart")
            local humanoid = v:FindFirstChildOfClass("Humanoid")
            
            local highlight = v:FindFirstChild("MobEspHighlight")
            local billboard = v:FindFirstChild("MobEspBillboard")
            
            if _G.EspMobsActive then
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "MobEspHighlight"
                    highlight.Adornee = v
                    highlight.FillColor = Color3.fromRGB(255, 50, 50)
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = 0.5
                    highlight.OutlineTransparency = 0
                    highlight.Parent = v
                end
                
                if not billboard and head then
                    billboard = Instance.new("BillboardGui")
                    billboard.Name = "MobEspBillboard"
                    billboard.Size = UDim2.new(0, 100, 0, 50)
                    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
                    billboard.AlwaysOnTop = true
                    billboard.Adornee = head
                    billboard.Parent = v
                    
                    local textLabel = Instance.new("TextLabel")
                    textLabel.Name = "EspText"
                    textLabel.Size = UDim2.new(1, 0, 1, 0)
                    textLabel.BackgroundTransparency = 1
                    textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                    textLabel.TextStrokeTransparency = 0
                    textLabel.TextSize = 13
                    textLabel.Font = Enum.Font.SourceSansBold
                    textLabel.Parent = billboard
                end
                
                if billboard and billboard:FindFirstChild("EspText") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and head then
                    local dist = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - head.Position).Magnitude)
                    local hpText = humanoid and string.format("HP: %d/%d", math.floor(humanoid.Health), math.floor(humanoid.MaxHealth)) or "Zombie"
                    billboard.EspText.Text = string.format("%s\n%s\n[%dm]", v.Name, hpText, dist)
                end
            else
                if highlight then highlight:Destroy() end
                if billboard then billboard:Destroy() end
            end
        end
    end
end)

