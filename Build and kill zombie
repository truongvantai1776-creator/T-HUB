function IsValidMob(model)
    if not model:IsA("Model") then return false end
    if model == LocalPlayer.Character then return false end
    if Players:GetPlayerFromCharacter(model) then return false end
    
    local rootPart = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
    if not rootPart then return false end
    
    local name = string.lower(model.Name)
    if string.find(name, "shop") or string.find(name, "merchant") or string.find(name, "dealer") then
        return false
    end

    return true
end

function GetNextLeverPart(lastPart)
    local partsList = {}
    local playerName = string.lower(LocalPlayer.Name)
    local char = LocalPlayer.Character
    if not char then return nil end
    local rootPart = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("PrimaryPart")
    if not rootPart then return nil end
    
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("BasePart") then
            if string.find(obj.Name, "Lever") then
                local ownedByOther = false
                local ancestor = obj
                
                while ancestor and ancestor ~= workspace do
                    local ancestorName = string.lower(ancestor.Name)
                    for _, p in pairs(Players:GetPlayers()) do
                        if p ~= LocalPlayer and string.find(ancestorName, string.lower(p.Name)) then
                            ownedByOther = true
                            break
                        end
                    end
                    if ownedByOther then break end
                    
                    if ancestor:IsA("Model") or ancestor:IsA("Folder") then
                        for _, child in pairs(ancestor:GetChildren()) do
                            local childName = string.lower(child.Name)
                            if childName == "owner" or childName == "player" or childName == "playername" then
                                if child:IsA("StringValue") then
                                    local val = string.lower(child.Value)
                                    if val ~= "" and val ~= playerName then
                                        ownedByOther = true
                                    end
                                end
                            elseif childName == "userid" then
                                if child:IsA("IntValue") then
                                    if child.Value ~= 0 and child.Value ~= LocalPlayer.UserId then
                                        ownedByOther = true
                                    end
                                end
                            end
                        end
                    end
                    ancestor = ancestor.Parent
                end
                
                if not ownedByOther then
                    local targetPart = nil
                    if obj:IsA("Model") then
                        targetPart = obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildWhichIsA("BasePart")
                    elseif obj:IsA("BasePart") then
                        targetPart = obj
                    end
                    
                    if targetPart then
                        local isLastVisited = false
                        if lastPart and (targetPart == lastPart or (targetPart.Position - lastPart.Position).Magnitude < 5) then
                            isLastVisited = true
                        end
                        
                        if not isLastVisited then
                            local success, dist = pcall(function()
                                return (targetPart.Position - rootPart.Position).Magnitude
                            end)
                            if success and dist > 3 then
                                table.insert(partsList, {part = targetPart, distance = dist})
                            end
                        end
                    end
                end
            end
        end
    end
    
    table.sort(partsList, function(a, b)
        return a.distance < b.distance
    end)
    
    if #partsList > 0 then
        return partsList[1].part
    end
    return nil
end

function TriggerLeverAction(targetPart)
    pcall(function()
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("ProximityPrompt") then
                local parent = obj.Parent
                if parent and (parent == targetPart or parent:IsDescendantOf(targetPart) or (parent:IsA("BasePart") and (parent.Position - targetPart.Position).Magnitude <= 10)) then
                    local actionText = obj.ActionText or ""
                    local objectText = obj.ObjectText or ""
                    local combinedText = string.lower(actionText .. " " .. objectText .. " " .. obj.Name)
                    
                    if not string.find(combinedText, "select") then
                        obj.HoldDuration = 0
                        fireproximityprompt(obj)
                    end
                end
            end
        end

        for _, descendant in pairs(ReplicatedStorage:GetDescendants()) do
            if descendant:IsA("RemoteEvent") then
                local name = string.lower(descendant.Name)
                if not string.find(name, "select") then
                    if string.find(name, "roll") or string.find(name, "lever") or string.find(name, "interact") then
                        descendant:FireServer(targetPart)
                    end
                end
            end
        end
    end)
end

function GetRootPartToMove()
    local character = LocalPlayer.Character
    if not character then return nil, nil end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.SeatPart then
        local seat = humanoid.SeatPart
        local model = seat:FindFirstAncestorOfClass("Model")
        if model then
            if model.PrimaryPart then
                return model.PrimaryPart, model
            else
                return seat, model
            end
        end
    end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    return rootPart, character
end

function SmoothFlyToTarget(targetPart)
    if not targetPart or not targetPart.Parent then return end
    
    local currentRoot, moveModel = GetRootPartToMove()
    if not currentRoot then return end

    local targetPos = targetPart.Position
    
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
    
    local groundRay = workspace:Raycast(targetPos + Vector3.new(0, 50, 0), Vector3.new(0, -100, 0), raycastParams)
    if groundRay then
        targetPos = groundRay.Position + Vector3.new(0, 3, 0)
    else
        targetPos = targetPos + Vector3.new(0, 3, 0)
    end

    local distance = (targetPos - currentRoot.Position).Magnitude
    local speed = 60 
    local timeTaken = math.clamp(distance / speed, 0.1, 3)

    local tweenInfo = TweenInfo.new(timeTaken, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
    local tween

    if moveModel:IsA("Model") and moveModel.PrimaryPart then
        tween = TweenService:Create(moveModel.PrimaryPart, tweenInfo, {CFrame = CFrame.new(targetPos)})
    else
        tween = TweenService:Create(currentRoot, tweenInfo, {CFrame = CFrame.new(targetPos)})
    end

    tween:Play()
    
    local connection
    connection = RunService.RenderStepped:Connect(function()
        if not _G.AutoRollActive and not _G.AutoFarmActive then
            tween:Cancel()
            if connection then connection:Disconnect() end
        end
    end)

    tween.Completed:Wait()
    if connection then connection:Disconnect() end
end

