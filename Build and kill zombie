-- Vòng lặp chính xử lý Auto Farm liên tục không ngừng nghỉ bám sát mục tiêu và mặt đất
task.spawn(function()
    local lastVisitedPart = nil
    while true do
        if _G.AutoFarmActive then
            local targetPart = GetBasicTarget()
            if targetPart then
                SmoothFlyToTarget(targetPart)
            else
                task.wait(0.1)
            end
        elseif _G.AutoRollActive then
            local character = LocalPlayer.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local rootPart = character and character:FindFirstChild("HumanoidRootPart")
            
            if not character or not humanoid or humanoid.Health <= 0 or not rootPart then
                lastVisitedPart = nil
                task.wait(1)
                continue
            end
            
            local nextPart = GetNextLeverPart(lastVisitedPart)
            
            if not nextPart and lastVisitedPart then
                nextPart = lastVisitedPart
            end
            
            if nextPart then
                SmoothFlyToTarget(nextPart)
                task.wait(0.1)
                TriggerLeverAction(nextPart)
                
                lastVisitedPart = nextPart
                task.wait(0.2)
            else
                lastVisitedPart = nil
            end
        end
        task.wait(0.05)
    end
end)
