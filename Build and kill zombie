-- Vòng lặp xử lý Auto Boss
task.spawn(function()
    local circleAngle = 0
    local rollWasOnBeforeBattle = false
    local bossHandlingActive = false
    
    while true do
        if _G.AutoBossActive then
            pcall(function()
                local targetButton = FindBattleButton()
                local bossPart = GetZeusBossTarget()
                
                if targetButton or bossPart then
                    if targetButton and not bossHandlingActive then
                        bossHandlingActive = true
                        if _G.AutoRollActive then
                            rollWasOnBeforeBattle = true
                            _G.AutoRollActive = false
                            local rollBtnUI = mainFrame:FindFirstChild("ToggleRollBtn")
                            if rollBtnUI then
                                rollBtnUI.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
                                rollBtnUI.Text = "Auto Lever Roll: OFF"
                            end
                        end
                    end
                    
                    if targetButton then
                        for _, conn in pairs(getconnections(targetButton.Activated)) do conn:Fire() end
                        for _, conn in pairs(getconnections(targetButton.MouseButton1Click)) do conn:Fire() end
                        if firesignal then
                            pcall(function() firesignal(targetButton.Activated) end)
                            pcall(function() firesignal(targetButton.MouseButton1Click) end)
                        end
                    end
                    
                    if bossPart and bossPart.Parent then
                        local currentRoot, moveModel = GetRootPartToMove()
                        if currentRoot then
                            circleAngle = circleAngle + 0.2 
                            local radius = 28 
                            local offsetX = math.cos(circleAngle) * radius
                            local offsetZ = math.sin(circleAngle) * radius
                            
                            local bossPos = bossPart.Position
                            local desiredPos = bossPos + Vector3.new(offsetX, 5, offsetZ)
                            
                            local distance = (desiredPos - currentRoot.Position).Magnitude
                            if distance > 1 then
                                local speed = 25 
                                local timeTaken = distance / speed
                                local tweenInfo = TweenInfo.new(timeTaken, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
                                local tween
                                
                                if moveModel:IsA("Model") and moveModel.PrimaryPart then
                                    tween = TweenService:Create(moveModel.PrimaryPart, tweenInfo, {CFrame = CFrame.new(desiredPos, bossPos)})
                                else
                                    tween = TweenService:Create(currentRoot, tweenInfo, {CFrame = CFrame.new(desiredPos, bossPos)})
                                end
                                tween:Play()
                                task.wait(math.min(timeTaken, 0.1))
                            end
                        end
                    end
                else
                    if bossHandlingActive then
                        bossHandlingActive = false
                        if rollWasOnBeforeBattle then
                            task.wait(2)
                            if _G.AutoBossActive then
                                _G.AutoRollActive = true
                                local rollBtnUI = mainFrame:FindFirstChild("ToggleRollBtn")
                                if rollBtnUI then
                                    rollBtnUI.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
                                    rollBtnUI.Text = "Auto Lever Roll: ON"
                                end
                            end
                            rollWasOnBeforeBattle = false
                        end
                    elseif _G.AutoRollActive then
                        task.wait(0.2)
                    end
                end
            end)
        else
            bossHandlingActive = false
            rollWasOnBeforeBattle = false
        end
        task.wait(0.05)
    end
end)

-- Vòng lặp chính xử lý Auto Farm, Giữ nút W bay thẳng bám sát đất, và Auto Lever Roll
task.spawn(function()
    local lastVisitedPart = nil
    while true do
        if _G.AutoFarmActive then
            -- Kiểm tra nếu người chơi đang GIỮ nút W
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then
                local currentRoot, moveModel = GetRootPartToMove()
                if currentRoot then
                    -- Lặp liên tục bay thẳng về phía trước và bám sát mặt đất cho đến khi tìm thấy quái hoặc nhả nút W
                    while UserInputService:IsKeyDown(Enum.KeyCode.W) and _G.AutoFarmActive do
                        local targetPart = GetSelectedAutoFarmTargetPart()
                        -- Nếu tìm thấy quái mới thì thoát khỏi chế độ bay thẳng để chuyển sang mục tiêu quái
                        if targetPart then
                            break
                        end

                        pcall(function()
                            local lookVector = currentRoot.CFrame.LookVector
                            local forwardPos = currentRoot.Position + (Vector3.new(lookVector.X, 0, lookVector.Z).Unit * 5)
                            
                            local raycastParams = RaycastParams.new()
                            raycastParams.FilterType = Enum.RaycastFilterType.Exclude
                            raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
                            
                            local groundRay = workspace:Raycast(forwardPos + Vector3.new(0, 50, 0), Vector3.new(0, -100, 0), raycastParams)
                            local targetY = forwardPos.Y
                            if groundRay then
                                targetY = groundRay.Position.Y + 3 -- Giữ bám sát mặt đất 3 studs
                            end
                            
                            local nextPos = Vector3.new(forwardPos.X, targetY, forwardPos.Z)
                            local newCFrame = CFrame.new(nextPos, nextPos + Vector3.new(lookVector.X, 0, lookVector.Z))
                            
                            if moveModel:IsA("Model") and moveModel.PrimaryPart then
                                moveModel:SetPrimaryPartCFrame(newCFrame)
                            else
                                currentRoot.CFrame = newCFrame
                            end
                        end)
                        RunService.RenderStepped:Wait()
                    end
                end
            else
                local targetPart = GetSelectedAutoFarmTargetPart()
                if targetPart then
                    SmoothFlyToTarget(targetPart)
                else
                    task.wait(0.1)
                end
            end
        elseif _G.AutoRollActive then
            local character = LocalPlayer.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local rootPart = character and character:FindFirstChild("HumanoidRootPart")
            
            if not character or not humanoid or humanoid.Health <= 0 or not rootPart then
                lastVisitedPart = nil
                task.wait(1)
                continue
            end
            
            local nextPart = GetNextLeverPart(lastVisitedPart)
            
            if not nextPart and lastVisitedPart then
                nextPart = lastVisitedPart
            end
            
            if nextPart then
                SmoothFlyToTarget(nextPart)
                task.wait(0.1)
                TriggerLeverAction(nextPart)
                
                lastVisitedPart = nextPart
                task.wait(0.2)
            else
                lastVisitedPart = nil
            end
        end
        task.wait(0.05)
    end
end)
