local function PressKey(keyCode)
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
    end)
end

-- Vòng lặp tự động giữ nút W khi Auto Farm bật (nhịp 3s giữ, 1s nghỉ)
task.spawn(function()
    while true do
        if _G.AutoFarmActive then
            pcall(function()
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.W, false, game)
            end)
            
            local elapsed = 0
            while elapsed < 3 and _G.AutoFarmActive do
                task.wait(0.1)
                elapsed = elapsed + 0.1
            end
            
            pcall(function()
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.W, false, game)
            end)
            
            local restTime = 0
            while restTime < 1 and _G.AutoFarmActive do
                task.wait(0.1)
                restTime = restTime + 1
            end
        else
            pcall(function()
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.W, false, game)
            end)
            task.wait(0.2)
        end
    end
end)

local function RunFarmKeySequence()
    while _G.AutoFarmActive do
        for i = 1, 3 do
            if not _G.AutoFarmActive then break end
            PressKey(Enum.KeyCode.F)
            if i < 3 then
                task.wait(1)
            end
        end
        break 
    end
end

