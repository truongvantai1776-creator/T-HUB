local function HandleModeSwitch(targetMode)
    if _G.AutoFarmActive then
        farmWasActiveBeforeModeChange = true
        _G.AutoFarmActive = false
        toggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        toggleBtn.Text = "Auto Farm: OFF"
    else
        farmWasActiveBeforeModeChange = false
    end

    if targetMode == "Basic" then
        _G.SelectedAutoFarmTarget = "Basic"
        _G.InfiniteFlyActive = false
        _G.LockedLookVector = nil
        if optionButtons["Basic"] then optionButtons["Basic"].BackgroundColor3 = Color3.fromRGB(50, 200, 50) end
        if optionButtons["Infinite"] then optionButtons["Infinite"].BackgroundColor3 = Color3.fromRGB(80, 80, 80) end
    elseif targetMode == "Infinite" then
        _G.SelectedAutoFarmTarget = "Infinite"
        _G.InfiniteFlyActive = true
        _G.LockedLookVector = nil
        if optionButtons["Infinite"] then optionButtons["Infinite"].BackgroundColor3 = Color3.fromRGB(50, 200, 50) end
        if optionButtons["Basic"] then optionButtons["Basic"].BackgroundColor3 = Color3.fromRGB(80, 80, 80) end
    end
    
    subMenuFrame.Visible = false

    task.spawn(function()
        pcall(function()
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
                LocalPlayer.Character:FindFirstChildOfClass("Humanoid").Health = 0
            end
        end)
    end)
end

