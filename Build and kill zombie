local lastPosition = nil
local rollWasActiveBeforeDeath = false

local function MonitorTeleportAndDeath(character)
    local rootPart = character:WaitForChild("HumanoidRootPart", 5)
    local humanoid = character:WaitForChild("Humanoid", 5)
    
    if rootPart then
        lastPosition = rootPart.Position
    end

    if humanoid then
        humanoid.Died:Connect(function()
            if _G.AutoRollActive then
                rollWasActiveBeforeDeath = true
            end
        end)
    end
end

LocalPlayer.CharacterAdded:Connect(function(character)
    MonitorTeleportAndDeath(character)
    
    if rollWasActiveBeforeDeath then
        task.spawn(function()
            task.wait(1) 
            _G.AutoRollActive = true
            local rollBtnUI = mainFrame:FindFirstChild("ToggleRollBtn")
            if rollBtnUI then
                rollBtnUI.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
                rollBtnUI.Text = "Auto Lever Roll: ON"
            end
            rollWasActiveBeforeDeath = false
        end)
    end

    if farmWasActiveBeforeModeChange then
        task.spawn(function()
            task.wait(1.5)
            _G.AutoFarmActive = true
            _G.LockedLookVector = nil
            toggleBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
            toggleBtn.Text = "Auto Farm: ON"
            farmWasActiveBeforeModeChange = false
        end)
    end
end)

