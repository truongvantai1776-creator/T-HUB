-- Vô hiệu hóa toàn bộ âm thanh xuất hiện trong SoundService
local function muteAllSounds()
    pcall(function()
        SoundService.Volume = 0
        for _, sound in ipairs(SoundService:GetDescendants()) do
            if sound:IsA("Sound") then
                sound.Volume = 0
                sound:Stop()
            end
        end
    end)
end

-- Lắng nghe và tự động tắt mọi âm thanh mới sinh ra
SoundService.ChildAdded:Connect(function(child)
    if child:IsA("Sound") then
        pcall(function()
            child.Volume = 0
            child:Stop()
        end)
    end
end)

-- Hàm kích hoạt sự kiện UI đồng thời tắt sạch âm thanh của nút
local function triggerButtonSignalOnce(btnName)
    muteAllSounds()
    for _, gui in ipairs(playerGui:GetChildren()) do
        if gui ~= Window.Root then
            for _, descendant in ipairs(gui:GetDescendants()) do
                if descendant.Name == btnName and (descendant:IsA("GuiButton") or descendant:IsA("TextButton") or descendant:IsA("ImageButton")) then
                    pcall(function()
                        for _, sound in ipairs(descendant:GetDescendants()) do
                            if sound:IsA("Sound") then
                                sound.Volume = 0
                                sound:Stop()
                            end
                        end

                        if getconnections then
                            for _, connection in ipairs(getconnections(descendant.Activated)) do
                                connection:Fire()
                            end
                            for _, connection in ipairs(getconnections(descendant.MouseButton1Click)) do
                                connection:Fire()
                            end
                        elseif firesignal then
                            firesignal(descendant.MouseButton1Click)
                            firesignal(descendant.Activated)
                        end
                    end)
                    return
                end
            end
        end
    end
end

