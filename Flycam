-- 5. Xử lý vuốt màn hình xoay hướng tự do mượt mà
UserInputService.InputChanged:Connect(function(input)
    if not CamActive then return end
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement then
        local sensitivity = 0.005
        CameraRotationX = CameraRotationX - input.Delta.X * sensitivity
        CameraRotationY = math.clamp(CameraRotationY - input.Delta.Y * sensitivity, -math.rad(80), math.rad(80))
    end
end)

-- 6. VÒNG LẶP RENDERSTEPPED: Điều khiển hướng bay theo Joystick
RunService.RenderStepped:Connect(function(dt)
    if CamActive then
        Camera.FieldOfView = CamFOV
        
        local finalRotation = CFrame.Angles(0, CameraRotationX, 0) * CFrame.Angles(CameraRotationY, 0, 0)
        Camera.CFrame = CFrame.new(CamCFrame.Position) * finalRotation
        
        local moveDirection = Vector3.new(0, 0, 0)
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
            moveDirection = LocalPlayer.Character.Humanoid.MoveDirection
        end
        
        if moveDirection.Magnitude > 0 then
            local forwardVector = Camera.CFrame.LookVector
            local rightVector = Camera.CFrame.RightVector
            
            local camActiveCFrame = Camera.CFrame
            local forwardInput = moveDirection:Dot(Vector3.new(camActiveCFrame.LookVector.X, 0, camActiveCFrame.LookVector.Z).Unit)
            local sideInput = moveDirection:Dot(Vector3.new(camActiveCFrame.RightVector.X, 0, camActiveCFrame.RightVector.Z).Unit)
            
            local flyVector = (forwardVector * forwardInput) + (rightVector * sideInput)
            
            if flyVector.Magnitude > 0 then
                flyVector = flyVector.Unit
                CamCFrame = CFrame.new(CamCFrame.Position + (flyVector * (CamSpeed * 60 * dt)))
            end
        end
        
        Camera.CFrame = CFrame.new(CamCFrame.Position) * finalRotation
    end
end)
