-- [[ LOGIC HOẠT ĐỘNG ]]

-- Hàm khóa/mở di chuyển nhân vật
local function SetCharacterAnchor(anchor)
    local char = LocalPlayer.Character
    if char then
        local root = char:FindFirstChild("HumanoidRootPart")
        if root then
            root.Anchored = anchor
        end
    end
end

-- 1. Bật/Tắt Trạng thái Freecam (Đã tích hợp lại tính năng khóa nhân vật)
local function ToggleFreecam()
    CamActive = not CamActive
    if CamActive then
        StatusBtn.Text = "TRẠNG THÁI: BẬT"
        StatusBtn.BackgroundColor3 = Color3.fromRGB(16, 128, 55)
        
        SavedCameraType = Camera.CameraType
        SavedSubject = Camera.CameraSubject
        CamCFrame = Camera.CFrame
        
        local _, y, z = Camera.CFrame:ToOrientation()
        CameraRotationX = y
        CameraRotationY = z
        
        Camera.CameraType = Enum.CameraType.Scriptable
        SetCharacterAnchor(true)
    else
        StatusBtn.Text = "TRẠNG THÁI: TẮT"
        StatusBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        
        Camera.CameraType = SavedCameraType
        Camera.CameraSubject = SavedSubject
        SetCharacterAnchor(false)
    end
end

StatusBtn.MouseButton1Click:Connect(ToggleFreecam)

-- 2. Thay đổi tốc độ bay
local Speeds = {1, 2, 5, 10, 20, 0.5}
local currentSpeedIndex = 1
SpeedBtn.MouseButton1Click:Connect(function()
    currentSpeedIndex = currentSpeedIndex + 1
    if currentSpeedIndex > #Speeds then currentSpeedIndex = 1 end
    CamSpeed = Speeds[currentSpeedIndex]
    SpeedBtn.Text = "TỐC ĐỘ: " .. CamSpeed .. "x"
end)

-- 3. Thanh trượt FOV
FOVSlider.MouseButton1Click:Connect(function()
    local mousePos = UserInputService:GetMouseLocation()
    local relativeX = mousePos.X - FOVSlider.AbsolutePosition.X
    local percentage = math.clamp(relativeX / FOVSlider.AbsoluteSize.X, 0, 1)
    
    CamFOV = math.floor(30 + (percentage * 90))
    FOVProgress.Size = UDim2.new(percentage, 0, 1, 0)
    FOVLabel.Text = "FOV: " .. CamFOV
    Camera.FieldOfView = CamFOV
end)

-- 4. Tính năng Bật/Tắt hiển thị toàn bộ bảng UI chính thông qua nút T
local UIWishedVisible = true
