local function buildStatusBoard(items)
    if #items == 0 then return "No items in shop.\nClick Refresh to reload." end
    local lines = {}
    for _, item in ipairs(items) do
        local color = getRarityColor(item.Rarity)
        local emoji = getRarityEmoji(item.Rarity)
        local statusIcon = item.ForSale and "🟢 In Stock" or "🔴 Out of Stock"
        local line = string.format(
            '%s <font color="%s"><b>%s</b></font> [%s]\n     💰 %s  |  %s',
            emoji, color, item.Name,
            (item.Rarity ~= "" and item.Rarity or "?"),
            tostring(item.Price), statusIcon
        )
        table.insert(lines, line)
    end
    return table.concat(lines, "\n\n")
end

local function refreshItemList()
    local items = scanShopItems()
    currentScanDisplay = {}
    local displays = {}
    for _, item in ipairs(items) do
        table.insert(displays, item.Display)
        currentScanDisplay[item.Display] = item
    end
    if #displays == 0 then displays = { "(No items in shop)" } end
    if itemDropdown then
        pcall(function() itemDropdown:Refresh(displays) end)
    end
    pcall(function() statusBoard:SetDesc(buildStatusBoard(items)) end)
    WindUI:Notify({
        Title = "Item Shop",
        Content = "Found " .. #items .. " items",
        Duration = 3
    })
end

