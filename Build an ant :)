                    end
                end
            elseif selected then
                local name = tostring(selected)
                if name ~= "(No items in shop)" and name ~= "(Click Refresh to load)" then
                    selectedItems[name] = true
                    table.insert(list, name)
                end
            end
            local listStr = (#list > 0) and table.concat(list, "\n") or "No items selected"
            pcall(function() selectedParagraph:SetDesc(listStr) end)
        end
    })
end)

