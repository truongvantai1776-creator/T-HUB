-- ============================================
-- MONEY FORMAT
-- ============================================
local function formatMoney(n)
    n = tonumber(n) or 0
    if n >= 1e12 then
        local v = n / 1e12
        if v == math.floor(v) then return math.floor(v) .. "T" end
        return (string.format("%.2f", v):gsub("0+$", ""):gsub("%.$", "")) .. "T"
    elseif n >= 1e9 then
        local v = n / 1e9
        if v == math.floor(v) then return math.floor(v) .. "B" end
        return (string.format("%.2f", v):gsub("0+$", ""):gsub("%.$", "")) .. "B"
    elseif n >= 1e6 then
        local v = n / 1e6
        if v == math.floor(v) then return math.floor(v) .. "M" end
        return (string.format("%.2f", v):gsub("0+$", ""):gsub("%.$", "")) .. "M"
    elseif n >= 1e3 then
        local v = n / 1e3
        if v == math.floor(v) then return math.floor(v) .. "K" end
        return (string.format("%.2f", v):gsub("0+$", ""):gsub("%.$", "")) .. "K"
    else
        return tostring(math.floor(n))
    end
end

-- ============================================
-- RARITY COLORS
-- ============================================
local function getRarityColor(rarity)
    local r = string.lower(rarity or "")
    if r:find("common") then return "#C0C0C0"
    elseif r:find("uncommon") then return "#4ADE80"
    elseif r:find("rare") then return "#3B82F6"
    elseif r:find("epic") then return "#A855F7"
    elseif r:find("legendary") or r:find("legend") then return "#F59E0B"
    elseif r:find("mythic") then return "#EF4444"
    elseif r:find("godly") or r:find("divine") then return "#EC4899"
    elseif r:find("secret") then return "#FBBF24"
    else return "#FFFFFF"
    end
end

local function getRarityEmoji(rarity)
    local r = string.lower(rarity or "")
    if r:find("common") then return "⚪"
    elseif r:find("uncommon") then return "🟢"
    elseif r:find("rare") then return "🔵"
    elseif r:find("epic") then return "🟣"
    elseif r:find("legendary") or r:find("legend") then return "🟡"
    elseif r:find("mythic") then return "🔴"
    elseif r:find("godly") or r:find("divine") then return "💗"
    elseif r:find("secret") then return "⭐"
    else return "⚫"
    end
end

