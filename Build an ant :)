local function getPromptPos(prompt)
    if not prompt or not prompt.Parent then return nil end
    local pos = nil
    pcall(function()
        if prompt.Parent:IsA("BasePart") then
            pos = prompt.Parent.Position
        elseif prompt.Parent:IsA("Attachment") then
            pos = prompt.Parent.WorldPosition
        else
            for _, p in ipairs(prompt.Parent:GetDescendants()) do
                if p:IsA("BasePart") then
                    pos = p.Position; break
                end
            end
        end
    end)
    return pos
end

local function getPromptKey(prompt)
    if not prompt or not prompt.Parent then return nil end
    local pos = getPromptPos(prompt)
    if pos then
        return string.format("%s (%d,%d,%d)",
            prompt.Parent.Name,
            math.floor(pos.X / 5),
            math.floor(pos.Y / 5),
            math.floor(pos.Z / 5))
    end
    return prompt.Parent.Name
end

