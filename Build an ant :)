local function findEnterDungeonPrompt()
    local best = nil
    local bestScore = 0
    pcall(function()
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("ProximityPrompt") and obj.Enabled then
                local key = getPromptKey(obj)
                local isVisited = key and visitedDungeons[key]
                
                if not isVisited then
                    local at = string.lower(obj.ActionText or "")
                    local ot = string.lower(obj.ObjectText or "")
                    local pn = string.lower(obj.Parent.Name or "")
                    local score = 0
                    if at == "enter" then score = 100
                    elseif at:find("enter dungeon") then score = 90
                    elseif at:find("enter") then score = 80
                    elseif ot:find("enter") then score = 50
                    elseif pn:find("dungeon") or pn:find("enter") or pn:find("portal") then score = 40 end
                    if score > bestScore then bestScore = score; best = obj end
                end
            end
        end
    end)
    return best
end

