-- ============================================
-- AUTO ENTER DUNGEON
-- ============================================
task.spawn(function()
    while true do
        pcall(function()
            if autoEnterDungeonState then
                local now = os.clock()
                
                if wasInDungeon and not isInDungeon() then
                    print("[T HUB] Force reset wasInDungeon")
                    wasInDungeon = false
                end
                
                if wasInDungeon then
                    task.wait(1)
                else
                    local canEnter = false
                    if lastDungeonExitTime == 0 then
                        canEnter = true
                    elseif (now - lastDungeonExitTime) >= 2 then
                        canEnter = true
                    end
                    
                    if canEnter then
                        local prompt = findEnterDungeonPrompt()
                        if prompt and prompt.Parent then
                            local char = player.Character
                            local hrp = char and char:FindFirstChild("HumanoidRootPart")
                            
                            if hrp then
                                local targetPos = getPromptPos(prompt)
                                
                                if targetPos then
                                    hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 2, 0))
                                    task.wait(0.3)
                                    
                                    local posBeforeEnter = hrp.Position
                                    local promptName = prompt.Parent.Name
                                    if prompt.ObjectText and prompt.ObjectText ~= "" then
                                        promptName = prompt.ObjectText .. " / " .. prompt.Parent.Name
                                    end
                                    local promptKey = getPositionKey(targetPos)

                                    dungeonCheckStartPos = posBeforeEnter
                                    dungeonCheckKey = promptKey
                                    dungeonCheckPromptName = promptName
                                    dungeonCheckPending = true
                                    lastDungeonExitTime = 0

                                    print("[T HUB] Đã tele: " .. promptName .. " (" .. tostring(promptKey) .. ")")

                                    local entered = false
                                    for i = 1, 6 do
                                        if fireproximityprompt then
                                            pcall(function() fireproximityprompt(prompt) end)
                                        end
                                        task.wait(0.5)
                                        if not dungeonCheckPending then entered = true; break end
                                    end

                                    if not entered then
                                        dungeonCheckPending = false
                                        dungeonCheckStartPos = nil
                                        dungeonCheckKey = nil
                                        dungeonCheckPromptName = ""
    
                                        if promptKey then
                                            failCounts[promptKey] = (failCounts[promptKey] or 0) + 1
                                            print("[T HUB] ✗ Không vào được " .. promptKey .. " (lần " .. failCounts[promptKey] .. ")")
                                            if failCounts[promptKey] >= MAX_FAIL_ATTEMPTS then
                                                visitedPositions[promptKey] = true
                                                positionMissingTime[promptKey] = nil
                                                failCounts[promptKey] = nil
                                                print("[T HUB] → Tính là đã đi, chuyển cổng khác: " .. promptKey)
                                                WindUI:Notify({
                                                    Title = "⏭️ Bỏ qua cổng",
                                                    Content = "Không vào được " .. promptName .. " → qua cổng khác",
                                                    Duration = 3
                                                })
                                            end
                                        end
                                    end
                                end
                            end
                        else
                            task.wait(1)
                        end
                    end
                end
            else
                enterTeleported = false
            end
        end)
        task.wait(0.8)
    end
end)

