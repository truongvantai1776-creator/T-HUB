-- ============================================
-- MONEY FORMAT
-- ============================================
local function formatMoney(n)
    n = tonumber(n) or 0
    if n >= 1e12 then
        local v = n / 1e12
        if v == math.floor(v) then return math.floor(v) .. "T" end
        return (string.format("%.2f", v):gsub("0+$", ""):gsub("%.$", "")) .. "T"
    elseif n >= 1e9 then
        local v = n / 1e9
        if v == math.floor(v) then return math.floor(v) .. "B" end
        return (string.format("%.2f", v):gsub("0+$", ""):gsub("%.$", "")) .. "B"
    elseif n >= 1e6 then
        local v = n / 1e6
        if v == math.floor(v) then return math.floor(v) .. "M" end
        return (string.format("%.2f", v):gsub("0+$", ""):gsub("%.$", "")) .. "M"
    elseif n >= 1e3 then
        local v = n / 1e3
        if v == math.floor(v) then return math.floor(v) .. "K" end
        return (string.format("%.2f", v):gsub("0+$", ""):gsub("%.$", "")) .. "K"
    else
        return tostring(math.floor(n))
    end
end

local function parseMoneyStr(text)
    if not text then return 0 end
    text = tostring(text):gsub("%s", ""):gsub("%$", ""):gsub(",", ""):lower()
    local mult = 1
    if text:find("t") then mult = 1e12; text = text:gsub("t", "")
    elseif text:find("b") then mult = 1e9; text = text:gsub("b", "")
    elseif text:find("m") then mult = 1e6; text = text:gsub("m", "")
    elseif text:find("k") then mult = 1e3; text = text:gsub("k", "")
    end
    local num = tonumber(text)
    if num then return math.floor(num * mult) end
    return 0
end

local function getPlayerCash()
    local ls = player:FindFirstChild("leaderstats")
    if ls then
        for _, v in ipairs(ls:GetChildren()) do
            if v:IsA("IntValue") or v:IsA("NumberValue") or v:IsA("StringValue") then
                local n = string.lower(v.Name)
                if n:find("cash") or n:find("money") or n:find("coin") or n:find("$") then
                    return parseMoneyStr(v.Value)
                end
            end
        end
    end
    for _, attr in ipairs(player:GetAttributes()) do
        local n = string.lower(attr)
        if n:find("cash") or n:find("money") or n:find("coin") then
            return parseMoneyStr(player:GetAttribute(attr))
        end
    end
    local bestVal = 0
    for _, gui in ipairs(playerGui:GetDescendants()) do
        if gui:IsA("TextLabel") then
            local txt = gui.Text or ""
            if txt:find("%$") then
                local cleaned = txt:gsub("%s", ""):gsub("%$", "")
                if cleaned:match("%d") and (#cleaned <= 15) then
                    local val = parseMoneyStr(txt)
                    if val > bestVal then bestVal = val end
                end
            end
        end
    end
    return bestVal
end

