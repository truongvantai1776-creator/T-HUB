                        local key = dungeonCheckKey or getPositionKey(dungeonCheckStartPos)
                        if key then
                            visitedPositions[key] = true
                            positionMissingTime[key] = nil
                            failCounts[key] = nil
                            print("[T HUB] Đánh dấu đã đi: " .. key .. " (dist " .. math.floor(dist) .. ")")
                        end
                        visitedCount = visitedCount + 1
                        
                        print("[T HUB] ✓ Dungeon visited: " .. dungeonCheckPromptName .. " (#" .. visitedCount .. ")")
                        WindUI:Notify({
                            Title = "🏰 Đã vào dungeon",
                            Content = dungeonCheckPromptName .. " (#" .. visitedCount .. ")",
                            Duration = 3
                        })
                        dungeonCheckPending = false
                        dungeonCheckStartPos = nil
                        dungeonCheckKey = nil
                        dungeonCheckPromptName = ""
                    end
                end
            end
        end)
        task.wait(0.15)
    end
end)

