local function getGearShopFrame()
    for _, gui in ipairs(playerGui:GetDescendants()) do
        if gui.Name == "GearShopFrame" then return gui end
    end
    return nil
end

local function readItemInfo(folder)
    local displayName = folder.Name
    local price = "?"
    local rarity = ""
    local forSale = true
    pcall(function()
        local gearName = folder:FindFirstChild("GearName", true)
        if gearName then
            if gearName:IsA("TextLabel") then displayName = gearName.Text
            elseif gearName:IsA("StringValue") then displayName = gearName.Value end
        end
        local cost = folder:FindFirstChild("Cost", true)
        if cost then
            if cost:IsA("TextLabel") then price = cost.Text
            elseif cost:IsA("StringValue") then price = cost.Value
            elseif cost:IsA("IntValue") then price = formatMoney(cost.Value) end
        end
        local stats = folder:FindFirstChild("Stats", true)
        if stats then
            for _, s in ipairs(stats:GetDescendants()) do
                if s:IsA("TextLabel") and (s.Name:lower():find("rarity") or s.Name:lower():find("tier")) then
                    rarity = s.Text; break
                end
            end
        end
        local noStock = folder:FindFirstChild("NoStock", true)
        if noStock and noStock:IsA("GuiObject") and noStock.Visible then forSale = false end
        local buyBtn = folder:FindFirstChild("BuyBtn", true)
        if buyBtn then
            if buyBtn:IsA("GuiObject") and (not buyBtn.Visible or not buyBtn.Active) then forSale = false end
        end
    end)
    return displayName, price, rarity, forSale
end

local function scanShopItems()
    local items = {}
    pcall(function()
        local gearShop = getGearShopFrame()
        if not gearShop then return end
        local scrolling = nil
        for _, child in ipairs(gearShop:GetDescendants()) do
            if child:IsA("ScrollingFrame") then scrolling = child; break end
        end
        if not scrolling then return end
        for _, folder in ipairs(scrolling:GetChildren()) do
            if folder:IsA("GuiObject") or folder:IsA("Folder") then
                local displayName, price, rarity, forSale = readItemInfo(folder)
                local buyBtn = folder:FindFirstChild("BuyBtn", true)
                if buyBtn then
                    local rarityStr = (rarity ~= "") and (" [" .. rarity .. "]") or ""
                    local display = displayName .. rarityStr .. " - " .. tostring(price)
                    table.insert(items, {
                        Name = displayName, Display = display, Price = price,
                        PriceNum = parseMoneyStr(price), Rarity = rarity,
                        ForSale = forSale, Folder = folder, BuyBtn = buyBtn,
                    })
                end
            end
        end
    end)
    return items
end

