                    local buyPlace, buyPrompt = getMatchedBuyTarget()
                    if buyPlace and buyPrompt then
                        isBuying = true
                        plotStatusLabel.Text = "Status: 🛒 Đang bay tới MUA..."
                        
                        local dist = (hrp.Position - buyPlace.Position).Magnitude
                        local dur = math.max(dist / 70, 0.1)
                        
                        local targetCFrame = buyPlace.CFrame + Vector3.new(0, 3, 0)
                        local tween = TweenService:Create(hrp, TweenInfo.new(dur, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
                        tween:Play()
                        tween.Completed:Wait()

                        keepCharacterUpright()

                        plotStatusLabel.Text = "Status: 🛒 Đang mua..."
                        local buyTimeout = 0
                        while buyTimeout < 3.0 and _G.AutoBuyActive do
                            local currentBuyPlace, currentBuyPrompt = getMatchedBuyTarget()
                            if not currentBuyPlace or not currentBuyPrompt then
                                break
                            end
                            keepCharacterUpright()
                            pcall(function() fireproximityprompt(currentBuyPrompt) end)
                            task.wait(0.15)
                            buyTimeout = buyTimeout + 0.15
                        end

                        plotStatusLabel.Text = "Status: ✅ Đã mua xong! Nghỉ 1s..."
                        task.wait(1.0)
                        keepCharacterUpright()
                        isBuying = false
                        return
                    end
                end

                -- 2. XỬ LÝ ROLL HÀNG (KHI AUTO ROLL BẬT)
                isBuying = false
                if _G.AutoRollActive and myAssignedPlot then
                    local leverParts = {}
                    for _, obj in ipairs(myAssignedPlot:GetDescendants()) do
                        if obj.Name == "Lever" and obj:IsA("Model") then
                            local leverBottom = obj:FindFirstChild("LeverBottom") or obj.PrimaryPart
                            if leverBottom and leverBottom:IsA("BasePart") then
                                table.insert(leverParts, leverBottom)
                            end
                        end
                    end
                    
                    if #leverParts > 0 then
                        if not hasDiedOnce and humanoid then
                            pcall(function() humanoid.Health = 0 end)
                            hasDiedOnce = true
                            plotStatusLabel.Text = "Status: Đang reset vào plot..."
                            LocalPlayer.CharacterAdded:Wait()
                            task.wait(1)
                            return
                        end

                        if hrp and humanoid and humanoid.Health > 0 then
                            for _, targetPart in ipairs(leverParts) do
                                if not _G.AutoRollActive then break end
                                
                                if _G.AutoBuyActive then
                                    local checkBuyPlace, _ = getMatchedBuyTarget()
                                    if checkBuyPlace then break end
                                end
                                
                                char = LocalPlayer.Character
                                hrp = char and char:FindFirstChild("HumanoidRootPart")
                                humanoid = char and char:FindFirstChildOfClass("Humanoid")
                                
                                if hrp and humanoid and humanoid.Health > 0 then
                                    local distance = (hrp.Position - targetPart.Position).Magnitude
                                    local duration = math.max(distance / 60, 0.1)
                                    local targetCFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
                                    
                                    local tween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
                                    tween:Play()
                                    
                                    local interruptedByBuy = false
                                    while tween.PlaybackState == Enum.PlaybackState.Playing do
                                        task.wait(0.05)
                                        if _G.AutoBuyActive and getMatchedBuyTarget() then
                                            tween:Cancel()
                                            interruptedByBuy = true
                                            break
                                        end
                                        if not _G.AutoRollActive then
                                            tween:Cancel()
                                            break
                                        end
                                    end
                                    
                                    keepCharacterUpright()

                                    if interruptedByBuy then
                                        break
                                    end
                                    
                                    -- Kích hoạt nút Roll
                                    plotStatusLabel.Text = "Status: 🎲 Đang nhấn nút Roll"
                                    for _, obj in ipairs(myAssignedPlot:GetDescendants()) do
                                        if isRollPrompt(obj) then
                                            pcall(function() fireproximityprompt(obj) end)
                                        end
                                    end

                                    plotStatusLabel.Text = "Status: ⏳ Đợi hiện độ hiếm..."
                                    local waitTime = 0
                                    while waitTime < 3.0 and _G.AutoRollActive do
                                        keepCharacterUpright()
                                        if _G.AutoBuyActive and getMatchedBuyTarget() then break end

                                        local hasWeaponRarity, hasBlockRarity = false, false
                                        for _, obj in ipairs(myAssignedPlot:GetDescendants()) do
                                            if obj.Name == "RollWeapons" then
                                                local _, _, rarity, _, _ = parseInfoFolder(obj:FindFirstChild("Info"))
                                                if rarity and rarity ~= "---" then hasWeaponRarity = true end
                                            elseif obj.Name == "RollBlocks" then
                                                local _, _, rarity, _, _ = parseInfoFolder(obj:FindFirstChild("Info"))
                                                if rarity and rarity ~= "---" then hasBlockRarity = true end
                                            end
                                        end
                                        
                                        if hasWeaponRarity and hasBlockRarity then break end
                                        task.wait(0.1)
                                        waitTime = waitTime + 0.1
                                    end
                                    
                                    if _G.AutoBuyActive and getMatchedBuyTarget() then
                                        keepCharacterUpright()
                                        break
                                    end

                                    task.wait(1.0)
                                end
                            end
                        end
                    end
                end
            end)
        else
            plotStatusLabel.Text = "Status: Đã tắt"
            task.wait(0.5)
        end
    end
end)

