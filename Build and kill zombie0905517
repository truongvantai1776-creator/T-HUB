                    end
                end)
                
                task.spawn(function()
                    bossCooldownText = "Đang chờ Boss xuất hiện (60s)"
                    for i = 60, 1, -1 do
                        if not _G.AutoBossActive then break end
                        bossCooldownText = string.format("Đang chờ Boss xuất hiện (%ds)", i)
                        task.wait(1)
                    end
                    
                    bossCooldownText = "Đang kiểm tra Boss..."
                    while GetZeusBossTarget() ~= nil and _G.AutoBossActive do
                        task.wait(3)
                    end
                    
                    bossCooldownText = "Đợi hồi chiêu thêm (15s)"
                    for i = 15, 1, -1 do
                        if not _G.AutoBossActive then break end
                        bossCooldownText = string.format("Đợi hồi chiêu thêm (%ds)", i)
                        task.wait(1)
                    end
                    
                    if _G.AutoBossActive then
                        -- Khôi phục Auto Farm
                        if farmWasActiveBeforeBoss then
                            _G.AutoFarmActive = true
                            _G.LockedLookVector = nil
                            local updatedFarmBtnUI = mainFrame:FindFirstChild("ToggleBtn")
                            if updatedFarmBtnUI then
                                updatedFarmBtnUI.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
                                updatedFarmBtnUI.Text = "Auto Farm: ON"
                            end
                        end

                        -- Khôi phục Auto Roll & Buy
                        if rollBuyWasActiveBeforeBoss then
                            _G.AutoRollActive = true
                            _G.AutoBuyActive = true
                            local updatedRollBuyBtnUI = mainFrame:FindFirstChild("ToggleRollBuyBtn")
                            if updatedRollBuyBtnUI then
                                updatedRollBuyBtnUI.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
                                updatedRollBuyBtnUI.Text = "Auto Roll & Buy: ON"
                            end
                            rollWasActiveBeforeDeath = true
                            pcall(function()
                                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
                                    LocalPlayer.Character:FindFirstChildOfClass("Humanoid").Health = 0
                                end
                            end)
                        end
                    end
                    bossCooldownText = "Sẵn sàng"
                    isHandlingAction = false
                end)
            end
            
            if bossPart and bossPart.Parent then
                local currentRoot, moveModel = GetRootPartToMove()
                if currentRoot then
                    circleAngle = circleAngle + 0.15 
                    local radius = 25 
                    local offsetX = math.cos(circleAngle) * radius
                    local offsetZ = math.sin(circleAngle) * radius
                    
                    local bossPos = bossPart.Position
                    local desiredPos = bossPos + Vector3.new(offsetX, 4, offsetZ)
                    
                    local distance = (desiredPos - currentRoot.Position).Magnitude
                    if distance > 2 then
                        local speed = 40 
                        local timeTaken = math.clamp(distance / speed, 0.05, 0.3)
                        local tweenInfo = TweenInfo.new(timeTaken, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
                        local tween
                        
                        if moveModel:IsA("Model") and moveModel.PrimaryPart then
                            tween = TweenService:Create(moveModel.PrimaryPart, tweenInfo, {CFrame = CFrame.new(desiredPos, bossPos)})
                        else
                            tween = TweenService:Create(currentRoot, tweenInfo, {CFrame = CFrame.new(desiredPos, bossPos)})
                        end
                        tween:Play()
                    end
                end
            end
            
            -- CẬP NHẬT CHUỖI TRẠNG THÁI HIỂN THỊ TRÊN STATUSLABEL
            local statusParts = {}
            
            if _G.AutoFarmActive then
                if _G.InfiniteFlyActive then
                    table.insert(statusParts, "Farm: Infinite(∞)")
                else
                    table.insert(statusParts, "Farm: " .. tostring(_G.SelectedAutoFarmTarget))
                end
            else
                table.insert(statusParts, "Farm: OFF")
            end
            
            if _G.AutoRollActive or _G.AutoBuyActive then
                table.insert(statusParts, "Roll & Buy: ON")
            else
                table.insert(statusParts, "Roll & Buy: OFF")
            end
            
            if _G.EspMobsActive then
                table.insert(statusParts, "ESP: ON")
            else
                table.insert(statusParts, "ESP: OFF")
            end
            
            if _G.AutoBossActive then
                if bossPart then
                    table.insert(statusParts, "Boss: Đang đánh")
                else
                    table.insert(statusParts, "Boss: " .. bossCooldownText)
                end
            else
                table.insert(statusParts, "Boss: OFF")
            end
            
            if _G.AntiAfkActive then
                table.insert(statusParts, "Anti-AFK: ON")
            else
                table.insert(statusParts, "Anti-AFK: OFF")
            end
            
            statusLabel.Text = " Trạng thái hoạt động:\n " .. table.concat(statusParts, " | ")
        end)
        task.wait(0.1)
    end
end)

-- ==========================================
-- AUTO FARM MAIN LOOP (BASIC & INFINITE MODE)
-- ==========================================
task.spawn(function()
    while true do
        if _G.AutoFarmActive then
            local character = LocalPlayer.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            
            local isInVehicle = humanoid and humanoid.SeatPart ~= nil
            
            if not isInVehicle then
                pcall(function()
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
                    task.wait(0.05)
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
                end)
                task.wait(0.2)
            else
                local currentRoot, moveModel = GetRootPartToMove()
                
                if currentRoot then
                    if _G.InfiniteFlyActive then
                        pcall(function()
                            local raycastParams = RaycastParams.new()
                            raycastParams.FilterType = Enum.RaycastFilterType.Exclude
                            raycastParams.FilterDescendantsInstances = {LocalPlayer.Character, moveModel}
                            
                            if not _G.LockedLookVector then
                                local lookVector = currentRoot.CFrame.LookVector
                                local fixedVector = Vector3.new(lookVector.X, 0, lookVector.Z)
                                if fixedVector.Magnitude > 0 then
                                    _G.LockedLookVector = fixedVector.Unit
                                else
                                    _G.LockedLookVector = Vector3.new(0, 0, -1)
                                end
                            end
                            local fixedLookVector = _G.LockedLookVector
                            
                            local travelDistance = 500 
                            local flySpeed = _G.InfiniteFlySpeed 
                            local totalTime = travelDistance / flySpeed 
                            
                            local startTime = tick()
                            local startPos = currentRoot.Position
                            
                            local connection
                            connection = RunService.RenderStepped:Connect(function()
                                if not _G.AutoFarmActive or not _G.InfiniteFlyActive then
                                    if connection then connection:Disconnect() end
                                    return
                                end
                                
                                if moveModel and moveModel:IsA("Model") then
                                    for _, part in pairs(moveModel:GetDescendants()) do
                                        if part:IsA("BasePart") then
                                            part.CanCollide = false
                                            part.AssemblyLinearVelocity = Vector3.zero
                                            part.AssemblyAngularVelocity = Vector3.zero
                                        end
                                    end
                                end
                                if LocalPlayer.Character then
                                    for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
                                        if part:IsA("BasePart") then
                                            part.CanCollide = false
                                            part.AssemblyLinearVelocity = Vector3.zero
                                            part.AssemblyAngularVelocity = Vector3.zero
                                        end
                                    end
                                end
                                
                                local elapsed = tick() - startTime
                                local alpha = math.clamp(elapsed / totalTime, 0, 1)
                                local currentTravelPos = startPos + (fixedLookVector * travelDistance * alpha)
                                
                                local groundRay = workspace:Raycast(currentTravelPos + Vector3.new(0, 50, 0), Vector3.new(0, -100, 0), raycastParams)
                                local groundY = groundRay and (groundRay.Position.Y + 3) or currentTravelPos.Y
                                
                                local finalPos = Vector3.new(currentTravelPos.X, groundY, currentTravelPos.Z)
                                local finalCFrame = CFrame.lookAt(finalPos, finalPos + fixedLookVector)
                                
                                if moveModel:IsA("Model") then
                                    moveModel:PivotTo(finalCFrame)
                                else
                                    currentRoot.CFrame = finalCFrame
                                end
                                
                                if alpha >= 1 then
                                    if connection then connection:Disconnect() end
                                end
                            end)
                            
                            task.wait(totalTime)
                            if connection then connection:Disconnect() end
                        end)
                    else
                        local targetPart = GetSelectedAutoFarmTargetPart()
                        if targetPart then
                            pcall(function()
                                local targetPos = targetPart.Position
                                local raycastParams = RaycastParams.new()
                                raycastParams.FilterType = Enum.RaycastFilterType.Exclude
                                raycastParams.FilterDescendantsInstances = {LocalPlayer.Character, moveModel}
                                
                                local groundRay = workspace:Raycast(targetPos + Vector3.new(0, 50, 0), Vector3.new(0, -100, 0), raycastParams)
                                if groundRay then
                                    targetPos = groundRay.Position + Vector3.new(0, 3, 0)
                                else
                                    targetPos = targetPos + Vector3.new(0, 3, 0)
                                end

                                local distance = (targetPos - currentRoot.Position).Magnitude
                                local speed = _G.BasicFarmSpeed 
                                local timeTaken = math.clamp(distance / speed, 0.1, 5)

                                local tweenInfo = TweenInfo.new(timeTaken, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
                                local tween

                                if moveModel:IsA("Model") and moveModel.PrimaryPart then
                                    tween = TweenService:Create(moveModel.PrimaryPart, tweenInfo, {CFrame = CFrame.new(targetPos)})
                                else
                                    tween = TweenService:Create(currentRoot, tweenInfo, {CFrame = CFrame.new(targetPos)})
                                end

                                tween:Play()
                                
                                local wTask = task.spawn(function()
                                    while tween.PlaybackState == Enum.PlaybackState.Playing and _G.AutoFarmActive do
                                        pcall(function()
                                            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.W, false, game)
                                            task.wait(0.02)
                                            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.W, false, game)
                                            task.wait(0.02)
                                        end)
                                    end
                                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.W, false, game)
                                end)

                                tween.Completed:Wait()
                                pcall(function() task.cancel(wTask) end)
                                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.W, false, game)
                                task.wait(0.2)
                            end)
                        else
                            task.wait(0.5)
                        end
                    end
                end
            end
        else
            task.wait(0.1)
        end
        task.wait(0.001)
    end
end)
