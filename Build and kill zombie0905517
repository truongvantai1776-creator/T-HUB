local function createRarityBtn(rarityName, order)
    local btn = Instance.new("TextButton")
    btn.Name = rarityName .. "Btn"
    btn.Size = UDim2.new(0, 96, 0, 24)
    btn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
    btn.Text = rarityName .. ": OFF"
    btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    btn.TextSize = 10
    btn.Font = Enum.Font.SourceSansBold
    btn.LayoutOrder = order
    btn.AutoButtonColor = false
    btn.Parent = rarityGrid

    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)

    btn.MouseButton1Click:Connect(function()
        _G.SelectedRarities[rarityName] = not _G.SelectedRarities[rarityName]
        local state = _G.SelectedRarities[rarityName]
        btn.Text = rarityName .. (state and ": ON" or ": OFF")
        btn.TextColor3 = state and Color3.fromRGB(50, 255, 100) or Color3.fromRGB(200, 200, 200)
        btn.BackgroundColor3 = state and Color3.fromRGB(30, 80, 40) or Color3.fromRGB(50, 50, 60)
    end)
end

