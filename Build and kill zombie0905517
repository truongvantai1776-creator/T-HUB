end)

local bossCooldownText = "Sẵn sàng"
local isHandlingAction = false
local farmWasActiveBeforeBoss = false
local rollBuyWasActiveBeforeBoss = false

task.spawn(function()
    local circleAngle = 0
    
    while true do
        pcall(function()
            local visibleButton = CheckBattleButtonVisible()
            local bossPart = GetZeusBossTarget()
            
            if _G.AutoBossActive and visibleButton and not isHandlingAction then
                isHandlingAction = true
                
                -- Tạm ngưng Auto Farm nếu đang bật
                if _G.AutoFarmActive then
                    farmWasActiveBeforeBoss = true
                    _G.AutoFarmActive = false
                    _G.LockedLookVector = nil
                    local farmBtnUI = mainFrame:FindFirstChild("ToggleBtn")
                    if farmBtnUI then
                        farmBtnUI.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
                        farmBtnUI.Text = "Auto Farm: OFF"
                    end
                else
                    farmWasActiveBeforeBoss = false
                end

                -- Tạm ngưng Auto Roll & Auto Buy nếu đang bật
                if _G.AutoRollActive or _G.AutoBuyActive then
                    rollBuyWasActiveBeforeBoss = true
                    _G.AutoRollActive = false
                    _G.AutoBuyActive = false
                    local rollBuyBtnUI = mainFrame:FindFirstChild("ToggleRollBuyBtn")
                    if rollBuyBtnUI then
                        rollBuyBtnUI.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
                        rollBuyBtnUI.Text = "Auto Roll & Buy: OFF"
                    end
