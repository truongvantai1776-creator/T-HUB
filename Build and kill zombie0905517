local function keepCharacterUpright()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    end
    if humanoid then
        humanoid.PlatformStand = false
        humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
end

local function getSafeText(obj)
    if not obj then return nil end
    if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
        if obj.Text and obj.Text ~= "" then return obj.Text end
        if obj.ContentText and obj.ContentText ~= "" then return obj.ContentText end
    end
    if obj:IsA("StringValue") or obj:IsA("IntValue") then
        return tostring(obj.Value)
    end
    return nil
end

local function getRarityColorFromName(rarityText)
    local text = string.lower(tostring(rarityText)):gsub("^%s*(.-)%s*$", "%1")
    if text == "secret" then return Color3.fromRGB(255, 215, 0)
    elseif text == "divine" then return Color3.fromRGB(0, 255, 255)
    elseif text == "mythical" then return Color3.fromRGB(255, 50, 50)
    elseif text == "legendary" then return Color3.fromRGB(255, 140, 0)
    elseif text == "epic" then return Color3.fromRGB(170, 0, 255)
    elseif text == "rare" then return Color3.fromRGB(0, 120, 255)
    elseif text == "uncommon" then return Color3.fromRGB(50, 205, 50)
    elseif text == "common" then return Color3.fromRGB(180, 180, 180)
    else return Color3.fromRGB(255, 255, 255) end
end

local function parseInfoFolder(infoFolder)
    if not infoFolder then return "---", "---", "---", "---", Color3.fromRGB(180, 180, 180) end
    local name = getSafeText(infoFolder:FindFirstChild("ItemName")) or "---"
    local chance = getSafeText(infoFolder:FindFirstChild("Chance")) or "---"
    local rarity = getSafeText(infoFolder:FindFirstChild("Rarity")) or "---"
    local priceFolder = infoFolder:FindFirstChild("Price")
    local price = priceFolder and getSafeText(priceFolder:FindFirstChild("Text")) or "---"
    return name, chance, rarity, price, getRarityColorFromName(rarity)
end

local function isRollPrompt(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") then return false end
    local actionText = string.lower(prompt.ActionText or "")
    local objectText = string.lower(prompt.ObjectText or "")
    local parentName = string.lower(prompt.Parent and prompt.Parent.Name or "")
    
    if string.find(actionText, "select") or string.find(objectText, "select") or string.find(parentName, "select") then
        return false
    end
    if string.find(actionText, "roll") or string.find(objectText, "roll") or string.find(parentName, "roll") then
        return true
    end
    return false
end

local function isBuyPrompt(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") then return false end
    local actionText = string.lower(prompt.ActionText or "")
    local objectText = string.lower(prompt.ObjectText or "")
    local parentName = string.lower(prompt.Parent and prompt.Parent.Name or "")
    
    if string.find(actionText, "select") or string.find(objectText, "select") or string.find(parentName, "select") then
        return false
    end
    if string.find(actionText, "buy") or string.find(objectText, "buy") or string.find(parentName, "buy") then
        return true
    end
    if not isRollPrompt(prompt) then
        return true
    end
    return false
end

local function getMatchedBuyTarget()
    if not myAssignedPlot or not _G.AutoBuyActive then return nil, nil end
    
    local anyRarityActive = false
    for _, isActive in pairs(_G.SelectedRarities) do
        if isActive then
            anyRarityActive = true
            break
        end
    end
    if not anyRarityActive then return nil, nil end

    for _, categoryFolder in ipairs(myAssignedPlot:GetDescendants()) do
        if categoryFolder.Name == "RollBlocks" or categoryFolder.Name == "RollWeapons" then
            local infoFolder = categoryFolder:FindFirstChild("Info")
            if infoFolder then
                local _, _, rarity, _, _ = parseInfoFolder(infoFolder)
                local rarityClean = string.lower(tostring(rarity)):gsub("^%s*(.-)%s*$", "%1")
                
                local shouldBuy = false
                for rName, isActive in pairs(_G.SelectedRarities) do
                    if isActive and rarityClean == string.lower(rName) then
                        shouldBuy = true
                        break
                    end
                end
                
                if shouldBuy then
                    local itemPlace = categoryFolder:FindFirstChild("ItemPlace")
                    local prompt = nil
                    for _, sub in ipairs(categoryFolder:GetDescendants()) do
                        if sub:IsA("ProximityPrompt") and isBuyPrompt(sub) then
                            prompt = sub
                            break
                        end
                    end
                    
                    if itemPlace and prompt then
                        return itemPlace, prompt
                    end
                end
            end
        end
    end
    return nil, nil
end

