-- Kéo thả StatusLabel
local sDragging, sDragInput, sDragStart, sStartPos
statusLabel.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        sDragging = true
        sDragStart = input.Position
        sStartPos = statusLabel.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                sDragging = false
            end
        end)
    end
end)

statusLabel.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        sDragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == sDragInput and sDragging then
        local delta = input.Position - sDragStart
        statusLabel.Position = UDim2.new(
            sStartPos.X.Scale, 
            sStartPos.X.Offset + delta.X, 
            sStartPos.Y.Scale, 
            sStartPos.Y.Offset + delta.Y
        )
    end
end)

