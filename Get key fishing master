-- HÀM LOAD SCRIPT CHÍNH VÀ CHẠY ĐỒNG HỒ ĐẾM NGƯỢC
local function startMainScript(expireTime)
    if colorConn then colorConn:Disconnect() end
    screenGui:Destroy()
    
    local reuseGui = playerGui:FindFirstChild("THUB_ReuseKey_UI")
    if reuseGui then reuseGui:Destroy() end

    expiryGui.Enabled = true
    task.spawn(function()
        while expiryGui and expiryGui.Parent do
            local timeLeft = expireTime - os.time()
            if timeLeft > 0 then
                local hours = math.floor(timeLeft / 3600)
                local minutes = math.floor((timeLeft % 3600) / 60)
                local seconds = timeLeft % 60
                timerLabel.Text = string.format("Key Expires: %02d:%02d:%02d", hours, minutes, seconds)
            else
                timerLabel.Text = "Key Expired!"
                timerLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
                
                -- Chỉ xóa đúng file cache chứa key đã hết hạn này
                pcall(function()
                    if delfile and isfile and isfile(CACHE_FILE_NAME) then
                        delfile(CACHE_FILE_NAME)
                    end
                end)
                
                break
            end
            task.wait(1)
        end
    end)

    local loadSuccess, loadError = pcall(function()
        loadstring(game:HttpGet(MAIN_SCRIPT_URL))()
    end)

    if not loadError and loadSuccess then
        print("T-HUB Fishing Master loaded successfully!")
    else
        warn("Lỗi load script chính: ", loadError)
    end
end

