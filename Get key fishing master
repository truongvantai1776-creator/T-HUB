-- Chức năng Xác Thực Key mới
submitBtn.MouseButton1Click:Connect(function()
    local inputKey = (textBox.Text or ""):gsub("%s+", "")
    
    if inputKey == "" then
        statusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
        statusLabel.Text = "Vui long khong de trong key!"
        return
    end

    statusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
    statusLabel.Text = "Dang ket noi phan tich Cloud..."

    local success, response = pcall(function()
        local rawData = game:HttpGet(NPOINT_URL)
        return HttpService:JSONDecode(rawData)
    end)

    if not success or not response then
        statusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
        statusLabel.Text = "Loi ket noi may chu Cloud!"
        return
    end

    local keyList = response.keys or {}
    local currentTime = os.time()
    local foundIndex = nil
    local expireTime = 0
    local isExpired = false

    for i, keyData in ipairs(keyList) do
        local cloudKey = tostring(keyData.key or ""):gsub("%s+", "")
        if cloudKey == inputKey then
            foundIndex = i
            expireTime = tonumber(keyData.expireTimestamp) or 0
            if currentTime > expireTime then
                isExpired = true
            end
            break
        end
    end

    if isExpired then
        statusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
        statusLabel.Text = "Key nay da het han su dung!"
        return
    end

    if not foundIndex then
        statusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
        statusLabel.Text = "Key khong ton tai hoac da bi dung!"
        return
    end

    -- Xóa key trên npoint (Dùng 1 lần)
    statusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
    statusLabel.Text = "Dang khoa key..."

    table.remove(keyList, foundIndex)
    response.keys = keyList

    pcall(function()
        game:HttpPost(NPOINT_URL, HttpService:JSONEncode(response), false, "application/json")
    end)

    -- Lưu cache key mới vào máy người chơi
    pcall(function()
        if writefile then
            local cacheData = {
                key = inputKey,
                expireTimestamp = expireTime
            }
            writefile(CACHE_FILE_NAME, HttpService:JSONEncode(cacheData))
        end
    end)

    statusLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
    statusLabel.Text = "Xac thuc thanh cong! Dang tai script..."
    task.wait(0.8)
    
    startMainScript(expireTime)
end)
