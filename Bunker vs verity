end)

-- ==================== TAB DUY NHẤT ====================
local MainTab = Window:Tab({
    Title = "Auto Farm",
    Icon = "crosshair",
})

local function getBackpackItems()
    local items = {}
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        for _, child in pairs(backpack:GetChildren()) do
            if child:IsA("Tool") then
                if not EXCLUDED_ITEMS[child.Name] then
                    table.insert(items, child.Name)
                end
            end
        end
    end
    if #items == 0 then
        table.insert(items, "Không có item")
    end
    return items
end

local function isDifferent(list1, list2)
    if #list1 ~= #list2 then return true end
    for i = 1, #list1 do
        if list1[i] ~= list2[i] then return true end
    end
    return false
end

-- 1. Auto Use Item
itemToggle = MainTab:Toggle({
    Title = "Auto Use Item",
    Default = false,
    Callback = function(state)
        autoUseItemEnabled = state
        WindUI:Notify({ Title = "Auto Use Item", Content = state and "BẬT" or "TẮT", Duration = 2 })

        -- Nếu tắt Auto Use Item mà Auto Farm đang bật → tự tắt Auto Farm
        if not state and autoFarmEnabled then
            autoFarmEnabled = false
            if farmToggle then
                pcall(function() farmToggle:Set(false) end)
            end
            targetEnemy = nil
            lastValidPos = nil
            resetCharacterState()
            Camera.CameraType = Enum.CameraType.Custom
            WindUI:Notify({ Title = "Auto Farm", Content = "Đã tắt vì Auto Use Item bị tắt", Duration = 3 })
        end
    end
})

-- 2. Ô chọn Item
itemDropdown = MainTab:Dropdown({
    Title = "Chọn Item để dùng",
    Values = getBackpackItems(),
    Value = nil,
    Callback = function(option)
        selectedItemName = option
    end
})

-- 3. Auto Farm (yêu cầu Auto Use Item phải bật + đã chọn item)
farmToggle = MainTab:Toggle({
    Title = "Auto Farm",
    Default = false,
    Callback = function(state)
        -- Kiểm tra điều kiện khi bật
        if state then
            if not autoUseItemEnabled then
                WindUI:Notify({ Title = "Auto Farm", Content = "Phải BẬT Auto Use Item trước!", Duration = 3 })
                if farmToggle then
                    pcall(function() farmToggle:Set(false) end)
                end
                return
            end

            if selectedItemName == "" then
                WindUI:Notify({ Title = "Auto Farm", Content = "Phải CHỌN Item trước!", Duration = 3 })
                if farmToggle then
                    pcall(function() farmToggle:Set(false) end)
                end
                return
            end
        end

        autoFarmEnabled = state
        local char = LocalPlayer.Character

        if state then
            resetCharacterState()
            targetEnemy = nil
            lastValidPos = nil

            if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
                char.Humanoid.PlatformStand = true
                char.Humanoid.AutoRotate = false
                char.Humanoid:ChangeState(Enum.HumanoidStateType.Physics)
                lastValidPos = char.HumanoidRootPart.CFrame + Vector3.new(0, FLY_HEIGHT, 0)
            end
            WindUI:Notify({ Title = "Auto Farm", Content = "Đã BẬT", Duration = 2 })
        else
            targetEnemy = nil
            lastValidPos = nil
            resetCharacterState()
            Camera.CameraType = Enum.CameraType.Custom
            WindUI:Notify({ Title = "Auto Farm", Content = "Đã TẮT", Duration = 2 })
        end
    end
})

