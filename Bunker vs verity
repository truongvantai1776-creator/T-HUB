-- ==================== HÀM CHECK PLOT ====================
local function cleanStr(s)
    if not s then return "" end
    s = string.lower(s)
    s = s:gsub("%s+", ""):gsub("'", ""):gsub("’", ""):gsub("_", "")
    return s
end

local function findAllPlots()
    local plots = {}
    local function scan(folder)
        for _, obj in pairs(folder:GetChildren()) do
            if obj.Name:match("^Plot%d+$") then
                table.insert(plots, obj)
            end
            if obj:IsA("Folder") or obj:IsA("Model") then
                scan(obj)
            end
        end
    end
    scan(workspace)
    return plots
end

local function checkPlotByPosition()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local myPos = char.HumanoidRootPart.Position

    for _, plot in ipairs(findAllPlots()) do
        local boundary = plot:FindFirstChild("BedrockBoundary")
        if boundary and boundary:IsA("BasePart") then
            local dx = math.abs(myPos.X - boundary.Position.X)
            local dz = math.abs(myPos.Z - boundary.Position.Z)
            if dx <= (boundary.Size.X / 2) + 15 and dz <= (boundary.Size.Z / 2) + 15 then
                return plot
            end
        end
        -- Fallback dùng GetBoundingBox
        local success, cf, size = pcall(function() return plot:GetBoundingBox() end)
        if success and size.X > 20 then
            local rel = cf:PointToObjectSpace(myPos)
            if math.abs(rel.X) <= (size.X / 2) + 15 and math.abs(rel.Z) <= (size.Z / 2) + 15 then
                return plot
            end
        end
    end
    return nil
end

local function checkPlotByName()
    local myName = cleanStr(LocalPlayer.Name)
    local myDisplay = cleanStr(LocalPlayer.DisplayName)
    for _, plot in ipairs(findAllPlots()) do
        for _, v in ipairs(plot:GetDescendants()) do
            if v:IsA("TextLabel") or v:IsA("TextButton") or v:IsA("TextBox") then
                local txt = cleanStr(v.Text)
                local part = string.match(txt, "^(.-)sbunker")
                if part and (part == myName or part == myDisplay) then
                    return plot
                end
            end
        end
    end
    return nil
end

local function checkMyPlot()
    local byPos = checkPlotByPosition()
    if byPos then return byPos end
    return checkPlotByName()
end

-- ==================== HÀM TÌM QUÁI (THEO TỌA ĐỘ PLOT) ====================
local function isEnemy(model)
    if not model:IsA("Model") then return false end
    if model == LocalPlayer.Character then return false end
    if not model:FindFirstChild("Humanoid") or not model:FindFirstChild("HumanoidRootPart") then return false end
    if model.Humanoid.Health <= 0 then return false end
    if Players:GetPlayerFromCharacter(model) then return false end
    return true
end

local function getAllEnemies()
    local list = {}
    if not myPlot then return list end

    -- Lấy tâm và kích thước của Plot
    local center, size
    local boundary = myPlot:FindFirstChild("BedrockBoundary")
    if boundary and boundary:IsA("BasePart") then
        center = boundary.Position
        size = boundary.Size
    else
        local success, cf, sz = pcall(function() return myPlot:GetBoundingBox() end)
        if success then
            center = cf.Position
            size = sz
        else
            return list
        end
    end

    -- Quét toàn bộ Workspace để tìm quái
    local function scanFolder(folder)
        for _, obj in pairs(folder:GetChildren()) do
            if isEnemy(obj) then
                local ePos = obj.HumanoidRootPart.Position
                local dx = math.abs(ePos.X - center.X)
                local dz = math.abs(ePos.Z - center.Z)
                
                -- Nếu quái nằm trong phạm vi của Plot (+ 15 studs buffer)
                if dx <= (size.X / 2) + 15 and dz <= (size.Z / 2) + 15 then
                    table.insert(list, obj)
                end
            end
            if obj:IsA("Folder") or obj:IsA("Model") then
                -- Không quét vào người chơi để tránh lag
                if not Players:GetPlayerFromCharacter(obj) then
                    scanFolder(obj)
                end
            end
        end
    end
    scanFolder(workspace)
    return list
end

local function getClosestEnemy()
    local list = getAllEnemies()
    local closest = nil
    local minDist = math.huge
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local myPos = char.HumanoidRootPart.Position
    for _, enemy in pairs(list) do
        local enemyPos = enemy.HumanoidRootPart.Position
        local dist = (myPos - enemyPos).Magnitude
        if dist < minDist then
            minDist = dist
            closest = enemy
        end
    end
    return closest
end

-- ==================== AUTO FIRE ====================
local function autoFire()
    if not autoFireEnabled then return end
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
end

-- ==================== AUTO START ====================
local function fireButtonSignal(button)
    if not button then return end
    pcall(function()
        if getconnections then
            for _, connection in ipairs(getconnections(button.Activated)) do connection:Fire() end
            for _, connection in ipairs(getconnections(button.MouseButton1Click)) do connection:Fire() end
        elseif firesignal then
            firesignal(button.MouseButton1Click); firesignal(button.Activated)
        end
    end)
end

local function triggerStartButton()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return false end
    local bunkerMenus = playerGui:FindFirstChild("BunkerMenus")
    if not bunkerMenus then return false end
    local startRaid = bunkerMenus:FindFirstChild("StartRaid")
    if not startRaid then return false end
    local body = startRaid:FindFirstChild("Body")
    if not body then return false end
    local startButton = body:FindFirstChild("Start")
    if not startButton or not startButton.Visible then return false end
    fireButtonSignal(startButton)
    return true
end

-- ==================== RESET TRẠNG THÁI ====================
local function resetCharacterState()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("Humanoid") then return end
    local hum = char.Humanoid
    hum.PlatformStand = false; hum.AutoRotate = true; hum.WalkSpeed = 16; hum.JumpPower = 50
    hum:ChangeState(Enum.HumanoidStateType.GettingUp)
    task.wait(0.1)
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        for _, obj in pairs(hrp:GetChildren()) do
            if obj:IsA("BodyPosition") or obj:IsA("BodyVelocity") or obj:IsA("BodyGyro") then obj:Destroy() end
        end
    end
end

-- ==================== AUTO USE ITEM ====================
local function activateTool(tool)
    if not tool then return end
    pcall(function()
        if getconnections then
            for _, conn in ipairs(getconnections(tool.Activated)) do conn:Fire() end
        end
    end)
    pcall(function() tool:Activate() end)
end

local function autoUseItemLoop()
    while task.wait(0.1) do
        if not autoUseItemEnabled or selectedItemName == "" then continue end
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("Humanoid") then continue end
        local hum = char.Humanoid
        local equippedTool = char:FindFirstChildOfClass("Tool")
        if not equippedTool or equippedTool.Name ~= selectedItemName then
            local backpack = LocalPlayer:FindFirstChild("Backpack")
            if backpack then
                local targetTool = backpack:FindFirstChild(selectedItemName)
                if targetTool then
                    pcall(function() hum:EquipTool(targetTool) end)
                    task.wait(0.05)
                    if targetTool.Parent ~= char then pcall(function() targetTool.Parent = char end) end
                end
            end
        end
        task.wait(0.05)
        local currentTool = char:FindFirstChildOfClass("Tool")
        if currentTool and currentTool.Name == selectedItemName then activateTool(currentTool) end
    end
end

-- ==================== LOGIC AUTO FARM ====================
local function autoFarmLoop()
    while task.wait() do
        if not myPlot then
            myPlot = checkMyPlot()
            if myPlot and plotLabel then
                pcall(function() plotLabel:SetDesc("Plot: " .. myPlot.Name) end)
            end
        end

        if autoFarmEnabled then
            if not autoUseItemEnabled or selectedItemName == "" then
                autoFarmEnabled = false
                if farmToggle then pcall(function() farmToggle:Set(false) end) end
                targetEnemy = nil; lastValidPos = nil; resetCharacterState(); Camera.CameraType = Enum.CameraType.Custom
                WindUI:Notify({ Title = "Auto Farm", Content = "Đã tắt vì thiếu điều kiện!", Duration = 3 })
                continue
            end
            if not myPlot then
                autoFarmEnabled = false
                if farmToggle then pcall(function() farmToggle:Set(false) end) end
                targetEnemy = nil; lastValidPos = nil; resetCharacterState(); Camera.CameraType = Enum.CameraType.Custom
                WindUI:Notify({ Title = "Auto Farm", Content = "Chưa có Plot! Bấm Check Plot.", Duration = 3 })
                continue
            end
        end

        if not autoFarmEnabled then continue end

        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") then continue end

        local root = char.HumanoidRootPart
        char.Humanoid.AutoRotate = false

        -- Cập nhật label hiển thị số quái trong Plot
        local enemies = getAllEnemies()
        if plotLabel then
            pcall(function() 
                plotLabel:SetDesc("Plot: " .. myPlot.Name .. " | Quái trong Plot: " .. #enemies) 
            end)
        end

        if targetEnemy then
            if not targetEnemy.Parent or targetEnemy.Humanoid.Health <= 0 then
                targetEnemy = nil
            end
        end

        if not targetEnemy then
            targetEnemy = getClosestEnemy()
        end

        if targetEnemy then
            local enemyRoot = targetEnemy.HumanoidRootPart
            local targetPos = enemyRoot.Position + Vector3.new(0, FLY_HEIGHT, 0)
            local lookDir = (enemyRoot.Position - targetPos).Unit
            root.CFrame = CFrame.lookAt(targetPos, targetPos + lookDir)
            root.Velocity = Vector3.new(0, 0, 0)

            lastValidPos = root.CFrame

            Camera.CameraType = Enum.CameraType.Scriptable
            local forwardDir = (enemyRoot.Position - root.Position).Unit
            local camPos = root.Position + forwardDir * CAM_DISTANCE + Vector3.new(0, 1.5, 0)
            Camera.CFrame = CFrame.new(camPos, enemyRoot.Position)

            if autoFireEnabled then autoFire() end
        else
            if lastValidPos then
                root.CFrame = lastValidPos
                root.Velocity = Vector3.new(0, 0, 0)
            end
        end
    end
end

