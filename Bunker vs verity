local function getBackpackItems()
    local items = {}
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        for _, child in pairs(backpack:GetChildren()) do
            if child:IsA("Tool") and not EXCLUDED_ITEMS[child.Name] then
                table.insert(items, child.Name)
            end
        end
    end
    if #items == 0 then table.insert(items, "Không có item") end
    return items
end

local function isDifferent(list1, list2)
    if #list1 ~= #list2 then return true end
    for i = 1, #list1 do if list1[i] ~= list2[i] then return true end end
    return false
end

