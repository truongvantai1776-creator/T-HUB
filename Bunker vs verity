-- ==================== THREAD TỰ ĐỘNG CẬP NHẬT DROPDOWN ====================
task.spawn(function()
    local lastItems = getBackpackItems()
    while task.wait(1) do
        local newItems = getBackpackItems()
        if isDifferent(lastItems, newItems) then
            lastItems = newItems
            if itemDropdown then
                pcall(function()
                    itemDropdown:SetValues(newItems)
                end)
            end
        end
    end
end)

-- ==================== KHỞI CHẠY ====================
task.spawn(autoFarmLoop)
task.spawn(autoUseItemLoop)
