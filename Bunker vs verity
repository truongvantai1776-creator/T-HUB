    Title = "Chọn Item để dùng",
    Values = getBackpackItems(),
    Value = nil,
    Callback = function(option)
        selectedItemName = option
    end
})

farmToggle = MainTab:Toggle({
    Title = "Auto Farm",
    Default = false,
    Callback = function(state)
        if state then
            if not autoUseItemEnabled then
                WindUI:Notify({ Title = "Auto Farm", Content = "Phải BẬT Auto Use Item trước!", Duration = 3 })
                if farmToggle then pcall(function() farmToggle:Set(false) end) end
                return
            end
            if selectedItemName == "" then
                WindUI:Notify({ Title = "Auto Farm", Content = "Phải CHỌN Item trước!", Duration = 3 })
                if farmToggle then pcall(function() farmToggle:Set(false) end) end
                return
            end
            if not myPlot then
                myPlot = checkMyPlot()
                if plotLabel then pcall(function() plotLabel:SetDesc(myPlot and ("Plot: "..myPlot.Name) or "Không tìm thấy") end) end
                if not myPlot then
                    WindUI:Notify({ Title = "Auto Farm", Content = "Không có Plot! Bấm Check Plot.", Duration = 3 })
                    if farmToggle then pcall(function() farmToggle:Set(false) end) end
                    return
                end
            end
        end

        autoFarmEnabled = state
        local char = LocalPlayer.Character

        if state then
            resetCharacterState()
            targetEnemy = nil; lastValidPos = nil
            if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
                char.Humanoid.PlatformStand = true; char.Humanoid.AutoRotate = false
                char.Humanoid:ChangeState(Enum.HumanoidStateType.Physics)
                lastValidPos = char.HumanoidRootPart.CFrame + Vector3.new(0, FLY_HEIGHT, 0)
            end
            WindUI:Notify({ Title = "Auto Farm", Content = "Đã BẬT", Duration = 2 })
        else
            targetEnemy = nil; lastValidPos = nil; resetCharacterState(); Camera.CameraType = Enum.CameraType.Custom
            WindUI:Notify({ Title = "Auto Farm", Content = "Đã TẮT", Duration = 2 })
        end
    end
})

