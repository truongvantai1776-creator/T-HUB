-- // Tên file lưu trạng thái vượt key trên thiết bị của người chơi
local SAVE_FILE_NAME = "T_HUB_KeySystem_Data.json"
local HttpService = game:GetService("HttpService")

-- // Hàm kiểm tra xem đã lưu trạng thái vượt key trong vòng 24h qua chưa
local function CheckSavedKey()
    if readfile and isfile and isfile(SAVE_FILE_NAME) then
        local success, data = pcall(function()
            return HttpService:JSONDecode(readfile(SAVE_FILE_NAME))
        end)
        if success and data and data.ExpiryTime then
            -- Nếu thời gian hiện tại vẫn nhỏ hơn thời gian hết hạn (chưa quá 24h)
            if os.time() < data.ExpiryTime then
                return true
            end
        end
    end
    return false
end

-- // Hàm lưu lại mốc thời gian đã nhập đúng key (hiệu lực trong 24 giờ = 86400 giây)
local function SaveKeySession()
    if writefile then
        local data = {
            ExpiryTime = os.time() + 86400 -- 24 giờ tới
        }
        pcall(function()
            writefile(SAVE_FILE_NAME, HttpService:JSONEncode(data))
        end)
    end
end

-- // Hàm load script chính
local function LoadMainScript()
    print("Key chính xác! Đang mở script...")
    pcall(function()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/truongvantai1776-creator/T-HUB/refs/heads/main/Script%20vip"))()
    end)
end

-- // Nếu trong vòng 24h đã nhập đúng key trước đó thì bỏ qua không hiện bảng nữa
if CheckSavedKey() then
    LoadMainScript()
    return -- Dừng script, không tạo giao diện nữa
end

