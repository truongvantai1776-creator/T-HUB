-- // Tính toán chọn file và link dựa theo chu kỳ 24 giờ (vòng lặp 5 ngày)
local function GetCurrentIndex()
    local secondsInDay = 86400
    local currentDayIndex = math.floor(os.time() / secondsInDay)
    -- Hàm luân phiên trả về từ 1 đến 5
    return (currentDayIndex % 5) + 1
end

