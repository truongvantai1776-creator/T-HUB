-- // Kiểm tra trạng thái lưu 24h qua file trong workspace của executor
local SAVE_FILE_NAME = "THUB_KeyCache_24h.json"

local function CheckSavedKey()
    if isfile and readfile and isfile(SAVE_FILE_NAME) then
        local success, data = pcall(function()
            return game:GetService("HttpService"):JSONDecode(readfile(SAVE_FILE_NAME))
        end)
        if success and data and data.ExpiryTime then
            -- Nếu thời gian hiện tại vẫn nhỏ hơn thời gian hết hạn (chưa qua 24h)
            if os.time() < data.ExpiryTime then
                return true
            end
        end
    end
    return false
end

local function SaveKeySession()
    if writefile and game:GetService("HttpService") then
        local data = {
            ExpiryTime = os.time() + 86400 -- 86400 giây tương ứng đúng 24 giờ
        }
        pcall(function()
            writefile(SAVE_FILE_NAME, game:GetService("HttpService"):JSONEncode(data))
        end)
    end
end

-- Nếu trong vòng 24h đã nhập đúng key trước đó, tự động bỏ qua bảng UI và load thẳng script chính
