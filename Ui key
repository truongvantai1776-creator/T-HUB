-- // Chức năng bấm nút Xác Nhận Key
SubmitBtn.MouseButton1Click:Connect(function()
    local userKey = TextBox.Text
    if userKey == "" then
        StatusLabel.Text = "Vui lòng nhập key trước!"
        return
    end

    SubmitBtn.Text = "Đang kiểm tra..."
    
    -- Tải nội dung file key từ GitHub tương ứng với ngày hiện tại
    local success, serverKey = pcall(function()
        return game:HttpGet(ACTIVE_KEY_URL)
    end)

    if success and serverKey then
        -- Xóa khoảng trắng hoặc xuống dòng thừa trong file key nếu có
        serverKey = serverKey:gsub("%s+", "")
        
        if userKey == serverKey then
            StatusLabel.Text = "Thành công! Đang lưu phiên..."
            SaveKeySession() -- Lưu trạng thái để 24h sau không hiện lại
            task.wait(0.5)
            ScreenGui:Destroy()
            LoadMainScript()
        else
            SubmitBtn.Text = "Xác Nhận"
            StatusLabel.Text = "Sai Key! Vui lòng thử lại."
        end
    else
        SubmitBtn.Text = "Xác Nhận"
        StatusLabel.Text = "Lỗi kết nối tới GitHub!"
    end
end)
