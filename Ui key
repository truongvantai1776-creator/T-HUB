-- // Tính toán chọn file và link dựa theo chu kỳ 24 giờ (vòng lặp 3 ngày)
local function GetCurrentIndex()
    local secondsInDay = 86400
    local currentDayIndex = math.floor(os.time() / secondsInDay)
    -- Hàm luân phiên trả về 1, 2 hoặc 3
    return (currentDayIndex % 3) + 1
end

local activeIndex = GetCurrentIndex()
local CURRENT_KEY_URL = KEY_URLS[activeIndex]
local CURRENT_GET_KEY_LINK = GET_KEY_LINKS[activeIndex]

