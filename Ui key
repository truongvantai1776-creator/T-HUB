-- // Hàm tải script chính sau khi vượt qua Key System
local function LoadMainScript()
    ScreenGui:Destroy()
    print("Đúng key! Đang mở script chính...")
    
    -- Chạy script chính của bạn
    loadstring(game:HttpGet("https://raw.githubusercontent.com/truongvantai1776-creator/T-HUB/refs/heads/main/Script%20vip"))()
end

-- // Xử lý sự kiện bấm nút Get Key (Copy link vào Clipboard)
GetKeyBtn.MouseButton1Click:Connect(function()
    local clipboardFunc = setclipboard or toclipboard or syn and syn.write_clipboard
    
    if clipboardFunc then
        clipboardFunc(CURRENT_GET_KEY_LINK)
        StatusLabel.Text = "Đã sao chép link vào bộ nhớ tạm!"
        StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
    else
        StatusLabel.Text = "Executor không hỗ trợ sao chép tự động!"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
    end
end)

-- // Kiểm tra khi bấm nút xác nhận
SubmitBtn.MouseButton1Click:Connect(function()
    local userKey = TextBox.Text
    SubmitBtn.Text = "Đang kiểm tra..."

    -- Tải key từ đường dẫn GitHub tương ứng của ngày hôm nay
    local success, serverKey = pcall(function()
        return game:HttpGet(CURRENT_KEY_URL)
    end)

    if success and serverKey then
        serverKey = serverKey:gsub("%s+", "") 
        
        if userKey == serverKey then
            LoadMainScript()
        else
            SubmitBtn.Text = "Key sai"
            task.wait(1.5)
            SubmitBtn.Text = "Xác Nhận Key"
        end
    else
        SubmitBtn.Text = "Key sai"
        task.wait(1.5)
        SubmitBtn.Text = "Xác Nhận Key"
    end
end)
