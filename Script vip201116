local function playerNames()
    local t = {}
    for _, p in ipairs(Players:GetPlayers()) do if p ~= lp then table.insert(t, p.Name) end end
    table.sort(t)
    if #t == 0 then t = { "(-)" } end
    return t
end

local PlayerDrop = CharTab:Dropdown({
    Title = L("Select player", "Chọn người chơi"), Icon = "users",
    Values = playerNames(), Value = playerNames()[1],
    Callback = function(v) S.Target = Players:FindFirstChild(val(v)) end,
})
S.Target = Players:FindFirstChild(playerNames()[1])

local function refreshPlayers() pcall(function() PlayerDrop:Refresh(playerNames()) end) end
Players.PlayerAdded:Connect(refreshPlayers)
Players.PlayerRemoving:Connect(function(p)
    if S.Target == p then S.Target = nil end
    task.wait(0.2)
    refreshPlayers()
end)

local function needTarget()
