local function hop(order)
    notify(HUB_NAME, L("Searching server...", "Đang tìm server..."), "search")
    task.spawn(function()
        local s, res = pcall(function()
            return HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId ..
                "/servers/Public?sortOrder=" .. order .. "&limit=100"))
        end)
        if s and res and res.data then
            local list = {}
            for _, v in ipairs(res.data) do
                if v.playing < v.maxPlayers and v.id ~= game.JobId then table.insert(list, v) end
            end
            if #list > 0 then
                table.sort(list, function(a, b)
                    if order == "Desc" then return a.playing > b.playing end
                    return a.playing < b.playing
                end)
                TeleportService:TeleportToPlaceInstance(game.PlaceId, list[1].id, lp)
                return
            end
        end
        notify(HUB_NAME, L("No suitable server found", "Không tìm thấy server phù hợp"), "x")
    end)
end
