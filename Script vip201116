-- ==================== VÒNG LẶP TỐI ƯU ====================
local updateTimer = 0
RunService.RenderStepped:Connect(function(dt)
    updateTimer = updateTimer + dt

    if S.AimLock then
        FOVCircle.Size = UDim2.fromOffset(S.AimFOV * 2, S.AimFOV * 2)
        FOVCircle.Visible = S.ShowFOV
        local part = getAimTarget()
        if part then
            local cam = workspace.CurrentCamera
            cam.CFrame = CFrame.new(cam.CFrame.Position, part.Position)
        end
    else
        FOVCircle.Visible = false
    end

    if updateTimer >= 0.1 then
        updateTimer = 0

        if S.Hitbox then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= lp then
                    local part = p.Character and p.Character:FindFirstChild(S.HitboxPart)
                    if part then
                        if (S.HitboxTeam and isTeammate(p)) or not aliveRoot(p) then
                            resetHitbox(p)
                        else
                            if not OriginalHitboxSizes[part] then OriginalHitboxSizes[part] = part.Size end
                            part.Size = Vector3.new(S.HitboxSize, S.HitboxSize, S.HitboxSize)
                            part.Transparency = S.HitboxTrans
                            part.CanCollide = false
                        end
                    end
                end
            end
        end

        if S.ESP or S.ShowNames then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= lp then pcall(updateESP, p) end
            end
        end
    end

    local myRoot = getHRP()
    if myRoot then
        if S.Follow then
            if not aliveRoot(followTarget) then followTarget = closestPlayer() end
            local tr = aliveRoot(followTarget)
            if tr then
                myRoot.CFrame = CFrame.lookAt((tr.CFrame * CFrame.new(0, S.FollowHeight, S.FollowDist)).Position, tr.Position)
            end
        else
            followTarget = nil
        end
        if S.Teleport then
            local tr = aliveRoot(S.Target)
            if tr then
                myRoot.CFrame = CFrame.lookAt((tr.CFrame * CFrame.new(0, S.TeleHeight, S.TeleDist)).Position, tr.Position)
            end
        end
    end

    if spin then
        local hrp = getHRP()
        if hrp then hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(spinSpeed), 0) end
    end
end)

