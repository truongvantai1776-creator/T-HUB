-- ==================== HELPERS ====================
local function notify(title, content, icon, dur)
    pcall(function()
        WindUI:Notify({ Title = title or HUB_NAME, Content = content or "", Icon = icon or "bell", Duration = dur or 3 })
    end)
end

local function copy(text, label)
    if setclipboard then
        setclipboard(text)
        notify(HUB_NAME, L("Copied ", "Đã sao chép ") .. label .. "!", "check")
    else
        notify(HUB_NAME, L("Executor lacks setclipboard", "Executor không hỗ trợ setclipboard"), "x")
    end
end

local function getChar() return lp.Character end
local function getHum() local c = lp.Character return c and c:FindFirstChildOfClass("Humanoid") end
local function getHRP() local c = lp.Character return c and c:FindFirstChild("HumanoidRootPart") end
local function val(v) if type(v) == "table" then return v[1] end return v end

local function Tog(tab, key, title, desc, icon, def, cb)
    local el = tab:Toggle({
        Title = title, Desc = desc, Icon = icon, Value = def, Default = def,
        Callback = function(s)
            local okc, err = pcall(cb, s)
            if not okc then warn("[T HUB] " .. tostring(title) .. ": " .. tostring(err)) end
            if ready then notify(title, s and L("Enabled", "Đã BẬT") or L("Disabled", "Đã TẮT"), icon, 2) end
        end,
    })
    if key then reg[key] = el end
    return el
end

local function Sld(tab, key, title, icon, min, max, def, cb, step)
    local el = tab:Slider({
        Title = title, Icon = icon, Step = step or 1,
        Value = { Min = min, Max = max, Default = def },
        Callback = function(v) pcall(cb, v) end,
    })
    if key then reg[key] = el end
    return el
end

local function Btn(tab, title, desc, icon, cb)
    return tab:Button({
        Title = title, Desc = desc, Icon = icon,
        Callback = function()
            local okc, err = pcall(cb)
            if not okc then
                warn("[T HUB] " .. tostring(title) .. ": " .. tostring(err))
                notify(title, L("An error occurred", "Có lỗi xảy ra"), "x")
            end
        end,
    })
end

local function runUrl(url, name)
    notify(name or HUB_NAME, L("Loading...", "Đang tải..."), "download", 2)
    task.spawn(function()
