local function loadLogo()
    if LOGO_ASSET_ID ~= "" then return "rbxassetid://" .. LOGO_ASSET_ID end
    if LOGO_URL ~= "" and writefile and getcustomasset then
        local ok, res = pcall(function()
            if makefolder and not (isfolder and isfolder("THUB")) then makefolder("THUB") end
            local ext = LOGO_URL:match("%.(%a+)$") or "png"
            local path = "THUB/logo." .. ext:lower()
            writefile(path, game:HttpGet(LOGO_URL))
            return getcustomasset(path)
        end)
        if ok then return res end
    end
    return nil
end
