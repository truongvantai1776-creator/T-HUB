local function getAimTarget()
    local cam = workspace.CurrentCamera
    local center = cam.ViewportSize / 2
    local best, shortest = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            local part = p.Character:FindFirstChild(S.AimPart) or p.Character:FindFirstChild("Head") or p.Character:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and part and not (S.AimTeam and isTeammate(p)) then
                local sp, onScreen = cam:WorldToViewportPoint(part.Position)
                if onScreen then
                    local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                    if d <= S.AimFOV and d < shortest then shortest, best = d, part end
                end
            end
        end
    end
    return best
end

