local gameCooldowns = {}

local function makeGameBtn(gameTitle, url)
    local key = gameTitle:gsub("%s", "_")
    gameCooldowns[key] = 0

    return GameTab:Button({
        Title = gameTitle,
        Desc = L("Bấm để tải script", "Bấm để tải script"),
        Icon = "play",
        Callback = function()
            local now = os.clock()
            local lastClick = gameCooldowns[key] or 0
            local elapsed = now - lastClick

            if elapsed < COOLDOWN_TIME and lastClick > 0 then
                local remaining = math.ceil(COOLDOWN_TIME - elapsed)
                notify(gameTitle, L("Vui lòng chờ " .. remaining .. "s nữa!",
                                    "Vui lòng chờ " .. remaining .. "s nữa!"), "clock", 3)
                return
            end

            gameCooldowns[key] = now
            runUrl(url, gameTitle)
        end,
    })
end

