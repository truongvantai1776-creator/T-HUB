pcall(function()
    local mt = getrawmetatable(game)
    if not (mt and setreadonly and newcclosure) then return end
    local oldNI = mt.__newindex
    setreadonly(mt, false)
    mt.__newindex = newcclosure(function(self, k, v)
        if self == cam and k == "CFrame" and typeof(v) == "CFrame" then
            if H.AimPos and H.CurYaw and H.CurPitch then
                return oldNI(self, k, anglesToCF(v.Position, H.CurYaw, H.CurPitch))
            end
            if H.Frozen and H.FrozenLook then
                return oldNI(self, k, CFrame.new(v.Position, v.Position + H.FrozenLook))
            end
        end
        if H.AimPos and myHRP and self == myHRP and k == "CFrame" and typeof(v) == "CFrame" then
            local yaw, _ = calcAngles(v.Position, H.AimPos)
            return oldNI(self, k, CFrame.new(v.Position) * CFrame.Angles(0, yaw, 0))
        end
        return oldNI(self, k, v)
    end)
    setreadonly(mt, true)
end)

U.InputBegan:Connect(function(input, gp)
    if gp then return end
    if H.Frozen and (input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.MouseMovement) then
        H.Frozen = false H.FrozenLook = nil
        if myHum then myHum.AutoRotate = true end
    end
end)
U.InputChanged:Connect(function(input)
    if not H.Frozen then return end
    if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch)
        and input.Delta and input.Delta.Magnitude > 0.5 then
        H.Frozen = false H.FrozenLook = nil
        if myHum then myHum.AutoRotate = true end
    end
end)

S.RenderStepped:Connect(function(dt)
    if not myHRP or not myHRP.Parent then bindChar() end
    if not C.On then
        if H.AimPos then
            H.Frozen = true
            H.FrozenLook = cam.CFrame.LookVector
            H.AimPos = nil H.CurYaw = nil H.CurPitch = nil
        end
        return
    end
    if H.Frozen then H.Frozen = false H.FrozenLook = nil end

    local targetDead = C.Target and not ch(C.Target)
    local needNew = false
    if C.LockTarget then
        needNew = targetDead
    else
        needNew = C.AutoPick or targetDead
        if C.Scan360 then needNew = true end
    end

    if needNew then
        local newT, scanned = findTarget(C.Scan360 or targetDead or not C.Target)
        if newT then
            C.Target = newT
            local hp = head(newT)
            if hp then H.AimPos = hp.Position end
            if targetDead then H.CurYaw = nil H.CurPitch = nil end
        elseif C.Scan360 and scanned then
            C.Target = nil
            if H.AimPos then
                H.Frozen = true
                H.FrozenLook = cam.CFrame.LookVector
                H.AimPos = nil H.CurYaw = nil H.CurPitch = nil
            end
            return
        end
    end

    local t = C.Target
    local hp = t and head(t)
    if not hp then return end

    if C.WallCheck and not isVisible(t, hp) then
        if not H.AimPos then
            H.Frozen = true
            H.FrozenLook = cam.CFrame.LookVector
        end
        local now = os.clock()
        if lbl and (now - Cache.LabelAt) > Cache.LabelCD then
            Cache.LabelAt = now
            lbl.Text = "[X] "..t.Name:sub(1,8).." BLOCKED"
        end
        return
    end

    H.AimPos = hp.Position
    if myHum then myHum.AutoRotate = false end

    local camPos = cam.CFrame.Position
    local wantYaw, wantPitch = calcAngles(camPos, H.AimPos)

    if not H.CurYaw then
        local curLook = cam.CFrame.LookVector
        H.CurYaw = math.atan2(-curLook.X, -curLook.Z)
        H.CurPitch = math.asin(math.clamp(curLook.Y, -1, 1))
    end

    if C.RotSpeed >= 100 then
        H.CurYaw = wantYaw
        H.CurPitch = wantPitch
    else
        local maxStep = math.rad(C.RotSpeed) * dt * 60
        local yawDiff = wantYaw - H.CurYaw
        while yawDiff > math.pi do yawDiff = yawDiff - 2*math.pi end
        while yawDiff < -math.pi do yawDiff = yawDiff + 2*math.pi end
        local pitchDiff = wantPitch - H.CurPitch
        H.CurYaw = H.CurYaw + math.clamp(yawDiff, -maxStep, maxStep)
        H.CurPitch = H.CurPitch + math.clamp(pitchDiff, -maxStep, maxStep)
    end
    H.CurPitch = math.clamp(H.CurPitch, math.rad(-89), math.rad(89))

    local now = os.clock()
    if lbl and (now - Cache.LabelAt) > Cache.LabelCD then
        Cache.LabelAt = now
        if myHRP then
            local dist = (hp.Position - myHRP.Position).Magnitude
            lbl.Text = string.format("[O] %s %dm", t.Name:sub(1,10), math.floor(dist))
        end
    end
end)

S.Stepped:Connect(function()
    if not H.AimPos or not H.CurYaw then return end
    if not myHRP or not myHRP.Parent then return end
    pcall(function()
        myHRP.CFrame = CFrame.new(myHRP.Position) * CFrame.Angles(0, H.CurYaw, 0)
    end)
    if myHum and myHum.AutoRotate then myHum.AutoRotate = false end
end)

