            b.BackgroundColor3 = (C.Target == p) and Color3.fromRGB(0,150,90) or Color3.fromRGB(35,44,65)
            b.BorderSizePixel = 0
            b.Text = p.DisplayName
            b.Font = Enum.Font.GothamMedium
            b.TextSize = 11
            b.TextColor3 = Color3.fromRGB(230,240,255)
            Instance.new("UICorner", b).CornerRadius = UDim.new(0,4)
            if C.Target == p then selectedBtn = b end
            b.MouseButton1Click:Connect(function()
                if selectedBtn == b then
                    C.Target = nil
                    C.LockTarget = false
                    C.AutoPick = true
                    btnAuto.Text = "AUTO PICK: ON"
                    btnAuto.BackgroundColor3 = cl(true)
                    b.BackgroundColor3 = Color3.fromRGB(35,44,65)
                    selectedBtn = nil
                else
                    C.Target = p
                    C.LockTarget = true
                    C.AutoPick = false
                    C.Scan360 = false
                    btn360.Text = "360 SCAN: OFF"
                    btn360.BackgroundColor3 = Color3.fromRGB(35,44,65)
                    btnAuto.Text = "AUTO PICK: OFF"
                    btnAuto.BackgroundColor3 = cl(false)
                    for _,o in pairs(playerFrame:GetChildren()) do
                        if o:IsA("TextButton") then o.BackgroundColor3 = Color3.fromRGB(35,44,65) end
                    end
                    b.BackgroundColor3 = Color3.fromRGB(0,150,90)
                    selectedBtn = b
                end
            end)
        end
    end
end
