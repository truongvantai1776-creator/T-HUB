local function isTeam(p) return lp.Team and p.Team == lp.Team end
local function ch(p)
    local c = p and p ~= lp and p.Character
    local h = c and c:FindFirstChildOfClass("Humanoid")
    return (h and h.Health > 0) and c or nil
end
local function head(p)
    local c = ch(p)
    return c and (c:FindFirstChild("Head") or c:FindFirstChild("HumanoidRootPart"))
end
local function isVisible(p, targetPart)
    if not C.WallCheck then return true end
    local now = os.clock()
    local last = Cache.VisAt[p]
    if last and (now - last) < Cache.VisCD then
        return Cache.VisResult[p] ~= false
    end
    local origin = cam.CFrame.Position
    local dir = targetPart.Position - origin
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {lp.Character, targetPart.Parent, cam}
    params.IgnoreWater = true
    local result = W:Raycast(origin, dir, params) == nil
    Cache.VisAt[p] = now
    Cache.VisResult[p] = result
    return result
end
local function findTarget(force)
    local now = os.clock()
    if not force and (now - Cache.FindTargetAt) < Cache.FindTargetCD then return nil end
    Cache.FindTargetAt = now
    local cx, cy = cam.ViewportSize.X/2, cam.ViewportSize.Y/2
    local myPos = myHRP and myHRP.Position or cam.CFrame.Position
    local best, bd = nil, math.huge
    for _, p in ipairs(P:GetPlayers()) do
        if p ~= lp and not (C.Team and isTeam(p)) then
            local hp = head(p)
            if hp and isVisible(p, hp) then
                if C.Scan360 then
                    local dist = (hp.Position - myPos).Magnitude
                    if dist <= C.Range and dist < bd then bd, best = dist, p end
                else
                    local s, on = cam:WorldToViewportPoint(hp.Position)
                    if on then
                        local d = (Vector2.new(s.X, s.Y) - Vector2.new(cx, cy)).Magnitude
                        if d <= C.FOV and d < bd then bd, best = d, p end
                    end
                end
            end
        end
    end
    return best, true
end
local function calcAngles(fromPos, toPos)
    local dir = toPos - fromPos
    if dir.Magnitude < 0.001 then return 0, 0 end
    local yaw = math.atan2(-dir.X, -dir.Z)
    local pitch = math.asin(math.clamp(dir.Y / dir.Magnitude, -1, 1))
    return yaw, math.clamp(pitch, math.rad(-89), math.rad(89))
end
local function anglesToCF(pos, yaw, pitch)
    return CFrame.new(pos) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
end

local function bindChar()
    myHRP = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    myHum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
    if myHum then myHum.AutoRotate = false end
end
