local function mkSlider(text, minV, maxV, defV, order, onChange)
    local holder = Instance.new("Frame", content)
    holder.Size = UDim2.new(1, -8, 0, 38)
    holder.BackgroundTransparency = 1
    holder.LayoutOrder = order

    local nameLbl = Instance.new("TextLabel", holder)
    nameLbl.Size = UDim2.new(1, 0, 0, 16)
    nameLbl.BackgroundTransparency = 1
    nameLbl.Text = text .. ": " .. tostring(defV)
    nameLbl.Font = Enum.Font.GothamMedium
    nameLbl.TextSize = 10
    nameLbl.TextColor3 = Color3.fromRGB(200,220,240)
    nameLbl.TextXAlignment = Enum.TextXAlignment.Left

    local track = Instance.new("Frame", holder)
    track.Size = UDim2.new(1, 0, 0, 10)
    track.Position = UDim2.fromOffset(0, 22)
    track.BackgroundColor3 = Color3.fromRGB(40, 48, 65)
    track.BorderSizePixel = 0
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame", track)
    fill.Size = UDim2.new((defV - minV) / (maxV - minV), 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(0, 200, 120)
    fill.BorderSizePixel = 0
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
    local fillGrad = Instance.new("UIGradient", fill)
    fillGrad.Color = ColorSequence.new(Color3.fromRGB(0,220,150), Color3.fromRGB(0,140,90))

    local knob = Instance.new("Frame", track)
    knob.Size = UDim2.fromOffset(14, 14)
    knob.Position = UDim2.new((defV - minV) / (maxV - minV), -7, 0.5, -7)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.BorderSizePixel = 0
    knob.ZIndex = 2
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)
    local knobStroke = Instance.new("UIStroke", knob)
    knobStroke.Color = Color3.fromRGB(0, 200, 120)
    knobStroke.Thickness = 2

    local hitArea = Instance.new("TextButton", track)
    hitArea.Size = UDim2.new(1, 0, 3, 0)
    hitArea.Position = UDim2.new(0, 0, 0.5, -15)
    hitArea.BackgroundTransparency = 1
    hitArea.Text = ""
    hitArea.ZIndex = 3

    local dragging = false
    local function setValue(alpha)
        alpha = math.clamp(alpha, 0, 1)
        local val = minV + alpha * (maxV - minV)
        if maxV - minV > 100 then
            val = math.floor(val)
        elseif maxV - minV > 10 then
            val = math.floor(val)
        else
            val = math.floor(val * 10 + 0.5) / 10
        end
        fill.Size = UDim2.new((val - minV) / (maxV - minV), 0, 1, 0)
        knob.Position = UDim2.new((val - minV) / (maxV - minV), -7, 0.5, -7)
        nameLbl.Text = text .. ": " .. tostring(val)
        onChange(val)
    end

    hitArea.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            local relX = input.Position.X - track.AbsolutePosition.X
            setValue(relX / track.AbsoluteSize.X)
        end
    end)
    U.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement 
        or input.UserInputType == Enum.UserInputType.Touch then
            local relX = input.Position.X - track.AbsolutePosition.X
            setValue(relX / track.AbsoluteSize.X)
        end
    end)
    U.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    return {SetValue = setValue}
end

