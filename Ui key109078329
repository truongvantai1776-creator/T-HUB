        if isVerifyingCooldown then return end

        local userKey = TextBox.Text
        if not userKey or not userKey:match("%S") then
            setStatus(t.statusEmpty, Palette.Danger)
            local origPos = MainFrame.Position
            for i = 1, 4 do
                TweenService:Create(MainFrame, TweenInfo.new(0.05), {
                    Position = origPos + UDim2.new(0, (i % 2 == 0 and 8 or -8), 0, 0)
                }):Play()
                task.wait(0.05)
            end
            TweenService:Create(MainFrame, TweenInfo.new(0.1), { Position = origPos }):Play()
            return
        end

        setStatus(t.statusVerifying, Palette.Warning)
        VerifyIcon.Text = "⟳"
        task.spawn(function()
            while isVerifyingCooldown and VerifyIcon and VerifyIcon.Parent do
                VerifyIcon.Rotation = (VerifyIcon.Rotation or 0) + 15
                task.wait(0.03)
            end
            if VerifyIcon and VerifyIcon.Parent then VerifyIcon.Rotation = 0 end
        end)

