local function SendDiscordNotification()
    if IsOwner() then return end 
    if DISCORD_WEBHOOK_URL == "" then return end
    
    task.spawn(function()
        pcall(function()
            local data = {
                ["content"] = string.format("👑 **Có người vượt Key thành công!**\n- **Username:** `%s`\n- **Display Name:** `%s`\n- **Thời gian:** <t:%d:F>", 
                    LocalPlayer.Name, 
                    LocalPlayer.DisplayName, 
                    os.time()
                )
            }
            local body = HttpService:JSONEncode(data)
            
            if syn and syn.request then
                syn.request({
                    Url = DISCORD_WEBHOOK_URL,
                    Method = "POST",
                    Headers = {["Content-Type"] = "application/json"},
                    Body = body
                })
            elseif http_request then
                http_request({
                    Url = DISCORD_WEBHOOK_URL,
                    Method = "POST",
                    Headers = {["Content-Type"] = "application/json"},
                    Body = body
                })
            end
        end)
    end)
end

local SAVE_FILE_NAME = "THUB_KeyCache_24h.json"

local function CheckSavedKey()
    if isfile and readfile and isfile(SAVE_FILE_NAME) then
        local success, data = pcall(function()
            return HttpService:JSONDecode(readfile(SAVE_FILE_NAME))
        end)
        if success and data and data.ExpiryTime then
            if os.time() < data.ExpiryTime then
                return true
            end
        end
    end
    return false
end

local function SaveKeySession()
    if writefile and HttpService then
        local data = { ExpiryTime = os.time() + 86400 }
        pcall(function()
            writefile(SAVE_FILE_NAME, HttpService:JSONEncode(data))
        end)
    end
    SendDiscordNotification()
end

if CheckSavedKey() then
    LoadMainScript()
    return
end

local LAST_DAY_FILE = "THUB_LastRandomDay_V2.json"

local function GetRandomIndexForPlayer()
    local secondsInDay = 86400
    local currentDayEpoch = math.floor(os.time() / secondsInDay)
    
    local data = nil
    if isfile and readfile and isfile(LAST_DAY_FILE) then
        pcall(function()
            data = HttpService:JSONDecode(readfile(LAST_DAY_FILE))
        end)
    end
    
    if data and data.EpochDay == currentDayEpoch and data.AssignedIndex then
        return data.AssignedIndex
    end
    
    local history = (data and data.History) or {}
    math.randomseed(os.time() + tick() + LocalPlayer.UserId)
    local newIndex = math.random(1, 10)
    
    local function isInHistory(val, tbl)
        for _, v in ipairs(tbl) do if v == val then return true end end
        return false
    end
    
    while isInHistory(newIndex, history) do
        newIndex = math.random(1, 10)
    end
    
    table.insert(history, newIndex)
    if #history > 5 then table.remove(history, 1) end
    
    if writefile and HttpService then
        pcall(function()
            writefile(LAST_DAY_FILE, HttpService:JSONEncode({
                EpochDay = currentDayEpoch,
                AssignedIndex = newIndex,
                History = history
            }))
        end)
    end
    
    return newIndex
end

