local isVerifyingCooldown = false

VerifyBtn.MouseButton1Click:Connect(function()
    local t = texts[currentLang]
    if isVerifyingCooldown then return end

    local userKey = TextBox.Text
    if not userKey or not userKey:match("%S") then
        StatusLabel.TextColor3 = Color3.fromRGB(239, 68, 68)
        StatusLabel.Text = t.statusEmpty
        return
    end

    StatusLabel.TextColor3 = Color3.fromRGB(245, 158, 11)
    StatusLabel.Text = t.statusVerifying

    -- Cooldown chống spam 3 giây
    isVerifyingCooldown = true
    task.spawn(function()
        for i = 3, 1, -1 do
            VerifyBtn.Text = string.format("%ds", i)
            task.wait(1)
        end
        VerifyBtn.Text = t.verifyBtn
        isVerifyingCooldown = false
    end)

    task.spawn(function()
        local response = safeRequest(NPOINT_URL, "GET")
        if not response or not response.Body then
            StatusLabel.TextColor3 = Color3.fromRGB(239, 68, 68)
            StatusLabel.Text = t.statusError
            return
        end

        local successDecode, result = pcall(function()
            return HttpService:JSONDecode(response.Body)
        end)

        if not successDecode or not result or not result.devices then
            StatusLabel.TextColor3 = Color3.fromRGB(239, 68, 68)
            StatusLabel.Text = t.statusDecode
            return
        end

        local currentTime = os.time() * 1000
        local keyIndex = nil
        local targetDevice = nil

        for i, device in ipairs(result.devices) do
            if device.key == userKey then
                keyIndex = i
                targetDevice = device
                break
            end
        end

        if not keyIndex or not targetDevice then
            StatusLabel.TextColor3 = Color3.fromRGB(239, 68, 68)
            StatusLabel.Text = t.statusNotFound
            return
        end

        if targetDevice.expireTimestamp <= currentTime then
            StatusLabel.TextColor3 = Color3.fromRGB(239, 68, 68)
            StatusLabel.Text = t.statusExpired
            return
        end

        local expireTimestamp = targetDevice.expireTimestamp
        table.remove(result.devices, keyIndex)

        task.spawn(function()
            safeRequest(NPOINT_URL, "POST", HttpService:JSONEncode(result))
        end)

        -- Lưu phiên làm việc tự động
        saveSessionData(expireTimestamp, userKey)

        StatusLabel.TextColor3 = Color3.fromRGB(16, 185, 129)
        StatusLabel.Text = t.statusSuccess
        task.wait(1)
        
        local fadeOut = TweenService:Create(MainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 0, 0, 0),
            Rotation = -720,
            BackgroundTransparency = 1
        })
        fadeOut:Play()
        fadeOut.Completed:Wait()
        
        ScreenGui:Destroy()
        createFloatingTimer(expireTimestamp)
        launchMainScript(expireTimestamp)
    end)
end)
