-- HÀM KÉO THẢ KHUNG
local function makeDraggable(frame)
    local dragging, dragInput, dragStart, startPos

    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    frame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            TweenService:Create(frame, TweenInfo.new(0.05, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
                Position = UDim2.new(
                    startPos.X.Scale, 
                    startPos.X.Offset + delta.X, 
                    startPos.Y.Scale, 
                    startPos.Y.Offset + delta.Y
                )
            }):Play()
        end
    end)
end

-- WATERMARK ĐỒNG HỒ ĐẾM NGƯỢC
local function createFloatingTimer(expireTimestamp)
    if CoreGui:FindFirstChild("THUB_Watermark") then
        CoreGui.THUB_Watermark:Destroy()
    end

    local WatermarkGui = Instance.new("ScreenGui")
    WatermarkGui.Name = "THUB_Watermark"
    WatermarkGui.Parent = CoreGui
    WatermarkGui.ResetOnSpawn = false

    local Frame = Instance.new("Frame")
    Frame.Size = UDim2.new(0, 120, 0, 36)
    Frame.Position = UDim2.new(0, 30, 0, 30)
    Frame.BackgroundColor3 = Color3.fromRGB(6, 12, 26)
    Frame.BackgroundTransparency = 0.2
    Frame.BorderSizePixel = 0
    Frame.Parent = WatermarkGui

    Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 8)

    local UIStroke = Instance.new("UIStroke")
    UIStroke.Color = Color3.fromRGB(56, 189, 248)
    UIStroke.Transparency = 0.3
    UIStroke.Parent = Frame

    local TextLabel = Instance.new("TextLabel")
    TextLabel.Size = UDim2.new(1, 0, 1, 0)
    TextLabel.BackgroundTransparency = 1
    TextLabel.TextColor3 = Color3.fromRGB(56, 189, 248)
    TextLabel.TextSize = 13
    TextLabel.Font = Enum.Font.GothamBold
    TextLabel.Text = "--:--:--"
    TextLabel.Parent = Frame

    makeDraggable(Frame)

    task.spawn(function()
        while WatermarkGui and WatermarkGui.Parent do
            local now = os.time() * 1000
            local distance = expireTimestamp - now

            if distance <= 0 then
                TextLabel.Text = "EXPIRED"
                TextLabel.TextColor3 = Color3.fromRGB(239, 68, 68)
                break
            else
                local hours = math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60))
                local minutes = math.floor((distance % (1000 * 60 * 60)) / (1000 * 60))
                local seconds = math.floor((distance % (1000 * 60)) / 1000)
                
                TextLabel.Text = string.format("%02dh %02dm %02ds", hours, minutes, seconds)
            end
            task.wait(1)
        end
    end)
end

