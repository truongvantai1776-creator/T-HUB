                VerifyBtn.Text = string.format("VERIFYING %ds", i)
                task.wait(1)
            end
            VerifyBtn.Text = t.verifyBtn
            VerifyIcon.Text = "✓"
            isVerifyingCooldown = false
        end)

        task.spawn(function()
            local response = safeRequest(NPOINT_URL, "GET")
            if not response or not response.Body then
                setStatus(t.statusError, Palette.Danger)
                LoadingBar.Size = UDim2.new(0, 0, 0, 2)
                return
            end

            local successDecode, result = pcall(function()
                return HttpService:JSONDecode(response.Body)
            end)

            if not successDecode or not result or not result.devices then
                setStatus(t.statusDecode, Palette.Danger)
                LoadingBar.Size = UDim2.new(0, 0, 0, 2)
                return
            end

            local currentTime = os.time() * 1000
            local keyIndex, targetDevice = nil, nil
            for i, device in ipairs(result.devices) do
                if device.key == userKey then
                    keyIndex, targetDevice = i, device
                    break
                end
            end

            if not keyIndex or not targetDevice then
                setStatus(t.statusNotFound, Palette.Danger)
                LoadingBar.Size = UDim2.new(0, 0, 0, 2)
                return
            end

            if targetDevice.expireTimestamp <= currentTime then
                setStatus(t.statusExpired, Palette.Danger)
                LoadingBar.Size = UDim2.new(0, 0, 0, 2)
                return
            end

            local expireTimestamp = targetDevice.expireTimestamp
            table.remove(result.devices, keyIndex)

            task.spawn(function()
                safeRequest(NPOINT_URL, "POST", HttpService:JSONEncode(result))
            end)

            saveSessionData(expireTimestamp, userKey)
            setStatus(t.statusSuccess, Palette.Success)
            LoadingBar.BackgroundColor3 = Palette.Success

            task.wait(0.8)

            for i = 1, 20 do
                task.spawn(function()
                    local p = Instance.new("Frame")
                    p.Size = UDim2.new(0, 6, 0, 6)
                    p.Position = UDim2.new(0.5, 0, 0.5, 0)
                    p.BackgroundColor3 = i % 2 == 0 and Palette.Success or Palette.Accent
                    p.BorderSizePixel = 0
                    p.ZIndex = 50
                    p.Parent = ScreenGui
                    Instance.new("UICorner", p).CornerRadius = UDim.new(1, 0)
                    local angle = math.rad(i * 18)
                    local dist = math.random(150, 350)
                    TweenService:Create(p, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        Position = UDim2.new(0.5, math.cos(angle) * dist, 0.5, math.sin(angle) * dist),
                        BackgroundTransparency = 1,
                        Size = UDim2.new(0, 0, 0, 0),
                        Rotation = 720
                    }):Play()
                    task.wait(1.3)
                    p:Destroy()
                end)
            end

            task.wait(0.9)

            local fadeOut = TweenService:Create(MainFrame, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
                Size = UDim2.new(0, 0, 0, 0),
                Position = UDim2.new(0.5, 0, 0.5, 0),
                Rotation = -30,
                BackgroundTransparency = 1
            })
            fadeOut:Play()
            TweenService:Create(Backdrop, TweenInfo.new(0.6), { BackgroundTransparency = 1 }):Play()
            fadeOut.Completed:Wait()

            ScreenGui:Destroy()
            createFloatingTimer(expireTimestamp, currentLang)
            launchMainScript(expireTimestamp)
        end)
