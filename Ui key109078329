local function saveSessionData(expireTimestamp, key)
    if writefile then
        pcall(function()
            local data = HttpService:JSONEncode({ expire = expireTimestamp, key = key })
            writefile(SAVED_DATA_FILENAME, data)
        end)
    end
end

local function clearSessionData()
    if writefile and isfile then
        pcall(function()
            if isfile(SAVED_DATA_FILENAME) then
                writefile(SAVED_DATA_FILENAME, "")
            end
        end)
    end
end

local function loadSessionData()
    if readfile and isfile then
        local success, data = pcall(function()
            if isfile(SAVED_DATA_FILENAME) then
                return readfile(SAVED_DATA_FILENAME)
            end
        end)
        if success and data and data ~= "" then
            local decodeSuccess, result = pcall(function()
                return HttpService:JSONDecode(data)
            end)
            if decodeSuccess and result then return result end
        end
    end
    return nil
end

local function safeRequest(url, method, bodyData)
    local req = syn and syn.request or http_request or request or HttpPost
    if not req then return nil end
    local success, response = pcall(function()
        if method == "GET" then
            return req({ Url = url, Method = "GET" })
        else
            return req({
                Url = url, Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = bodyData
            })
        end
    end)
    if success then return response end
    return nil
end

local function launchMainScript(expireTimestamp)
    local successScript, err = pcall(function()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/truongvantai1776-creator/T-HUB/refs/heads/main/Script%20vip201116"))()
