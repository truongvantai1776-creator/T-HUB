	lblTitle.Visible, toggleButton.Visible, killAuraLabel.Visible = not isGuiHidden, not isGuiHidden, not isGuiHidden
	mainFrame.Size = isGuiHidden and UDim2.new(0, 180, 0, 50) or UDim2.new(0, 180, 0, 160)
	hideButton.Position = isGuiHidden and UDim2.new(0, 10, 0, 10) or UDim2.new(0, 10, 0, 110)
end)

toggleButton.MouseButton1Click:Connect(function()
	if getgenv().AutoScriptRunning then return end
	getgenv().AutoScriptRunning = true
	getgenv().KillAuraRunning = true
	toggleButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50)

	-- Vòng lặp: Farm 20s -> Teleport ra cổng chờ đủ 110s -> Lặp lại
	task.spawn(function()
		while getgenv().AutoScriptRunning do
			farmFor20Seconds()
			if not getgenv().AutoScriptRunning then break end
			
			runPart4()
			if not getgenv().AutoScriptRunning then break end
		end
	end)

	-- Kill Aura phụ trợ tiêu diệt quái xung quanh khi đang đứng ở cổng
	task.spawn(function()
		while getgenv().KillAuraRunning do
			pcall(killAllNPCs)
			task.wait(0.2)
		end
	end)

	task.spawn(function()
		while getgenv().AutoScriptRunning do
			for i = 0, 1, 0.005 do
				if not getgenv().AutoScriptRunning then break end
				toggleButton.Text = "Auto Farm: ON"
				toggleButton.TextColor3 = Color3.fromHSV(i, 1, 1)
				task.wait(0.02)
			end
		end
	end)

	task.spawn(function()
		while getgenv().KillAuraRunning do
			for i = 0, 1, 0.005 do
				if not getgenv().KillAuraRunning then break end
				killAuraLabel.Text = "Kill Aura: ON"
				killAuraLabel.TextColor3 = Color3.fromHSV(i, 1, 1)
				task.wait(0.02)
			end
		end
	end)
end)

