local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")

local localPlayer = Players.LocalPlayer or Players.PlayerAdded:Wait()
local OFFSET_FAR = CFrame.new(0, 5, 20)

local remote = ReplicatedStorage:WaitForChild("FlowClient"):WaitForChild("ClientRunner"):WaitForChild("Event")

getgenv().AutoScriptRunning = false
getgenv().KillAuraRunning = false
local snowActive = true

local function safeWait(duration)
	local elapsed = 0
	while elapsed < duration do
		if not getgenv().AutoScriptRunning then return false end
		task.wait(0.5)
		elapsed = elapsed + 0.5
	end
	return true
end

RunService.Stepped:Connect(function()
	if getgenv().AutoScriptRunning and localPlayer.Character then
		for _, part in ipairs(localPlayer.Character:GetDescendants()) do
			if part:IsA("BasePart") and part.CanCollide then
				part.CanCollide = false
			end
		end
	end
end)

local function getHRP()
	local char = localPlayer.Character or localPlayer.CharacterAdded:Wait()
	local root = char:WaitForChild("HumanoidRootPart", 10)
	return root, char
end

local function safeTeleport(targetCFrame)
	local root, char = getHRP()
	if root and char then
		root.Anchored = true
		char:PivotTo(targetCFrame)
		safeWait(1.5)
		root.Anchored = false
	end
end

local function triggerFirePrompt(prompt)
	if not prompt or not prompt:IsA("ProximityPrompt") then return end
	prompt.RequiresLineOfSight = false
	prompt.MaxActivationDistance = 99999
	prompt.HoldDuration = 0
	if typeof(fireproximityprompt) == "function" then
		fireproximityprompt(prompt)
	end
end

local function killAllNPCs()
	local npcsFolder = workspace:FindFirstChild("NPCs")
	if not npcsFolder then return end
	for _, npc in ipairs(npcsFolder:GetChildren()) do
		local humanoid = npc:FindFirstChildOfClass("Humanoid")
		if humanoid then
			remote:FireServer("NPCs", "Damage", humanoid, math.huge)
		end
	end
end

-- Teleport farm các shop liên tục trong vòng 20 giây
local function farmFor20Seconds()
	local startTime = tick()
	while (tick() - startTime) < 20 do
		if not getgenv().AutoScriptRunning then break end
		
		local map = workspace:FindFirstChild("Map")
		local buildings = map and map:FindFirstChild("Buildings")
		if buildings then
			for _, shop in ipairs(buildings:GetChildren()) do
				if not getgenv().AutoScriptRunning then break end
				if shop.Name == "PawnShop" then
					local targetCFrame = shop:IsA("Model") and shop:GetPivot() or shop.CFrame
					local currentRoot = getHRP()
					if currentRoot then
						currentRoot.CFrame = targetCFrame + Vector3.new(0, 2, 0)
					end
					task.wait(0.2)
					killAllNPCs()
					task.wait(1.0)
				end
			end
		end
		task.wait(0.5)
	end
end

-- Teleport đến điểm cuối, đứng yên mở cổng và chờ đủ 110 giây không bị tele đi chỗ khác
local function runPart4()
	if not getgenv().AutoScriptRunning then return end
	safeTeleport(CFrame.new(1780, 1940, 83615) * CFrame.new(0, 5, 0))
	if not safeWait(0.5) then return end

	local map = workspace:WaitForChild("Map", 10)
	local customsFinal = map and map:WaitForChild("Buildings", 10):WaitForChild("CustomsFinal", 10)

	if customsFinal then
		local targetCFrame = customsFinal:IsA("Model") and customsFinal:GetPivot() or customsFinal.CFrame
		safeTeleport(targetCFrame * OFFSET_FAR)
	end

	if not safeWait(0.5) then return end

	local targetPrompt = customsFinal and customsFinal:FindFirstChildWhichIsA("ProximityPrompt", true)
	if targetPrompt then
		local promptOwner = targetPrompt.Parent
		if promptOwner:IsA("Attachment") then promptOwner = promptOwner.Parent end
		local doorCFrame = promptOwner:IsA("Model") and promptOwner:GetPivot() or promptOwner.CFrame
		safeTeleport(doorCFrame * CFrame.new(0, 0, 3))

		-- Tương tác với cổng liên tục
		task.spawn(function()
			while getgenv().AutoScriptRunning do
				triggerFirePrompt(targetPrompt)
				task.wait(0.1)
			end
		end)
	end

	if not safeWait(0.5) then return end

	-- Gửi tín hiệu Replay
	task.spawn(function()
		while getgenv().AutoScriptRunning do
			remote:FireServer("GameManager", "Replay")
			task.wait(0.1)
		end
	end)

	-- Đứng yên chờ đủ 110 giây mở cổng / hoàn thành màn chơi trước khi vòng lặp cho phép farm lại
	safeWait(110) 
end

