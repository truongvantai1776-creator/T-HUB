-- Hiệu ứng tuyết rơi
for i = 1, 15 do
	task.spawn(function()
		local flake = Instance.new("Frame", mainFrame)
		flake.Size, flake.Position = UDim2.new(0, math.random(3, 6), 0, math.random(3, 6)), UDim2.new(math.random(), 0, -0.1, 0)
		flake.BackgroundColor3, flake.BackgroundTransparency, flake.ZIndex = Color3.fromRGB(255, 255, 255), math.random(20, 50) / 100, 1
		Instance.new("UICorner", flake).CornerRadius = UDim.new(1, 0)
		local speed, drift = math.random(15, 35) / 1000, math.random(-10, 10) / 500
		while true do
			if snowActive then
				flake.Position = UDim2.new(flake.Position.X.Scale + drift, 0, flake.Position.Y.Scale + speed, 0)
				if flake.Position.Y.Scale > 1.1 then
					flake.Position = UDim2.new(math.random(), 0, -0.1, 0)
				end
			end
			task.wait(0.03)
		end
	end)
end

local isGuiHidden = false
