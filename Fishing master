local isAutoSellRunning = false

local function simulateGamePadButton(keyCode, holdTime)
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
        task.wait(holdTime or 0.05)
        VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
    end)
end

AutoSellBtn.MouseButton1Click:Connect(function()
    isAutoSellRunning = not isAutoSellRunning
    
    if isAutoSellRunning then
        AutoSellBtn.Text = "📦 Auto Sell: BẬT"
        AutoSellBtn.BackgroundColor3 = Color3.fromRGB(200, 140, 40)
        
        task.spawn(function()
            while isAutoSellRunning do
                local totalSeconds = autoSellSeconds
                while totalSeconds > 0 and isAutoSellRunning do
                    local mins = math.floor(totalSeconds / 60)
                    local secs = totalSeconds % 60
                    StatusLabel.Text = string.format("⏳ Auto Sell: %02d:%02d\n\n", mins, secs)
                    task.wait(1)
                    totalSeconds = totalSeconds - 1
                end
                
                if not isAutoSellRunning then break end
                
                -- Kiểm tra khi hết giờ: Nếu đang câu cá (nút FishingActionButton còn hiển thị), đợi đến khi nút biến mất
                StatusLabel.Text = "⏳ Đợi hoàn thành câu cá...\n\n"
                while isAutoSellRunning and isFishingButtonPresent() do
                    task.wait(0.2)
                end
                
                if not isAutoSellRunning then break end
                
                -- Khi nút biến mất, thực hiện nhấn màn hình 3 lần liên tiếp theo yêu cầu
                StatusLabel.Text = "⏳ Nhấn màn hình 3 lần...\n\n"
                pcall(function()
                    local x, y = getRandomScreenCenterPosition()
                    for i = 1, 3 do
                        if not isAutoSellRunning then break end
                        VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
                        task.wait(0.05) -- Click xuống rất nhanh
                        VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
                        task.wait(0.15) -- Nghỉ ngắn giữa các lần nhấn
                    end
                end)
                
                if isRunning then
                    stopAutoMaster()
                end
                
                StatusLabel.Text = "🛑 Đang chuẩn bị đi bán cá...\n\n"
                task.wait(0.3)
                
                local lp = Players.LocalPlayer
                local char = lp.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local originalCFrame = char.HumanoidRootPart.CFrame
                    StatusLabel.Text = "📍 Đã lưu vị trí câu.\n\n"
                    
                    StatusLabel.Text = "🧭 Tìm NPC bán cá...\n\n"
                    local targetNpcPart = nil
                    local shortestDist = math.huge
                    
                    for _, obj in ipairs(workspace:GetDescendants()) do
                        local nameLower = string.lower(obj.Name)
                        if nameLower == "npc_fish_seller_1" or string.find(nameLower, "seller") or string.find(nameLower, "fish_seller") then
                            local part = nil
                            if obj:IsA("Model") then
                                part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                            elseif obj:IsA("BasePart") then
                                part = obj
                            end
                            
                            if part then
                                local dist = (char.HumanoidRootPart.Position - part.Position).Magnitude
                                if dist < shortestDist then
                                    shortestDist = dist
                                    targetNpcPart = part
                                end
                            end
                        end
                    end
                    
                    if targetNpcPart then
                        StatusLabel.Text = "🕳️ Đang bay tới NPC...\n\n"
                        local targetPos = targetNpcPart.Position + Vector3.new(0, 3, 5)
                        
                        local arrivedAtNpc = flySmoothlyTo(CFrame.new(targetPos))
                        
                        if arrivedAtNpc then
                            StatusLabel.Text = "✅ Đã tới vị trí bán cá!\n\n"
                            task.wait(0.3)
                            
                            pcall(function()
                                for _, obj in ipairs(workspace:GetDescendants()) do
                                    local nameLower = string.lower(obj.Name)
                                    if nameLower == "npc_fish_seller_1" or string.find(nameLower, "seller") then
                                        local part = nil
                                        if obj:IsA("Model") then
                                            part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                                        elseif obj:IsA("BasePart") then
                                            part = obj
                                        end
                                        
                                        if part and (part.Position - char.HumanoidRootPart.Position).Magnitude < 30 then
                                            for _, prompt in ipairs(part:GetDescendants()) do
                                                if prompt:IsA("ProximityPrompt") then
                                                    fireproximityprompt(prompt)
                                                end
                                            end
                                        end
                                    end
                                end
                            end)
                            
                            -- Đợi khung hội thoại hiện lên, sau đó chờ 5 giây theo yêu cầu
                            StatusLabel.Text = "⏳ Đợi khung hội thoại & Chờ 5s...\n\n"
                            task.wait(5.0)
                            GuiService.SelectedObject = nil 

                            -- Nhấn 2 lần nút ButtonA sau khi đã qua thời gian chờ 5s
                            StatusLabel.Text = "⏳ Nhấn Button A (x2)...\n\n"
                            simulateGamePadButton(Enum.KeyCode.ButtonA, 0.08)
                            task.wait(0.3)
                            simulateGamePadButton(Enum.KeyCode.ButtonA, 0.08)
                            task.wait(0.5)
                            
                            -- Hàm chọn option chính xác tuyệt đối
                            local function selectOptionGamePadOnly(btnName)
                                pcall(function()
                                    local foundButton = nil
                                    for _, gui in ipairs(PlayerGui:GetChildren()) do
                                        if gui:IsA("ScreenGui") then
                                            for _, desc in ipairs(gui:GetDescendants()) do
                                                if desc.Name == btnName and desc:IsA("TextButton") and desc.Visible then
                                                    foundButton = desc
                                                    break
                                                end
                                            end
                                        end
                                        if foundButton then break end
                                    end
                                    
                                    if foundButton then
                                        GuiService.SelectedObject = foundButton
                                        task.wait(0.05)
                                        for _, conn in ipairs(getconnections(foundButton.MouseButton1Click) or {}) do conn:Fire() end
                                        for _, conn in ipairs(getconnections(foundButton.Activated) or {}) do conn:Fire() end
                                    end
                                    simulateGamePadButton(Enum.KeyCode.ButtonA, 0.08)
                                end)
                            end
                            
                            -- Thực hiện đúng thứ tự yêu cầu: Option002 -> Option001 -> Option002 -> Option001
                            StatusLabel.Text = "🛒 1. Chọn Option002...\n\n"
                            selectOptionGamePadOnly("Option002")
                            task.wait(3.0)
                            
                            StatusLabel.Text = "🛒 2. Chọn Option001...\n\n"
                            selectOptionGamePadOnly("Option001")
                            task.wait(3.0)
                            
                            StatusLabel.Text = "🛒 3. Chọn Option002...\n\n"
                            selectOptionGamePadOnly("Option002")
                            task.wait(3.0)
                            
                            StatusLabel.Text = "🛒 4. Chọn Option001...\n\n"
                            selectOptionGamePadOnly("Option001")
                            task.wait(0.5)
                        else
                            StatusLabel.Text = "⚠️ Không thể tới NPC!\n\n"
                            task.wait(1)
                        end
                        
                        StatusLabel.Text = "🕳️ Đang bay về vị trí cũ...\n\n"
                        local arrivedAtOldPos = flySmoothlyTo(originalCFrame)
                        
                        if arrivedAtOldPos then
                            StatusLabel.Text = "✅ Đã về lại vị trí cũ!\n\n"
                        else
                            if char and char:FindFirstChild("HumanoidRootPart") then
                                char.HumanoidRootPart.CFrame = originalCFrame
                            end
                            StatusLabel.Text = "✨ Đã khôi phục vị trí.\n\n"
                        end
                        
                        task.wait(0.3)
                        
                    else
                        StatusLabel.Text = "⚠️ Không thấy NPC!\n\n"
                        task.wait(1)
                    end
                end
                
                if isAutoSellRunning then
                    StatusLabel.Text = "🚀 Bật lại auto câu...\n\n"
                    task.wait(0.5)
                    if isAutoSellRunning then
                        startAutoMaster()
                    end
                end
                
                task.wait(0.5)
            end
        end)
    else
        AutoSellBtn.Text = "📦 Auto Sell: TẮT"
        AutoSellBtn.BackgroundColor3 = Color3.fromRGB(180, 100, 40)
        StatusLabel.Text = "⚡ Trạng thái: Đang tắt\n\n"
    end
end)
