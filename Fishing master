-- ================= LOGIC XỬ LÝ SPEED BUFF =================
local isSpeedBuffEnabled = false

SpeedBuffBtn.MouseButton1Click:Connect(function()
    isSpeedBuffEnabled = not isSpeedBuffEnabled
    local lp = Players.LocalPlayer
    
    if isSpeedBuffEnabled then
        SpeedBuffBtn.Text = "⚡ Speed Buff: BẬT (40)"
        SpeedBuffBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 80)
        if lp.Character and lp.Character:FindFirstChild("Humanoid") then
            lp.Character.Humanoid.WalkSpeed = 40
        end
    else
        SpeedBuffBtn.Text = "⚡ Speed Buff: TẮT (40)"
        SpeedBuffBtn.BackgroundColor3 = Color3.fromRGB(60, 100, 200)
        if lp.Character and lp.Character:FindFirstChild("Humanoid") then
            lp.Character.Humanoid.WalkSpeed = 16
        end
    end
end)

Players.LocalPlayer.CharacterAdded:Connect(function(char)
    char:WaitForChild("Humanoid")
    if isSpeedBuffEnabled then
        char.Humanoid.WalkSpeed = 40
    end
end)

-- ================= NÚT CHÍNH: AUTO CÂU + SKILL (GIỮ 0.6S & CHẠY LIÊN TỤC) =================
local isRunning = false
local cameraConnection = nil

ToggleMasterBtn.MouseButton1Click:Connect(function()
    isRunning = not isRunning
    local lp = Players.LocalPlayer
    local camera = workspace.CurrentCamera
    
    if isRunning then
        ToggleMasterBtn.Text = "🛑 TẮT AUTO (Đang chạy)"
        ToggleMasterBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
        StatusLabel.Text = "✨ Đang khởi tạo khóa camera..."
        
        if lp.Character and lp.Character:FindFirstChild("Humanoid") then
            if not isSpeedBuffEnabled then
                lp.Character.Humanoid.WalkSpeed = 0
            end
            lp.Character.Humanoid.JumpPower = 0
        end
        
        camera.CameraType = Enum.CameraType.Scriptable
        
        local startTime = tick()
        while tick() - startTime < 0.3 and isRunning do
            if lp.Character and lp.Character:FindFirstChild("Head") then
                local headPos = lp.Character.Head.Position
                camera.CFrame = CFrame.new(headPos + Vector3.new(0, 3, -4), headPos)
            end
            task.wait()
        end
        
        if not isRunning then return end
        
        StatusLabel.Text = "🔥 Đang chạy Auto Câu + Skill (0.6s)..."
        
        -- Khóa góc camera bên phải
        cameraConnection = RunService.RenderStepped:Connect(function()
            if lp.Character and lp.Character:FindFirstChild("Head") then
                local headPos = lp.Character.Head.Position
                local rightOffset = (lp.Character.Head.CFrame.RightVector * 5) + Vector3.new(0, 2, 0)
                local camTargetPos = headPos + rightOffset
                camera.CFrame = CFrame.new(camTargetPos, headPos)
            end
        end)
        
        -- Task vòng lặp tuần tự: Auto Câu (giữ 0.6s) -> Xong xả Skill ngay -> Lặp lại không ngừng
        task.spawn(function()
            local targetSkillNames = {
                ["Slot1"] = true,
                ["Slot2"] = true,
                ["Slot3"] = true,
                ["Slot4"] = true,
                ["SlotTemplate"] = true
            }
            
            while isRunning do
                -- 1. BƯỚC AUTO CÂU (Giữ 0.6s -> Nhấn 3 lần)
                pcall(function()
                    for _, gui in ipairs(PlayerGui:GetChildren()) do
                        if gui:IsA("ScreenGui") and isRunning then
                            for _, desc in ipairs(gui:GetDescendants()) do
                                if desc.Name == "FishingActionButton" and desc:IsA("ImageButton") and desc.Visible and isRunning then
                                    local absPos = desc.AbsolutePosition
                                    local absSize = desc.AbsoluteSize
                                    local baseCenterX = absPos.X + (absSize.X / 2)
                                    local baseCenterY = absPos.Y + (absSize.Y / 2)
                                    
                                    local finalX = baseCenterX + 45
                                    local finalY = baseCenterY + 55
                                    
                                    Indicator.Position = UDim2.new(0, finalX, 0, finalY)
                                    Indicator.Visible = true
                                    
                                    -- Giữ chuột 0.6s đúng yêu cầu
                                    VirtualInputManager:SendMouseButtonEvent(finalX, finalY, 0, true, game, 0)
                                    task.wait(0.6)
                                    VirtualInputManager:SendMouseButtonEvent(finalX, finalY, 0, false, game, 0)
                                    task.wait(0.05)
                                    
                                    -- Nhấn 3 lần liên tiếp
                                    for i = 1, 3 do
                                        if not isRunning then break end
                                        VirtualInputManager:SendMouseButtonEvent(finalX, finalY, 0, true, game, 0)
                                        task.wait(0.02)
                                        VirtualInputManager:SendMouseButtonEvent(finalX, finalY, 0, false, game, 0)
                                        task.wait(0.05)
                                    end
                                end
                            end
                        end
                    end
                end)
                
                -- 2. BƯỚC AUTO SKILL (Xả ngay lập tức sau khi câu xong)
                pcall(function()
                    for _, gui in ipairs(PlayerGui:GetChildren()) do
                        if gui:IsA("ScreenGui") and isRunning then
                            for _, desc in ipairs(gui:GetDescendants()) do
                                if targetSkillNames[desc.Name] and desc.Visible and isRunning then
                                    local absPos = desc.AbsolutePosition
                                    local absSize = desc.AbsoluteSize
                                    local baseCenterX = absPos.X + (absSize.X / 2)
                                    local baseCenterY = absPos.Y + (absSize.Y / 2)
                                    
                                    local finalX = baseCenterX + 45
                                    local finalY = baseCenterY + 55
                                    
                                    VirtualInputManager:SendMouseButtonEvent(finalX, finalY, 0, true, game, 0)
                                    task.wait(0.01)
                                    VirtualInputManager:SendMouseButtonEvent(finalX, finalY, 0, false, game, 0)
                                    task.wait(0.01)
                                end
                            end
                        end
                    end
                end)
                
                -- Tiếp tục vòng lặp ngay lập tức không ngừng nghỉ
                task.wait(0.01)
            end
        end)
    else
        ToggleMasterBtn.Text = "auto câu + skill( tất cả thiết bị)"
        ToggleMasterBtn.BackgroundColor3 = Color3.fromRGB(40, 200, 90)
        StatusLabel.Text = "⚡ Trạng thái: Đang tắt"
        Indicator.Visible = false
        
        if cameraConnection then
            cameraConnection:Disconnect()
            cameraConnection = nil
        end
        camera.CameraType = Enum.CameraType.Custom
        if lp.Character and lp.Character:FindFirstChild("Humanoid") then
            lp.Character.Humanoid.WalkSpeed = isSpeedBuffEnabled and 40 or 16
            lp.Character.Humanoid.JumpPower = 50
        end
    end
end)
