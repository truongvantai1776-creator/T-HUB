        char.Humanoid.WalkSpeed = 40
    end
end)

-- ================= CẤU HÌNH TỌA ĐỘ AUTO FARM (GIỮ NGUYÊN) =================
local Config_MasterX = 660
local Config_MasterY = 330
local Config_MasterSpeed = 5

local Config_Skills = {
    {x = 660, y = 250}, -- Skill 1
    {x = 740, y = 250}, -- Skill 2
    {x = 660, y = 180}, -- Skill 3
    {x = 740, y = 180}  -- Skill 4
}

local isRunning = false
local cameraConnection = nil

ToggleMasterBtn.MouseButton1Click:Connect(function()
    isRunning = not isRunning
    local lp = Players.LocalPlayer
    local camera = workspace.CurrentCamera
    
    local clickTween = TweenService:Create(ToggleMasterBtn, TweenInfo.new(0.1), {Size = UDim2.new(1, -24, 0, 32)})
    clickTween:Play()
    task.wait(0.1)
    TweenService:Create(ToggleMasterBtn, TweenInfo.new(0.1), {Size = UDim2.new(1, -20, 0, 35)}):Play()
    
    if isRunning then
        ToggleMasterBtn.Text = "🛑 TẮT AUTO (Đang chạy)"
        ToggleMasterBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
        StatusLabel.Text = "✨ Đang khởi tạo khóa camera..."
        
        if lp.Character and lp.Character:FindFirstChild("Humanoid") then
            -- Nếu đang bật speed buff thì giữ tốc độ 40, nếu không thì set về 0 để đứng yên câu cá
            if not isSpeedBuffEnabled then
                lp.Character.Humanoid.WalkSpeed = 0
            end
            lp.Character.Humanoid.JumpPower = 0
        end
        
        camera.CameraType = Enum.CameraType.Scriptable
        
        local startTime = tick()
        while tick() - startTime < 0.4 and isRunning do
            if lp.Character and lp.Character:FindFirstChild("Head") then
                local headPos = lp.Character.Head.Position
                camera.CFrame = CFrame.new(headPos + Vector3.new(0, 3, -4), headPos)
            end
            task.wait()
        end
        
        if not isRunning then return end
        
        StatusLabel.Text = "🎣 Đang chạy Auto + Khóa góc phải..."
        cameraConnection = RunService.RenderStepped:Connect(function()
            if lp.Character and lp.Character:FindFirstChild("Head") then
                local headPos = lp.Character.Head.Position
                local rightOffset = (lp.Character.Head.CFrame.RightVector * 5) + Vector3.new(0, 2, 0)
                local camTargetPos = headPos + rightOffset
                camera.CFrame = CFrame.new(camTargetPos, headPos)
            end
        end)
        
        task.spawn(function()
            while isRunning do
                StatusLabel.Text = "🎣 Đang Auto Thả Câu..."
                
                Indicator.Position = UDim2.new(0, Config_MasterX, 0, Config_MasterY)
                Indicator.Visible = true
                
                pcall(function()
                    VirtualInputManager:SendMouseButtonEvent(Config_MasterX, Config_MasterY, 0, true, game, 0)
                end)
                
                local waitTime = 0
                while waitTime < 0.6 and isRunning do
                    task.wait(0.05)
                    waitTime = waitTime + 0.05
                end
                
                pcall(function()
                    VirtualInputManager:SendMouseButtonEvent(Config_MasterX, Config_MasterY, 0, false, game, 0)
                end)
                
                if not isRunning then break end
                task.wait(0.1)
                
                local mspd = Config_MasterSpeed
                if mspd <= 0 then mspd = 1 end
                for i = 1, 2 do
                    if not isRunning then break end
                    pcall(function()
                        VirtualInputManager:SendMouseButtonEvent(Config_MasterX, Config_MasterY, 0, true, game, 0)
                        task.wait(0.01)
                        VirtualInputManager:SendMouseButtonEvent(Config_MasterX, Config_MasterY, 0, false, game, 0)
                    end)
                    task.wait(1 / mspd)
                end
                
                if not isRunning then break end
                
                StatusLabel.Text = "🔥 Đang xả 4 Skill cực nhanh..."
                for _, skill in ipairs(Config_Skills) do
                    if not isRunning then break end
                    Indicator.Position = UDim2.new(0, skill.x, 0, skill.y)
                    pcall(function()
                        VirtualInputManager:SendMouseButtonEvent(skill.x, skill.y, 0, true, game, 0)
                        task.wait(0.01)
                        VirtualInputManager:SendMouseButtonEvent(skill.x, skill.y, 0, false, game, 0)
                    end)
                    task.wait(0.02)
                end
                
                if not isRunning then break end
                task.wait(0.1)
            end
            
            Indicator.Visible = false
            StatusLabel.Text = "⚡ Trạng thái: Đang tắt"
            if cameraConnection then
                cameraConnection:Disconnect()
                cameraConnection = nil
            end
            camera.CameraType = Enum.CameraType.Custom
            if lp.Character and lp.Character:FindFirstChild("Humanoid") then
                lp.Character.Humanoid.WalkSpeed = isSpeedBuffEnabled and 40 or 16
                lp.Character.Humanoid.JumpPower = 50
            end
        end)
    else
        ToggleMasterBtn.Text = "🚀 BẬT AUTO CÂU + SKILL"
        ToggleMasterBtn.BackgroundColor3 = Color3.fromRGB(40, 200, 90)
        Indicator.Visible = false
        StatusLabel.Text = "⚡ Trạng thái: Đang tắt"
        
        if cameraConnection then
            cameraConnection:Disconnect()
            cameraConnection = nil
        end
        camera.CameraType = Enum.CameraType.Custom
        if lp.Character and lp.Character:FindFirstChild("Humanoid") then
            lp.Character.Humanoid.WalkSpeed = isSpeedBuffEnabled and 40 or 16
            lp.Character.Humanoid.JumpPower = 50
        end
    end
end)
