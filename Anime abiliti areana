--====================================================================--
-- LOGIC XỬ LÝ CHỨC NĂNG CHÍNH (Nhân vật hướng theo kẻ địch, Camera tự do)
--====================================================================--

RunService.Heartbeat:Connect(function(dt)
    -- 1. Ultra God Ground Farm
    if Config.AutoFarmYen then
        local root = GetRoot()
        local target = GetStrictSafeTarget(dt)

        if root and target and target:FindFirstChild("HumanoidRootPart") then
            local targetRoot = target.HumanoidRootPart
            local targetPos = targetRoot.Position
            
            if targetPos.Magnitude > 10 and targetPos.Y > -50 and targetPos.Y < 500 then
                local offsetPos = targetPos - (targetRoot.CFrame.LookVector * Config.FollowDistance)
                local newPos = Vector3.new(offsetPos.X, targetPos.Y + Config.DistanceUnderFeet, offsetPos.Z)
                
                -- Lưu lại góc quay camera hiện tại của bạn trước khi gán vị trí nhân vật
                local currentCamCFrame = Camera.CFrame

                -- Nhân vật vẫn nhìn hướng về phía chân/thân kẻ địch (đúng ý bạn)
                local lookTargetPos = Vector3.new(targetPos.X, targetPos.Y + 2, targetPos.Z)
                root.CFrame = CFrame.lookAt(newPos, lookTargetPos)
                root.Velocity = Vector3.new(0, 0, 0)

                -- Trả lại góc nhìn camera tự do cho bạn ngay lập tức để không bị khóa dính vào đầu
                Camera.CFrame = currentCamCFrame

                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
            end
        end
    else
        currentTarget = nil
        targetCheckTimer = 0
        ignoredTargets = {}
    end

    -- 2. Fast M1 Attack Clicker
    if Config.UltraFastM1 then
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
    end

    -- 3. Auto Use E, R, Z Skills
    if Config.AutoSkills then
        for _, key in ipairs({Enum.KeyCode.E, Enum.KeyCode.R, Enum.KeyCode.Z}) do
            VirtualInputManager:SendKeyEvent(true, key, false, game)
            task.wait(0.01)
            VirtualInputManager:SendKeyEvent(false, key, false, game)
        end
    end
end)

