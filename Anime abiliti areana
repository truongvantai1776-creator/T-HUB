-- Biến hỗ trợ
local currentTarget = nil
local targetLastHealth = -1
local targetCheckTimer = 0
local ignoredTargets = {}

-- Helpers
local function GetCharacter()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function GetRoot()
    local char = GetCharacter()
    return char and char:FindFirstChild("HumanoidRootPart")
end

-- Hàm tìm mục tiêu cực kỳ an toàn (Lọc sảnh chờ và trên trời)
local function GetStrictSafeTarget(dt)
    local myRoot = GetRoot()
    if not myRoot then return nil end

    -- Kiểm tra mục tiêu hiện tại
    if currentTarget and currentTarget.Character and currentTarget.Character:FindFirstChild("HumanoidRootPart") and currentTarget.Character:FindFirstChild("Humanoid") then
        local hum = currentTarget.Character.Humanoid
        local targetRoot = currentTarget.Character.HumanoidRootPart
        
        if hum.Health > 0 and targetRoot.Position.Y > -50 and targetRoot.Position.Y < 500 and not ignoredTargets[currentTarget] then
            if hum.Health ~= targetLastHealth then
                targetLastHealth = hum.Health
                targetCheckTimer = 0
            else
                targetCheckTimer = targetCheckTimer + dt
                if targetCheckTimer >= 3.0 then -- 3 giây không mất máu -> Đổi mục tiêu ngay
                    ignoredTargets[currentTarget] = true
                    currentTarget = nil
                    targetCheckTimer = 0
                end
            end
            return currentTarget.Character
        else
            currentTarget = nil
            targetCheckTimer = 0
        end
    end

    -- Quét tìm người thấp máu nhất
    local bestTarget = nil
    local lowestHealth = math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and not ignoredTargets[player] then
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
                local hum = char.Humanoid
                local targetRoot = char.HumanoidRootPart
                
                if hum.Health > 0 and targetRoot.Position.Y > -50 and targetRoot.Position.Y < 500 and targetRoot.Position.Magnitude > 10 then
                    if hum.Health < lowestHealth then
                        lowestHealth = hum.Health
                        bestTarget = player
                    end
                end
            end
        end
    end

    if not bestTarget then
        ignoredTargets = {}
        targetCheckTimer = 0
    else
        currentTarget = bestTarget
        local hum = bestTarget.Character and bestTarget.Character:FindFirstChild("Humanoid")
        targetLastHealth = hum and hum.Health or -1
        targetCheckTimer = 0
    end

    return currentTarget and currentTarget.Character or nil
end

